---
// The method, on its own sheet: one stream of work at a time, five stages
// on one drawing, with Halden Supply's returns desk as the stream. The home
// page teaches the ideas; this page teaches the way they are done.
import Base from "../layouts/Base.astro";
import Drawing from "../components/Drawing.astro";
import Mark from "../components/Mark.astro";
import Cycle from "../components/Cycle.astro";

const email = "contact@talco.dev";
const oneStream = `mailto:${email}?subject=${encodeURIComponent("One stream")}`;
const title = "One stream of work at a time";
const description =
  "How a stream of work comes to run with no one in it, in five stages, on one returns desk.";
---

<Base title={`${title} · TAL Company`} description={description}>
  <header class="bar">
    <a class="home" href="/" aria-label="TAL Company, home"><Mark /></a>
    <a class="cta" href={oneStream}>Email us</a>
  </header>

  <Drawing id="method" number="01" label="How we do it">
    <div class="method">
      <p class="mono-label">How we do it</p>
      <h1>One stream of work at a time.</h1>
      <p class="lead">
        The stream is the returns desk at Halden Supply, a distributor that
        sells tools and safety gear to contractors on account, net thirty. Dana
        decides refunds, credits, replacements and fee waivers all day, and
        nothing in the policy binder is what she does.
      </p>
      <Cycle door={oneStream} />
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <span class="links">
      <a href="/">The ideas</a>
      <a href={oneStream}>{email}</a>
    </span>
  </footer>
</Base>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 28px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .cta:hover,
  .cta:focus-visible {
    background-color: var(--ink);
    color: var(--paper);
    outline: none;
  }
  .method h1 {
    margin: 0.4rem 0 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .lead {
    margin: 0 0 2.25rem;
    font-size: clamp(1.12rem, 1.45vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-light);
    max-width: 44rem;
    text-wrap: pretty;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer .links {
    display: flex;
    gap: 1.75rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }
</style>
