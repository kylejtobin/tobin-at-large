---
// TAL Company. The page is TAL's positions on what organizations are becoming,
// drawn as a set: a cover that states the point of view and indexes the
// positions, one sheet per position with its proof, a sheet of the work TAL
// has made, and a quiet door for those who want it applied.
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import PositionSheet from "../components/PositionSheet.astro";
import Arrow from "../components/Arrow.astro";
import CoverDrawing from "../components/CoverDrawing.astro";

const view = "Organizations are becoming executable.";
const consequence =
  "Machines act on whatever an organization has made explicit. Everything it has left implicit is now its foundation or its fault line.";
const email = "contact@talco.dev";
const inquiry = `mailto:${email}?subject=${encodeURIComponent("Conversation")}`;

const positions = (await getCollection("positions")).sort(
  (a, b) => a.data.sheet - b.data.sheet,
);
const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
const [book, ...software] = works;
const no = (n: number) => String(n).padStart(2, "0");
const workSheet = positions.length + 1;

// What the page is, for search engines and link unfurlers.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const founder = `${ORIGIN}/#founder`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: `${view} ${consequence}`,
      founder: { "@id": founder },
    },
    {
      "@type": "Person",
      "@id": founder,
      name: "Kyle J. Tobin",
      worksFor: { "@id": org },
      sameAs: ["https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      author: { "@id": founder },
      publisher: { "@id": org },
      url: data.url,
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Base title="TAL Company" description={`TAL Company. ${view} ${consequence}`}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <header class="bar">
    <a class="home" href="#cover" aria-label="TAL Company, top of page"
      ><Mark /></a
    >
    <a class="cta" href={inquiry}>Start a conversation</a>
  </header>

  <Drawing id="cover" label="TAL Company" full>
    <div class="cover">
      <div class="statement">
        <Mark />
        <h1>{view}</h1>
        <p class="consequence">{consequence}</p>
      </div>
      <nav class="index" aria-label="Positions">
        <p class="mono-label">Positions</p>
        <CoverDrawing />
        <ol>
          {
            positions.map(({ data }) => (
              <li>
                <a href={`#position-${no(data.sheet)}`}>
                  <span class="no">{no(data.sheet)}</span>
                  <span class="name">{data.short}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </Drawing>

  {
    positions.map((position) => (
      <Drawing
        id={`position-${no(position.data.sheet)}`}
        number={no(position.data.sheet)}
        label={position.data.short}
      >
        <PositionSheet position={position} />
      </Drawing>
    ))
  }

  <Drawing id="work" number={no(workSheet)} label="Work">
    <div class="work">
      <h2 class="work-head">Written down, and built.</h2>
      {
        book && (
          <figure class="hero-item">
            <a
              class="plate"
              href={book.data.url}
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={book.data.cover}
                alt=""
                widths={[320, 640]}
                sizes="(max-width: 900px) 60vw, 320px"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            </a>
            <figcaption>
              <span class="kind">{book.data.label}</span>
              <a class="title-link" href={book.data.url} rel="noopener">
                {book.data.title}
                <Arrow />
              </a>
              <span class="by">by Kyle J. Tobin</span>
            </figcaption>
          </figure>
        )
      }
      <div class="tools">
        {
          software.map(({ data }) => (
            <figure class="tool">
              <a
                class="plate"
                href={data.url}
                rel="noopener"
                tabindex="-1"
                aria-hidden="true"
              >
                <Picture
                  src={data.cover}
                  alt=""
                  widths={[480, 960]}
                  sizes="(max-width: 900px) calc(100vw - 4rem), 480px"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
              </a>
              <figcaption>
                <span class="kind">{data.label}</span>
                <a class="title-link" href={data.url} rel="noopener">
                  {data.title}
                  <Arrow />
                </a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </Drawing>

  <Drawing id="start" number={no(workSheet + 1)} label="Contact">
    <div class="start">
      <h2>TAL applies this inside organizations.</h2>
      <div class="start-actions">
        <a class="cta" href={inquiry}>Start a conversation</a>
        <a class="go" href={inquiry}>{email} <Arrow /></a>
      </div>
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <a href={inquiry}>{email}</a>
    <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
  </footer>
  <script is:inline>
    // the bar's mark stands down while the cover's mark is in view. without
    // this script the bar simply always shows it.
    if ("IntersectionObserver" in window) {
      const mark = document.querySelector("#cover .statement .mark");
      if (mark) {
        new IntersectionObserver(
          ([e]) =>
            document.documentElement.classList.toggle(
              "at-cover",
              e.isIntersecting,
            ),
          { rootMargin: "-56px 0px 0px 0px" },
        ).observe(mark);
      }
    }
  </script>
</Base>

<style>
  /* ---- the cover: the point of view on the left; on the right, the one
     drawing on the site, standing on the index of positions it keys ---- */
  .cover {
    --mark: clamp(52px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 2.5rem;
    align-items: end;
  }
  .statement {
    grid-column: 1 / span 7;
    display: grid;
    gap: clamp(1.5rem, 4vh, 2.75rem);
  }
  .cover :global(.mark) {
    justify-self: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.014em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .consequence {
    font-size: clamp(1.2rem, 1.7vw, 1.42rem);
    line-height: 1.5;
    color: var(--ink-light);
    max-width: 34rem;
  }

  .index {
    grid-column: 8 / span 5;
  }
  .index :global(.cover-drawing) {
    margin-top: 1.25rem;
  }
  .index ol {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .index li {
    border-bottom: 1px solid var(--line-faint);
  }
  .index a {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    padding: 0.7rem 0;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .index .no {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .index .name {
    font-family: var(--font-display);
    font-size: 1.12rem;
    transition: transform 0.4s var(--ease);
  }
  .index a:hover .name,
  .index a:focus-visible .name {
    transform: translateX(4px);
  }
  .index a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  /* ---- the bar: the mark and the one action ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 28px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
    transition: opacity 0.4s var(--ease);
  }
  /* while the cover's own mark is on screen, the bar does not repeat it */
  :global(.at-cover) .home {
    opacity: 0;
    pointer-events: none;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .cta:hover,
  .cta:focus-visible {
    background-color: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* ---- the work: one composed exhibit. the book leads; the two tools
     support it, stacked at half its weight ---- */
  .work {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      "head head"
      "book tools";
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 2.25rem;
    align-items: start;
  }
  .work-head {
    grid-area: head;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
  }
  /* the book's caption may run wider than its cover */
  .hero-item {
    grid-area: book;
  }
  .hero-item .plate {
    width: min(100%, 320px);
  }
  /* the tools stack, together matching the book's height */
  .tools {
    grid-area: tools;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 30rem;
  }
  .plate {
    display: block;
    line-height: 0;
  }
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 0 0 1px rgba(26, 26, 26, 0.08),
      0 1px 1px rgba(26, 26, 26, 0.14),
      0 18px 32px -14px rgba(40, 30, 15, 0.34);
  }
  figcaption {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.1rem;
    justify-items: start;
  }
  .kind,
  .by {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-quiet);
  }
  /* one link style for every title: the underline matches its text, and the
     arrow stays on the title's last line */
  .title-link {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.3s var(--ease);
  }
  .hero-item .title-link {
    font-size: 1.45rem;
  }
  .title-link :global(svg) {
    margin-left: 0.3em;
    vertical-align: 0.12em;
  }
  .title-link:hover,
  .title-link:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }

  /* ---- contact: the quiet door ---- */
  .start h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
  }
  .start-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    .statement,
    .index {
      grid-column: 1 / -1;
    }
    .work {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "book" "tools";
    }
    .hero-item .plate {
      width: min(60vw, 300px);
    }
    .tools {
      gap: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index .name {
      transition: none;
    }
  }
</style>
