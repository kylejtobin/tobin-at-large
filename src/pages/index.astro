---
// TAL Company, as a drawing set: a cover sheet that states the field and
// lists the drawings, then one sheet per layer of the automated organization.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import WorkSheet from "../components/WorkSheet.astro";
import Arrow from "../components/Arrow.astro";
import CoverDrawing from "../components/CoverDrawing.astro";

const statement = "The architecture of the automated organization.";
const thesis =
  "Machines now read structure. A rule, a role, a type: each is an instruction they act on. How authority works, what the business means, how its software must behave: for the first time, all three can be built rather than written down.";
const email = "contact@talco.dev";
const inquiry = `mailto:${email}?subject=${encodeURIComponent("Engagement")}`;

const works = (await getCollection("works", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sheet - b.data.sheet,
);
const sheetNo = (n: number) => String(n).padStart(2, "0");

// What the page is, for search engines and link unfurlers: the organization,
// its founder, each work as the kind of thing it is, and the engagements.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const founder = `${ORIGIN}/#founder`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: statement,
      founder: { "@id": founder },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Engagements",
        itemListElement: works.map(({ data }) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: data.offer.name,
            description: data.offer.promise,
          },
        })),
      },
    },
    {
      "@type": "Person",
      "@id": founder,
      name: "Kyle J. Tobin",
      worksFor: { "@id": org },
      sameAs: ["https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      ...(data.subtitle && { alternativeHeadline: data.subtitle }),
      description: data.reveal,
      author: data.by.map((name) => ({ "@type": "Person", name })),
      publisher: { "@id": org },
      url: data.url,
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Base title="TAL Company" description={`TAL Company. ${statement}`}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <Drawing id="cover" number="00" label="Cover" titleBlock="Drawing set">
    <div class="cover">
      <div class="statement">
        <Mark />
        <h1>{statement}</h1>
        <div class="thesis">
          <p>{thesis}</p>
          <a class="go" href={inquiry}>Discuss an engagement <Arrow /></a>
        </div>
      </div>
      <nav class="index" aria-label="Drawings">
        <p class="mono-label">Drawings</p>
        <CoverDrawing />
        <ol>
          {
            works.map(({ data }) => (
              <li>
                <a href={`#sheet-${sheetNo(data.sheet)}`}>
                  <span class="no">{sheetNo(data.sheet)}</span>
                  <span class="layer mono-label">{data.layer}</span>
                  <span class="name">{data.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </Drawing>

  {
    works.map((work) => (
      <Drawing
        id={`sheet-${sheetNo(work.data.sheet)}`}
        number={sheetNo(work.data.sheet)}
        label={work.data.layer}
        titleBlock={work.data.title}
      >
        <WorkSheet work={work} email={email} />
      </Drawing>
    ))
  }

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <a href={inquiry}>{email}</a>
    <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
  </footer>
</Base>

<style>
  /* the cover: the statement on the left, from the mark down through the
     field's name to the thesis; on the right, the one drawing on the site
     standing on the list of drawings it keys */
  .cover {
    --mark: clamp(52px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 3rem;
    align-items: end;
  }
  .statement {
    grid-column: 1 / span 7;
    display: grid;
    gap: clamp(1.5rem, 4vh, 2.75rem);
  }
  .cover :global(.mark) {
    justify-self: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.7rem, 6.2vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.012em;
    max-width: 13ch;
  }

  .thesis p {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-light);
    max-width: 36rem;
    margin-bottom: 1.25rem;
  }

  /* the drawing list, as every set opens with, under the drawing it keys:
     the drawing stands on the list's top rule, where its leaders land */
  .index {
    grid-column: 8 / span 5;
  }
  .index :global(.cover-drawing) {
    margin-top: 1.25rem;
  }
  .index ol {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .index li {
    border-bottom: 1px solid var(--line-faint);
  }
  /* number, then the layer over the work it draws */
  .index a {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    row-gap: 0.15rem;
    padding: 0.85rem 0;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .index .no {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .index .layer,
  .index .name {
    grid-column: 2;
  }
  .index .no {
    grid-row: 1 / span 2;
  }
  .index .name {
    font-family: var(--font-display);
    font-size: 1.12rem;
    transition: transform 0.4s var(--ease);
  }
  .index a:hover .name,
  .index a:focus-visible .name {
    transform: translateX(4px);
  }
  .index a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    .statement,
    .index {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index .name {
      transition: none;
    }
  }
</style>
