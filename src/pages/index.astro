---
// TAL Company, set as a book: a centred title page, then the record, set left
// on one column: the work, engagements, the principal, and a colophon.
import { getCollection } from "astro:content";
import Sheet from "../layouts/Sheet.astro";
import Mark from "../components/Mark.astro";
import Section from "../components/Section.astro";
import WorkFeature from "../components/WorkFeature.astro";
import WorkList from "../components/WorkList.astro";

const statement =
  "An independent practice in the architecture of automated organizations.";
const email = "contact@talco.dev";

// featured first, then by explicit order, then newest; works without an
// order or a year come after those with one
const works = (await getCollection("works", ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
    (b.data.year ?? 0) - (a.data.year ?? 0) ||
    a.data.title.localeCompare(b.data.title),
);
const featured = works.filter((w) => w.data.featured);
const listed = works.filter((w) => !w.data.featured);

// What the page is, for search engines and link unfurlers: the practice, its
// principal, and each work as the kind of thing it is.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const principal = `${ORIGIN}/#principal`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: statement,
      founder: { "@id": principal },
    },
    {
      "@type": "Person",
      "@id": principal,
      name: "Kyle J. Tobin",
      worksFor: { "@id": org },
      sameAs: ["https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      ...(data.subtitle && { alternativeHeadline: data.subtitle }),
      ...(data.summary && { description: data.summary }),
      author: data.by.map((name) => ({ "@type": "Person", name })),
      publisher: { "@id": org },
      url: data.url,
      ...(data.year && { datePublished: String(data.year) }),
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Sheet title="TAL Company" description={`TAL Company. ${statement}`}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <header class="title">
    <div class="settle"><Mark /></div>
    <p class="statement settle">{statement}</p>
  </header>

  <Section label="Work" id="work">
    <div class="features">
      {featured.map((work) => <WorkFeature work={work} />)}
    </div>
    {listed.length > 0 && <WorkList works={listed} />}
  </Section>

  <Section label="Engagements" id="engagements">
    <p class="prose">
      Advisory and architecture work for organizations putting AI into real
      operations: finding the organization that actually runs, deciding what
      must be governed, and building the systems that carry it. TAL takes on a
      small number of engagements each year.
    </p>
    <a class="ink-link email" href={`mailto:${email}`}>{email}</a>
  </Section>

  <Section label="Principal" id="principal">
    <p class="name">Kyle J. Tobin</p>
    <p class="links">
      <a
        class="ink-link label"
        href="https://github.com/kylejtobin"
        rel="noopener">GitHub</a
      >
    </p>
  </Section>

  <footer class="colophon">
    © {new Date().getFullYear()} TAL Company · Set in Playfair Display &amp; Cormorant
    Garamond
  </footer>
</Sheet>

<style>
  /* the title page: centred and formal. everything after it is set left */
  .title {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .statement {
    font-style: italic;
    font-size: clamp(1.2rem, 2.8vw, 1.4rem);
    line-height: 1.45;
    color: var(--ink-light);
    letter-spacing: 0.01em;
    margin-top: calc(var(--mark) * 0.34);
  }

  /* each title element settles in its own pass. resting state is fully
     visible; motion is a pure enhancement */
  .settle {
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }
  .title.composing .settle {
    opacity: 0;
    transform: translateY(10px);
  }
  .title > .settle:nth-child(2) {
    transition-delay: 0.18s;
  }

  .features {
    display: grid;
    gap: 4.5rem;
  }
  .features + :global(ul) {
    margin-top: 3rem;
  }

  .email {
    font-size: var(--body-size);
    margin-top: 0.75rem;
  }

  .name {
    font-weight: 500;
    font-size: clamp(1.45rem, 3.6vw, 1.7rem);
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .links {
    margin-top: 0.75rem;
  }
  /* the link style's tracking would flatten the label's; keep the capitals wide */
  .links .ink-link {
    letter-spacing: var(--label-track);
  }

  .colophon {
    margin-top: var(--section-gap);
    font-size: 0.95rem;
    color: var(--ink-quiet);
    letter-spacing: 0.01em;
  }

  @media (prefers-reduced-motion: reduce) {
    .settle {
      transition: none;
    }
    .title.composing .settle {
      opacity: 1;
      transform: none;
    }
  }
</style>
