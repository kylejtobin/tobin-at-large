---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import Arrow from "../components/Arrow.astro";
import portrait from "../assets/founder.png";

const thesis = "An organization can now be made to run on its own.";
const email = "contact@talco.dev";
const mailto = `mailto:${email}`;
const linkedin = "https://www.linkedin.com/in/kyletobin/";

const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
const anchor = (title: string) =>
  title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const sheets = await Promise.all(
  works.map(async (work, i) => ({
    ...work,
    number: String(i + 1).padStart(2, "0"),
    Evidence: (await render(work)).Content,
  })),
);
---

<Base
  title="TAL Company"
  description={`${thesis} The Automated Organization, ONTOK and Type Construction Architecture, by Kyle J. Tobin.`}
>
  <header class="bar">
    <a class="home" href="#cover" aria-label="TAL Company, top of page"
      ><Mark /></a
    >
  </header>

  <Drawing id="cover" label="TAL Company" full>
    <div class="cover">
      <div class="colophon"><Mark /></div>
      <h1>{thesis}</h1>
      <ol class="contents" aria-label="The works">
        {
          sheets.map(({ data, number }) => (
            <li>
              <a href={`#${anchor(data.title)}`}>
                <span class="no">{number}</span>
                <span class="claim">{data.claim}</span>
                <span class="work">{data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </Drawing>

  {
    sheets.map(({ data, number, Evidence }) => (
      <Drawing id={anchor(data.title)} number={number} label={data.title}>
        <div class:list={["sheet", { book: data.kind === "book" }]}>
          <h2>{data.claim}</h2>
          <div class="exhibit">
            <a
              class="plate"
              href={data.url}
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={data.cover}
                alt=""
                widths={data.kind === "book" ? [320, 640] : [560, 1120]}
                sizes={
                  data.kind === "book"
                    ? "(max-width: 900px) 64vw, 320px"
                    : "(max-width: 900px) calc(100vw - 4rem), 560px"
                }
                formats={["avif", "webp"]}
                loading="lazy"
              />
            </a>
            <div class="entry">
              <span class="kind mono-label">
                {[data.label, data.status, data.year]
                  .filter(Boolean)
                  .join(" · ")}
              </span>
              <a class="title-link" href={data.url} rel="noopener">
                {data.title.split(" ").slice(0, -1).join(" ")}{" "}
                <span class="nw">
                  {data.title.split(" ").at(-1)}
                  <Arrow />
                </span>
              </a>
              {data.kind === "book" && <span class="by">Kyle J. Tobin</span>}
              {data.line && <span class="line">{data.line}</span>}
            </div>
          </div>
          <div class="reading">
            <Evidence />
          </div>
        </div>
      </Drawing>
    ))
  }

  <Drawing id="whole" label="Together">
    <div class="whole">
      <h2>Then a whole stream of work can run with no one in it.</h2>
      <p class="turn">
        Agents do everything that knowledge covers, the software shows where it
        ends, and people work before and after, deciding what the organization
        should be.
      </p>
    </div>
  </Drawing>

  <Drawing id="author" label="Author">
    <div class="author">
      <div class="portrait">
        <Picture
          src={portrait}
          alt="Kyle J. Tobin, drawn in pencil"
          widths={[240, 480]}
          sizes="(max-width: 900px) 50vw, 240px"
          formats={["avif", "webp"]}
          loading="lazy"
        />
      </div>
      <div class="author-text">
        <p class="statement">
          <strong>Kyle J. Tobin</strong> works on how organizations will now have
          to run: whole, explicit, and executable, from the authority at the top to
          the code underneath.
        </p>
        <p class="correspondence">
          <span class="mono-label">Correspondence</span>
          <a href={mailto}>{email}</a>
        </p>
      </div>
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <span class="links">
      <a href={linkedin} rel="noopener">LinkedIn</a>
      <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
    </span>
  </footer>
  <script is:inline>
    // the bar's imprint stands down while the title page's is in view
    if ("IntersectionObserver" in window) {
      const mark = document.querySelector("#cover .mark");
      if (mark) {
        new IntersectionObserver(
          ([e]) =>
            document.documentElement.classList.toggle(
              "at-cover",
              e.isIntersecting,
            ),
          { rootMargin: "-56px 0px 0px 0px" },
        ).observe(mark);
      }
    }
  </script>
</Base>

<style>
  :global(:root) {
    --turn: clamp(1.4rem, 1.9vw, 1.7rem);
    --reading: clamp(1.14rem, 1.3vw, 1.24rem);
  }

  .cover {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: clamp(2rem, 5vh, 3.5rem);
    align-content: end;
  }
  .colophon {
    --mark: clamp(34px, 3.2vw, 44px);
    grid-column: 1 / -1;
  }
  h1 {
    grid-column: 1 / span 9;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 5.4vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.014em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .contents {
    grid-column: 1 / span 10;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .contents li {
    border-bottom: 1px solid var(--line-faint);
  }
  .contents a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) minmax(0, 15rem);
    column-gap: 1.25rem;
    row-gap: 0.15rem;
    align-items: baseline;
    padding: 0.85rem 0;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .contents .no {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-quiet);
  }
  .contents .claim {
    font-size: clamp(1.2rem, 1.55vw, 1.38rem);
    line-height: 1.32;
    text-wrap: pretty;
    transition: transform 0.4s var(--ease);
  }
  .contents .work {
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--ink-quiet);
    text-align: right;
  }
  .contents a:hover .claim,
  .contents a:focus-visible .claim {
    transform: translateX(4px);
  }
  .contents a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 26px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
    transition: opacity 0.4s var(--ease);
  }
  :global(.at-cover) .home {
    opacity: 0;
    pointer-events: none;
  }

  .plate {
    display: block;
    line-height: 0;
    box-shadow:
      0 0 0 1px rgba(26, 26, 26, 0.1),
      0 1px 1px rgba(26, 26, 26, 0.12),
      0 18px 32px -16px rgba(40, 30, 15, 0.3);
  }
  /* the plate's own ground gives way to the paper; its ink stays full */
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas: "h h" "x r";
    column-gap: clamp(2rem, 4.5vw, 4.5rem);
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    align-items: start;
  }
  .sheet.book {
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
  }
  h2 {
    grid-area: h;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.85rem, 3.3vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .exhibit {
    grid-area: x;
    position: sticky;
    top: calc(var(--bar) + 2rem);
    display: grid;
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    /* sticking isolates the group, so the group itself is printed on the
       paper; the plate's own blend would otherwise meet nothing */
    mix-blend-mode: multiply;
  }
  .entry {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }
  .kind {
    letter-spacing: 0.12em;
  }
  .by {
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-quiet);
  }
  .title-link {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.22;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.3s var(--ease);
  }
  .title-link :global(svg) {
    margin-left: 0.3em;
    vertical-align: 0.12em;
  }
  .title-link:hover,
  .title-link:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }
  .line {
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--ink-light);
  }

  .reading {
    grid-area: r;
    max-width: 36rem;
  }
  .reading :global(p),
  .reading :global(li) {
    font-size: var(--reading);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink-light);
    text-wrap: pretty;
  }
  .reading > :global(p:first-child),
  .turn {
    font-size: var(--turn);
    font-weight: 500;
    line-height: 1.32;
    color: var(--ink);
    text-wrap: pretty;
  }
  .reading > :global(* + *) {
    margin-top: 1.1rem;
  }
  .reading > :global(p:first-child + *) {
    margin-top: 1.5rem;
  }
  .reading > :global(p + ol) {
    margin-top: 0.75rem;
  }
  .reading :global(ol) {
    list-style: none;
    border-top: 1px solid var(--line-faint);
    counter-reset: q;
  }
  .reading :global(li) {
    position: relative;
    padding: 0.35rem 0 0.35rem 1.5rem;
    border-bottom: 1px solid var(--line-faint);
    color: var(--ink);
  }
  .reading :global(ol li) {
    counter-increment: q;
  }
  .nw {
    white-space: nowrap;
  }
  .reading :global(ol li::before) {
    content: counter(q);
    display: inline-block;
    width: 1.5rem;
    margin-left: -1.5rem;
    padding-left: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-quiet);
  }

  .whole {
    display: grid;
    row-gap: 1.5rem;
  }
  .whole h2 {
    grid-area: auto;
  }
  .whole .turn {
    max-width: 38rem;
  }

  .author {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 2rem;
    align-items: center;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .author-text {
    max-width: 40rem;
  }
  .statement {
    font-size: var(--turn);
    font-weight: 500;
    line-height: 1.32;
    color: var(--ink);
    text-wrap: pretty;
  }
  .statement strong {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .correspondence {
    margin-top: 2rem;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .correspondence a {
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
  }
  .correspondence a:hover,
  .correspondence a:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer .links {
    display: flex;
    gap: 1.75rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    h1,
    .contents {
      grid-column: 1 / -1;
    }
    .contents a {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }
    .contents .work {
      grid-column: 2;
      text-align: left;
    }
    .sheet,
    .sheet.book,
    .author {
      grid-template-columns: minmax(0, 1fr);
    }
    .sheet {
      grid-template-areas: "h" "x" "r";
    }
    .exhibit {
      position: static;
    }
    .sheet.book .plate {
      width: min(64vw, 300px);
    }
    .portrait {
      width: min(50vw, 220px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contents .claim {
      transition: none;
    }
  }
</style>
