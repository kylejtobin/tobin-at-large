---
// TAL Company. One page: the conviction, the three works that make it real,
// the founder, and the address. The book is the argument; ONTOK and TCA are
// the argument built. The page presents them and says nothing they say
// better themselves.
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import Arrow from "../components/Arrow.astro";
import portrait from "../assets/founder.png";

const view = "An organization can be made explicit enough to run on its own.";
const email = "contact@talco.dev";
const mailto = `mailto:${email}`;
const linkedin = "https://www.linkedin.com/in/kyletobin/";

const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
const [book, ...tools] = works;

// What the page is, for search engines and link unfurlers.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const founder = `${ORIGIN}/#founder`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: view,
      founder: { "@id": founder },
    },
    {
      "@type": "Person",
      "@id": founder,
      name: "Kyle J. Tobin",
      jobTitle: "Founder",
      image: `${ORIGIN}/logo/founder.png`,
      worksFor: { "@id": org },
      sameAs: [linkedin, "https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      author: { "@id": founder },
      publisher: { "@id": org },
      url: data.url,
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Base title="TAL Company" description={`TAL Company. ${view}`}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <header class="bar">
    <a class="home" href="#cover" aria-label="TAL Company, top of page"
      ><Mark /></a
    >
    <a class="cta" href={mailto}>Email us</a>
  </header>

  <Drawing id="cover" label="TAL Company" full>
    <div class="cover">
      <Mark />
      <h1>{view}</h1>
    </div>
  </Drawing>

  {
    book && (
      <Drawing id="book" number="01" label={book.data.title}>
        <figure class="book">
          <a
            class="plate"
            href={book.data.url}
            rel="noopener"
            tabindex="-1"
            aria-hidden="true"
          >
            <Picture
              src={book.data.cover}
              alt=""
              widths={[400, 800]}
              sizes="(max-width: 900px) 70vw, 400px"
              formats={["avif", "webp"]}
              loading="lazy"
            />
          </a>
          <figcaption>
            <span class="kind">{book.data.label}</span>
            <a class="title-link" href={book.data.url} rel="noopener">
              {book.data.title}
              <Arrow />
            </a>
            <span class="by">by Kyle J. Tobin</span>
            <span class="line">{book.data.line}</span>
          </figcaption>
        </figure>
      </Drawing>
    )
  }

  <Drawing id="tools" number="02" label="The tools">
    <div class="tools">
      {
        tools.map(({ data }) => (
          <figure class="tool">
            <a
              class="plate"
              href={data.url}
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={data.cover}
                alt=""
                widths={[560, 1120]}
                sizes="(max-width: 900px) calc(100vw - 4rem), 560px"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            </a>
            <figcaption>
              <span class="kind">{data.label}</span>
              <a class="title-link" href={data.url} rel="noopener">
                {data.title}
                <Arrow />
              </a>
              <span class="line">{data.line}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Drawing>

  <Drawing id="founder" number="03" label="Founder">
    <div class="founder">
      <div class="portrait">
        <Picture
          src={portrait}
          alt="Kyle J. Tobin, drawn in pencil"
          widths={[280, 560]}
          sizes="(max-width: 900px) 60vw, 280px"
          formats={["avif", "webp"]}
          loading="lazy"
        />
      </div>
      <div class="founder-text">
        <p class="statement">
          <strong>Kyle J. Tobin</strong> founded TAL to build organizations the way
          they will now have to run: whole, explicit, and executable, from the authority
          at the top to the code underneath.
        </p>
        <div class="start-actions">
          <a class="cta" href={mailto}>Email us</a>
          <a class="go" href={mailto}>{email}</a>
        </div>
      </div>
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <span class="links">
      <a href={linkedin} rel="noopener">LinkedIn</a>
      <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
    </span>
  </footer>
  <script is:inline>
    // the bar's mark stands down while the cover's mark is in view. without
    // this script the bar simply always shows it.
    if ("IntersectionObserver" in window) {
      const mark = document.querySelector("#cover .mark");
      if (mark) {
        new IntersectionObserver(
          ([e]) =>
            document.documentElement.classList.toggle(
              "at-cover",
              e.isIntersecting,
            ),
          { rootMargin: "-56px 0px 0px 0px" },
        ).observe(mark);
      }
    }
  </script>
</Base>

<style>
  /* ---- the cover: the mark and the conviction, nothing else ---- */
  .cover {
    --mark: clamp(56px, 7vw, 92px);
    display: grid;
    gap: clamp(1.75rem, 5vh, 3rem);
    align-content: end;
    justify-items: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.014em;
    max-width: 17ch;
    text-wrap: balance;
  }

  /* ---- the bar: the mark and the one action ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 28px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
    transition: opacity 0.4s var(--ease);
  }
  :global(.at-cover) .home {
    opacity: 0;
    pointer-events: none;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .cta:hover,
  .cta:focus-visible {
    background-color: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* ---- the works: plates set as objects, in their own colour ---- */
  .plate {
    display: block;
    line-height: 0;
  }
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 0 0 1px rgba(26, 26, 26, 0.08),
      0 1px 1px rgba(26, 26, 26, 0.14),
      0 18px 32px -14px rgba(40, 30, 15, 0.34);
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
    justify-items: start;
  }
  .kind,
  .by {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-quiet);
  }
  .title-link {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.3s var(--ease);
  }
  .title-link :global(svg) {
    margin-left: 0.3em;
    vertical-align: 0.12em;
  }
  .title-link:hover,
  .title-link:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }
  .line {
    margin-top: 0.4rem;
    max-width: 32ch;
    font-size: 1.18rem;
    line-height: 1.45;
    color: var(--ink-light);
  }

  /* the book leads: the cover large, its caption beside it */
  .book {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }
  .book .title-link {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
  }
  .book .line {
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
  }

  /* the two tools, side by side at equal weight */
  .tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 4vw, 3.5rem);
    row-gap: 3rem;
    align-items: start;
  }
  .tool figcaption {
    margin-top: 1rem;
  }

  /* ---- the founder: the portrait, one sentence, the door ---- */
  .founder {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 2rem;
    align-items: center;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .founder-text {
    max-width: 40rem;
  }
  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.7vw, 2.3rem);
    line-height: 1.22;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .statement strong {
    font-weight: 500;
  }
  .start-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer .links {
    display: flex;
    gap: 1.75rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    .book,
    .tools,
    .founder {
      grid-template-columns: minmax(0, 1fr);
    }
    .book {
      row-gap: 1.5rem;
    }
    .book .plate {
      width: min(70vw, 320px);
    }
    .portrait {
      width: min(60vw, 280px);
    }
  }
</style>
