---
// TAL Company, as a drawing set. The cover states TAL's value: AI multiplies
// whatever structure it is given, and TAL designs that structure and builds
// the tools that hold it. Then one sheet per area of TAL's practice
// (authority, meaning, correctness), each with the product TAL has made for
// it as its exhibit; a sheet on how the consulting and the products are one
// business; and a closing sheet with the one action.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import WorkSheet from "../components/WorkSheet.astro";
import Arrow from "../components/Arrow.astro";
import CoverDrawing from "../components/CoverDrawing.astro";

const statement = "AI multiplies whatever structure it is given.";
const thesis =
  "Machines read structure as instruction: a rule, a role, a definition, a type. Whatever is vague or wrong in it now runs at scale. TAL designs that structure, the rules, definitions, and code an organization’s agents run on, and builds the tools that hold it.";
const email = "contact@talco.dev";
const inquiry = `mailto:${email}?subject=${encodeURIComponent("Conversation")}`;

// what an engagement leaves in place, one per area of the practice
const leaves = [
  "Decision rights the organization’s agents act within.",
  "A model of the business that all its systems share.",
  "Code that cannot drift from the design.",
];

const works = (await getCollection("works", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.sheet - b.data.sheet,
);
const sheetNo = (n: number) => String(n).padStart(2, "0");

// What the page is, for search engines and link unfurlers: the organization,
// its founder, each work as the kind of thing it is, and the engagements.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const founder = `${ORIGIN}/#founder`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: statement,
      founder: { "@id": founder },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Engagements",
        itemListElement: works.map(({ data }) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: data.offer.name,
            description: data.offer.promise,
          },
        })),
      },
    },
    {
      "@type": "Person",
      "@id": founder,
      name: "Kyle J. Tobin",
      worksFor: { "@id": org },
      sameAs: ["https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      ...(data.subtitle && { alternativeHeadline: data.subtitle }),
      description: data.reveal,
      author: data.by.map((name) => ({ "@type": "Person", name })),
      publisher: { "@id": org },
      url: data.url,
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Base title="TAL Company" description={`TAL Company. ${statement}`}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <header class="bar">
    <a class="home" href="#cover" aria-label="TAL Company, top of page"
      ><Mark /></a
    >
    <a class="cta" href={inquiry}>Start a conversation</a>
  </header>

  <Drawing
    id="cover"
    label="TAL Company"
    titleBlock="Architecture and products for the automated organization"
  >
    <div class="cover">
      <div class="statement">
        <Mark />
        <h1>{statement}</h1>
        <div class="thesis">
          <p>{thesis}</p>
        </div>
      </div>
      <nav class="index" aria-label="What TAL designs">
        <p class="mono-label">What TAL designs</p>
        <CoverDrawing />
        <ol>
          {
            works.map(({ data }) => (
              <li>
                <a href={`#sheet-${sheetNo(data.sheet)}`}>
                  <span class="no">{sheetNo(data.sheet)}</span>
                  <span class="name">{data.area}</span>
                  <span class="question">{data.question}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </Drawing>

  {
    works.map((work) => (
      <Drawing
        id={`sheet-${sheetNo(work.data.sheet)}`}
        number={sheetNo(work.data.sheet)}
        label={work.data.area}
        titleBlock={work.data.area}
      >
        <WorkSheet work={work} email={email} />
      </Drawing>
    ))
  }

  <Drawing
    id="sheet-04"
    number="04"
    label="How TAL works"
    titleBlock="How TAL works"
  >
    <div class="works">
      <h2>Advice that ships as working structure.</h2>
      <div class="works-body">
        <p>
          An engagement does not end in a recommendation. It ends in structure
          the organization runs on.
        </p>
        <ol class="schedule">
          {
            works.map(({ data }, i) => (
              <li>
                <span class="no">{sheetNo(data.sheet)}</span>
                <span class="area mono-label">{data.area}</span>
                <span class="leaves">{leaves[i]}</span>
              </li>
            ))
          }
        </ol>
        <p>
          TAL’s products are the same work, generalized: built once from
          problems that appear in every organization, and kept honest by being
          used.
        </p>
      </div>
    </div>
  </Drawing>

  <Drawing id="start" number="05" label="Start" titleBlock="Contact" compact>
    <div class="start">
      <h2>
        The right time to design the structure is before agents run on it.
      </h2>
      <div class="start-actions">
        <a class="cta" href={inquiry}>Start a conversation</a>
        <a class="go" href={inquiry}>{email} <Arrow /></a>
      </div>
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <a href={inquiry}>{email}</a>
    <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
  </footer>
  <script is:inline>
    // the bar's mark stands down while the cover's mark is in view. without
    // this script the bar simply always shows it.
    if ("IntersectionObserver" in window) {
      const cover = document.querySelector("#cover .cover");
      new IntersectionObserver(
        ([e]) =>
          document.documentElement.classList.toggle(
            "at-cover",
            e.isIntersecting,
          ),
        { rootMargin: "-56px 0px 0px 0px" },
      ).observe(cover.querySelector(".mark") || cover);
    }
  </script>
</Base>

<style>
  /* the cover: the statement on the left, from the mark down through the
     field's name to the thesis; on the right, the one drawing on the site
     standing on the list of drawings it keys */
  .cover {
    --mark: clamp(52px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 3rem;
    align-items: end;
  }
  .statement {
    grid-column: 1 / span 7;
    display: grid;
    gap: clamp(1.5rem, 4vh, 2.75rem);
  }
  .cover :global(.mark) {
    justify-self: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 5.6vw, 4.75rem);
    line-height: 1.03;
    letter-spacing: -0.012em;
    max-width: 17ch;
    text-wrap: balance;
  }

  .thesis p {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-light);
    max-width: 36rem;
  }

  /* the drawing list, as every set opens with, under the drawing it keys:
     the drawing stands on the list's top rule, where its leaders land */
  .index {
    grid-column: 8 / span 5;
  }
  .index :global(.cover-drawing) {
    margin-top: 1.25rem;
  }
  .index ol {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .index li {
    border-bottom: 1px solid var(--line-faint);
  }
  /* number, then the layer over the work it draws */
  .index a {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    row-gap: 0.15rem;
    padding: 0.85rem 0;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .index .no {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .index .question,
  .index .name {
    grid-column: 2;
  }
  .index .question {
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--ink-quiet);
  }
  .index .no {
    grid-row: 1 / span 2;
  }
  .index .name {
    font-family: var(--font-display);
    font-size: 1.12rem;
    transition: transform 0.4s var(--ease);
  }
  .index a:hover .name,
  .index a:focus-visible .name {
    transform: translateX(4px);
  }
  .index a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  /* ---- the bar: the mark and the one action, always in reach ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 28px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
    transition: opacity 0.4s var(--ease);
  }
  /* while the cover's own mark is on screen, the bar does not repeat it */
  :global(.at-cover) .home {
    opacity: 0;
    pointer-events: none;
  }

  /* the one action, framed like the mark, inverting to ink when touched */
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .cta:hover,
  .cta:focus-visible {
    background-color: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* ---- how TAL works: the claim against what an engagement leaves ---- */
  .works {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 2rem;
    align-items: start;
  }
  .works h2,
  .start h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 4.6vw, 3.9rem);
    line-height: 1.06;
    letter-spacing: -0.01em;
  }
  .works h2 {
    grid-column: 1 / span 5;
    max-width: 14ch;
    text-wrap: balance;
  }
  .works-body {
    grid-column: 7 / span 6;
  }
  .works-body p {
    font-size: clamp(1.15rem, 1.6vw, 1.32rem);
    line-height: 1.55;
    color: var(--ink-light);
    max-width: 36rem;
  }
  .schedule {
    list-style: none;
    margin: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .schedule li {
    display: grid;
    grid-template-columns: 2.25rem 8rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .schedule .no {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .schedule .leaves {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  /* ---- start: the reason to begin, and the action ---- */
  .start h2 {
    max-width: 20ch;
    text-wrap: balance;
  }
  .start-actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    .works h2,
    .works-body {
      grid-column: 1 / -1;
    }
    .schedule li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .schedule .area,
    .schedule .leaves {
      grid-column: 2;
    }
    .statement,
    .index {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index .name {
      transition: none;
    }
  }
</style>
