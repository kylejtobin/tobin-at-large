---
// TAL Company, set as an imprint rather than a firm. The page leads with a
// thesis and the works that argue it, published under TAL's name: a title
// page with the thesis and its contents, the book, the two open-source
// works, and the author. Contact is correspondence, never a button.
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import Arrow from "../components/Arrow.astro";
import portrait from "../assets/founder.png";

const thesis = "An organization can be made explicit enough to run on its own.";
const email = "contact@talco.dev";
const mailto = `mailto:${email}`;
const linkedin = "https://www.linkedin.com/in/kyletobin/";

const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
const [book, ...tools] = works;
const anchor = (title: string) =>
  title.toLowerCase().replace(/[^a-z0-9]+/g, "-");

// What the page is, for search engines and link unfurlers.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const author = `${ORIGIN}/#author`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: thesis,
      founder: { "@id": author },
    },
    {
      "@type": "Person",
      "@id": author,
      name: "Kyle J. Tobin",
      image: `${ORIGIN}/logo/founder.png`,
      worksFor: { "@id": org },
      sameAs: [linkedin, "https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      author: { "@id": author },
      publisher: { "@id": org },
      datePublished: String(data.year),
      url: data.url,
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Base title="TAL Company" description={`TAL Company. ${thesis}`}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <!-- the bar: the imprint, and nothing to buy -->
  <header class="bar">
    <a class="home" href="#cover" aria-label="TAL Company, top of page"
      ><Mark /></a
    >
  </header>

  <!-- the title page: the thesis, and the works that argue it -->
  <Drawing id="cover" label="TAL Company" full>
    <div class="cover">
      <div class="colophon"><Mark /></div>
      <h1>{thesis}</h1>
      <ol class="contents" aria-label="The works">
        {
          works.map(({ data }) => (
            <li>
              <a href={`#${anchor(data.title)}`}>
                <span class="entry-title">{data.title}</span>
                <span class="entry-kind">
                  {data.label}, {data.year}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </Drawing>

  {
    book && (
      <Drawing id={anchor(book.data.title)} number="01" label={book.data.title}>
        <figure class="book">
          <a
            class="plate"
            href={book.data.url}
            rel="noopener"
            tabindex="-1"
            aria-hidden="true"
          >
            <Picture
              src={book.data.cover}
              alt=""
              widths={[400, 800]}
              sizes="(max-width: 900px) 70vw, 400px"
              formats={["avif", "webp"]}
              loading="lazy"
            />
          </a>
          <figcaption>
            <span class="kind mono-label">
              {book.data.label} · {book.data.year}
            </span>
            <a class="title-link" href={book.data.url} rel="noopener">
              {book.data.title}
              <Arrow />
            </a>
            <span class="by">Kyle J. Tobin</span>
            <span class="line">{book.data.line}</span>
          </figcaption>
        </figure>
      </Drawing>
    )
  }

  <Drawing id="open-source" number="02" label="Open source">
    <div class="tools">
      {
        tools.map(({ data }) => (
          <figure class="tool" id={anchor(data.title)}>
            <a
              class="plate"
              href={data.url}
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={data.cover}
                alt=""
                widths={[560, 1120]}
                sizes="(max-width: 900px) calc(100vw - 4rem), 560px"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            </a>
            <figcaption>
              <span class="kind mono-label">
                {data.label} · {data.year}
              </span>
              <a class="title-link" href={data.url} rel="noopener">
                {data.title}
                <Arrow />
              </a>
              <span class="line">{data.line}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Drawing>

  <!-- the author, and correspondence -->
  <Drawing id="author" number="03" label="Author">
    <div class="author">
      <div class="portrait">
        <Picture
          src={portrait}
          alt="Kyle J. Tobin, drawn in pencil"
          widths={[240, 480]}
          sizes="(max-width: 900px) 50vw, 240px"
          formats={["avif", "webp"]}
          loading="lazy"
        />
      </div>
      <div class="author-text">
        <p class="statement">
          <strong>Kyle J. Tobin</strong> works on how organizations will now have
          to run: whole, explicit, and executable, from the authority at the top to
          the code underneath.
        </p>
        <p class="correspondence">
          <span class="mono-label">Correspondence</span>
          <a href={mailto}>{email}</a>
        </p>
      </div>
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <span class="links">
      <a href={linkedin} rel="noopener">LinkedIn</a>
      <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
    </span>
  </footer>
  <script is:inline>
    // the bar's imprint stands down while the title page's is in view
    if ("IntersectionObserver" in window) {
      const mark = document.querySelector("#cover .mark");
      if (mark) {
        new IntersectionObserver(
          ([e]) =>
            document.documentElement.classList.toggle(
              "at-cover",
              e.isIntersecting,
            ),
          { rootMargin: "-56px 0px 0px 0px" },
        ).observe(mark);
      }
    }
  </script>
</Base>

<style>
  /* ---- the title page: the imprint small, the thesis, the contents ---- */
  .cover {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: clamp(2rem, 5vh, 3.5rem);
    align-content: end;
  }
  .colophon {
    --mark: clamp(34px, 3.2vw, 44px);
    grid-column: 1 / -1;
  }
  h1 {
    grid-column: 1 / span 8;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 5.2vw, 4.7rem);
    line-height: 1.05;
    letter-spacing: -0.014em;
    max-width: 17ch;
    text-wrap: balance;
  }
  /* the contents, set like a journal's: title, then kind and year */
  .contents {
    grid-column: 1 / span 7;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .contents li {
    border-bottom: 1px solid var(--line-faint);
  }
  .contents a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding: 0.7rem 0;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .entry-title {
    font-size: clamp(1.15rem, 1.5vw, 1.32rem);
    transition: transform 0.4s var(--ease);
  }
  .entry-kind {
    font-style: italic;
    font-size: 1.02rem;
    color: var(--ink-quiet);
  }
  .contents a:hover .entry-title,
  .contents a:focus-visible .entry-title {
    transform: translateX(4px);
  }
  .contents a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  /* ---- the bar: the imprint only ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 26px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
    transition: opacity 0.4s var(--ease);
  }
  :global(.at-cover) .home {
    opacity: 0;
    pointer-events: none;
  }

  /* ---- the works: plates printed on the page's paper ---- */
  .plate {
    display: block;
    line-height: 0;
    box-shadow:
      0 0 0 1px rgba(26, 26, 26, 0.1),
      0 1px 1px rgba(26, 26, 26, 0.12),
      0 18px 32px -16px rgba(40, 30, 15, 0.3);
  }
  /* the plate's own ground gives way to the paper; its ink stays full */
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  figcaption {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .kind {
    letter-spacing: 0.12em;
  }
  .by {
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-quiet);
  }
  .title-link {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.22;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.3s var(--ease);
  }
  .title-link :global(svg) {
    margin-left: 0.3em;
    vertical-align: 0.12em;
  }
  .title-link:hover,
  .title-link:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }
  .line {
    margin-top: 0.3rem;
    max-width: 32ch;
    font-size: 1.22rem;
    line-height: 1.45;
    color: var(--ink-light);
    text-wrap: pretty;
  }

  /* the book leads: the cover large, its entry beside it */
  .book {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }
  .book .title-link {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
  }
  .book .line {
    font-size: clamp(1.25rem, 1.7vw, 1.45rem);
  }

  /* the two open-source works, side by side at equal weight */
  .tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 4vw, 3.5rem);
    row-gap: 3rem;
    align-items: start;
  }
  .tool {
    scroll-margin-top: calc(var(--bar) + 2rem);
  }
  .tool figcaption {
    margin-top: 1.1rem;
  }

  /* ---- the author: portrait, one sentence, correspondence ---- */
  .author {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 2rem;
    align-items: center;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .author-text {
    max-width: 40rem;
  }
  .statement {
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
    line-height: 1.35;
    color: var(--ink);
    text-wrap: pretty;
  }
  .statement strong {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .correspondence {
    margin-top: 2rem;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .correspondence a {
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
  }
  .correspondence a:hover,
  .correspondence a:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer .links {
    display: flex;
    gap: 1.75rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    h1,
    .contents {
      grid-column: 1 / -1;
    }
    .book,
    .tools,
    .author {
      grid-template-columns: minmax(0, 1fr);
    }
    .book {
      row-gap: 1.5rem;
    }
    .book .plate {
      width: min(70vw, 320px);
    }
    .portrait {
      width: min(50vw, 220px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .entry-title {
      transition: none;
    }
  }
</style>
