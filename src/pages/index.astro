---
// TAL Company. The page is TAL's positions on what organizations are becoming,
// drawn as a set: a cover that states the point of view and indexes the
// positions, one sheet per position with its proof, what it takes, the work
// TAL has made, and the founder, whose sheet is the door.
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Drawing from "../components/Drawing.astro";
import PositionSheet from "../components/PositionSheet.astro";
import Arrow from "../components/Arrow.astro";
import portrait from "../assets/founder.png";
import CoverDrawing from "../components/CoverDrawing.astro";
import Cycle from "../components/Cycle.astro";
import Proof from "../components/Proof.astro";
import type { CollectionEntry } from "astro:content";

const view = "A stream of work can now run with no one in it.";
const consequence =
  "People keep work moving with judgment no rule ever caught, and that judgment is knowledge: the people at the desk know how the work runs. An AI agent can exercise it now. Before a stream runs, the people at the desk say what they know, and we build the world the agent decides in: which outcomes can exist and what each needs. A wrong outcome isn’t there to choose. After, managers change what can exist. During, no one touches a case.";
// the cover's exhibit: one decision, by judgment, and the same decision as
// something an agent can hold
const coverProof: CollectionEntry<"positions">["data"]["proof"] = [
  {
    kind: "speech",
    label: "The desk",
    lines: [
      "“Order’s paid, customer’s waiting. Refund it. Tell finance after.”",
      "“Three years with us. I’m not charging her forty dollars over this.”",
    ],
  },
  {
    kind: "table",
    columns: ["The next case", "The agent"],
    rows: [
      [
        "Paid, waiting, three years with us, and the customer asks for the restocking fee back too",
        "Refunds, waives the fee, tells finance",
      ],
    ],
  },
];
const email = "contact@talco.dev";
// the same first step the cycle ends on
const oneStream = `mailto:${email}?subject=${encodeURIComponent("One stream")}`;

const positions = (await getCollection("positions")).sort(
  (a, b) => a.data.sheet - b.data.sheet,
);
const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
const [book, ...software] = works;
const no = (n: number) => String(n).padStart(2, "0");
// the sheets after the positions, in order
const after = positions.length + 1;
const linkedin = "https://www.linkedin.com/in/kyletobin/";

// What the page is, for search engines and link unfurlers.
const ORIGIN = "https://talco.dev";
const org = `${ORIGIN}/#org`;
const founder = `${ORIGIN}/#founder`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "TAL Company",
      url: `${ORIGIN}/`,
      logo: `${ORIGIN}/logo/tal-lockup.png`,
      email,
      description: `${view} ${consequence}`,
      founder: { "@id": founder },
    },
    {
      "@type": "Person",
      "@id": founder,
      name: "Kyle J. Tobin",
      jobTitle: "Founder",
      image: `${ORIGIN}/logo/founder.png`,
      worksFor: { "@id": org },
      sameAs: [linkedin, "https://github.com/kylejtobin"],
    },
    ...works.map(({ data }) => ({
      "@type": data.kind === "book" ? "Book" : "SoftwareSourceCode",
      name: data.title,
      author: { "@id": founder },
      publisher: { "@id": org },
      url: data.url,
      ...(data.kind === "software" && {
        codeRepository: data.url,
        programmingLanguage: "Python",
      }),
    })),
  ],
};
---

<Base title="TAL Company" description={`TAL Company. ${view} ${consequence}`}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <header class="bar">
    <a class="home" href="#cover" aria-label="TAL Company, top of page"
      ><Mark /></a
    >
    <a class="cta" href={oneStream}>Email us</a>
  </header>

  <Drawing id="cover" label="TAL Company" full>
    <div class="cover">
      <div class="statement">
        <Mark />
        <h1>{view}</h1>
        <div class="cover-exhibit">
          <Proof proof={coverProof} />
        </div>
        <p class="consequence">{consequence}</p>
      </div>
      <nav class="index" aria-label="What we find in every company">
        <CoverDrawing count={positions.length} />
        <ol>
          {
            positions.map(({ data }) => (
              <li>
                <a href={`#position-${no(data.sheet)}`}>
                  <span class="no">{no(data.sheet)}</span>
                  <span class="name">{data.short}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </Drawing>

  {
    positions.map((position) => (
      <Drawing
        id={`position-${no(position.data.sheet)}`}
        number={no(position.data.sheet)}
        label={position.data.short}
      >
        <PositionSheet position={position} />
      </Drawing>
    ))
  }

  <Drawing id="how-we-do-it" number={no(after)} label="How we do it">
    <div class="method">
      <p class="mono-label">How we do it</p>
      <h2>One stream of work at a time.</h2>
      <Cycle door={oneStream} />
    </div>
  </Drawing>

  <Drawing id="work" number={no(after + 1)} label="Work">
    <div class="work">
      <h2 class="work-head">The book and the code.</h2>
      {
        book && (
          <figure class="hero-item">
            <a
              class="plate"
              href={book.data.url}
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={book.data.cover}
                alt=""
                widths={[320, 640]}
                sizes="(max-width: 900px) 60vw, 320px"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            </a>
            <figcaption>
              <span class="kind">{book.data.label}</span>
              <a class="title-link" href={book.data.url} rel="noopener">
                {book.data.title}
                <Arrow />
              </a>
              <span class="by">by Kyle J. Tobin</span>
              <span class="line">{book.data.line}</span>
            </figcaption>
          </figure>
        )
      }
      <div class="tools">
        {
          software.map(({ data }) => (
            <figure class="tool">
              <a
                class="plate"
                href={data.url}
                rel="noopener"
                tabindex="-1"
                aria-hidden="true"
              >
                <Picture
                  src={data.cover}
                  alt=""
                  widths={[480, 960]}
                  sizes="(max-width: 900px) calc(100vw - 4rem), 480px"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
              </a>
              <figcaption>
                <span class="kind">{data.label}</span>
                <a class="title-link" href={data.url} rel="noopener">
                  {data.title}
                  <Arrow />
                </a>
                <span class="line">{data.line}</span>
                {data.code && (
                  <div class="thing">
                    <Proof proof={[{ kind: "code", code: data.code }]} />
                  </div>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </Drawing>

  <Drawing id="founder" number={no(after + 2)} label="Founder">
    <div class="founder">
      <div class="portrait">
        <Picture
          src={portrait}
          alt="Kyle J. Tobin, drawn in pencil"
          widths={[280, 560]}
          sizes="(max-width: 900px) 60vw, 280px"
          formats={["avif", "webp"]}
          loading="lazy"
        />
      </div>
      <div class="founder-text">
        <p class="statement-lead">
          <strong>Kyle J. Tobin</strong> sits at the desks where the work gets decided,
          finds the judgment the people there use, and builds the world the agent
          then decides in.
        </p>
        <div class="start-actions">
          <a class="cta" href={oneStream}>Email us</a>
          <a class="go" href={oneStream}>{email} <Arrow /></a>
        </div>
      </div>
    </div>
  </Drawing>

  <footer class="mono-label">
    <span>© {new Date().getFullYear()} TAL Company</span>
    <span class="links">
      <a href={linkedin} rel="noopener">LinkedIn</a>
      <a href="https://github.com/kylejtobin" rel="noopener">GitHub</a>
    </span>
  </footer>
  <script is:inline>
    // the bar's mark stands down while the cover's mark is in view. without
    // this script the bar simply always shows it.
    if ("IntersectionObserver" in window) {
      const mark = document.querySelector("#cover .statement .mark");
      if (mark) {
        new IntersectionObserver(
          ([e]) =>
            document.documentElement.classList.toggle(
              "at-cover",
              e.isIntersecting,
            ),
          { rootMargin: "-56px 0px 0px 0px" },
        ).observe(mark);
      }
    }
  </script>
</Base>

<style>
  /* ---- the cover: the point of view on the left; on the right, the one
     drawing on the site, standing on the index of positions it keys ---- */
  .cover {
    --mark: clamp(52px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: 2.5rem;
    align-items: end;
  }
  .statement {
    grid-column: 1 / span 7;
    display: grid;
    gap: clamp(0.9rem, 2vh, 1.4rem);
  }
  /* the cover's exhibit: the decision by judgment, struck, and the same
     decision as a row an agent can hold */
  .cover-exhibit {
    max-width: 36rem;
  }
  .cover-exhibit :global(.code) {
    line-height: 1.5;
    padding: 0.8rem 1rem;
  }
  .cover-exhibit :global(.proof) {
    gap: 0.7rem;
  }
  .cover-exhibit :global(.speech p) {
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .cover :global(.mark) {
    justify-self: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 4.4vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.014em;
    max-width: 22ch;
    text-wrap: pretty;
  }
  .consequence {
    font-size: clamp(1.1rem, 1.4vw, 1.28rem);
    line-height: 1.45;
    color: var(--ink-light);
    max-width: 37rem;
    text-wrap: pretty;
  }

  .index {
    grid-column: 8 / span 5;
  }
  .index :global(.cover-drawing) {
    margin-top: 0.5rem;
    width: 100%;
    max-height: 250px;
  }
  .index ol {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .index li {
    border-bottom: 1px solid var(--line-faint);
  }
  .index a {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    padding: 0.35rem 0;
    min-height: 38px;
    color: var(--ink);
    text-decoration: none;
  }
  .index .no {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .index .name {
    font-family: var(--font-display);
    font-size: 1.12rem;
    transition: transform 0.4s var(--ease);
  }
  .index a:hover .name,
  .index a:focus-visible .name {
    transform: translateX(4px);
  }
  .index a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  /* ---- the bar: the mark and the one action ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--gutter) * 0.5 + 1.25rem);
    background: rgba(238, 227, 208, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line-faint);
  }
  .home {
    --mark: 28px;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
    transition: opacity 0.4s var(--ease);
  }
  /* while the cover's own mark is on screen, the bar does not repeat it */
  :global(.at-cover) .home {
    opacity: 0;
    pointer-events: none;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .cta:hover,
  .cta:focus-visible {
    background-color: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* ---- the work: one composed exhibit. the book leads; the two tools
     support it, stacked at half its weight ---- */
  .work {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      "head head"
      "book tools";
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 2.25rem;
    align-items: start;
  }
  .work-head {
    grid-area: head;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
  }
  /* the book's caption may run wider than its cover */
  .hero-item {
    grid-area: book;
  }
  .hero-item .plate {
    width: min(100%, 320px);
  }
  /* the tools stack, together matching the book's height */
  .tools {
    grid-area: tools;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 30rem;
  }
  .plate {
    display: block;
    line-height: 0;
  }
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 0 0 1px rgba(26, 26, 26, 0.08),
      0 1px 1px rgba(26, 26, 26, 0.14),
      0 18px 32px -14px rgba(40, 30, 15, 0.34);
  }
  figcaption {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.1rem;
    justify-items: start;
  }
  .kind,
  .by {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-quiet);
  }
  /* one link style for every title: the underline matches its text, and the
     arrow stays on the title's last line */
  .title-link {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.3s var(--ease);
  }
  .hero-item .title-link {
    font-size: 1.45rem;
  }
  /* what it is, said once, for whoever will vet it */
  .line {
    margin-top: 0.3rem;
    max-width: 30ch;
    font-size: 1.12rem;
    line-height: 1.45;
    color: var(--ink-light);
  }
  /* the thing itself, a few lines of it */
  .thing {
    margin-top: 0.8rem;
    width: 100%;
  }
  .title-link :global(svg) {
    margin-left: 0.3em;
    vertical-align: 0.12em;
  }
  .title-link:hover,
  .title-link:focus-visible {
    text-decoration-color: var(--ink);
    outline: none;
  }

  /* ---- what it takes: the claim, then the cycle taught ---- */
  .method h2 {
    margin: 0.4rem 0 2.25rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.008em;
    max-width: 24ch;
    text-wrap: balance;
  }

  /* ---- the founder: the portrait drawn on the sheet, the statement beside it ---- */
  .founder {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 2rem;
    align-items: center;
  }
  /* drawn on the sheet like the Scale scene: its edges dissolve into
     the paper rather than sitting as a plate */
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .founder-text {
    max-width: 40rem;
  }
  .statement-lead {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.7vw, 2.3rem);
    line-height: 1.22;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .statement-lead strong {
    font-weight: 500;
  }
  .statement-body {
    margin-top: 1.25rem;
    font-size: clamp(1.18rem, 1.6vw, 1.38rem);
    line-height: 1.55;
    color: var(--ink-light);
  }

  /* the door sits under the founder's statement */
  .start-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem calc(var(--gutter) + 1.5rem) 2.5rem;
  }
  footer .links {
    display: flex;
    gap: 1.75rem;
  }
  footer a {
    color: var(--ink-quiet);
    text-decoration: none;
    border-bottom: 1px solid var(--line-faint);
  }
  footer a:hover,
  footer a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: none;
  }

  @media (max-width: 900px) {
    .statement,
    .index {
      grid-column: 1 / -1;
    }
    .work {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "book" "tools";
    }
    .hero-item .plate {
      width: min(60vw, 300px);
    }
    .tools {
      gap: 2.25rem;
    }
    .founder {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      width: min(60vw, 280px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index .name {
      transition: none;
    }
  }
</style>
