---
// Every section of the record opens the same way: a tracked capital label and
// a hairline the full width of the column.
interface Props {
  label: string;
  id: string;
}

const { label, id } = Astro.props;
---

<section aria-labelledby={id}>
  <h2 class="label" id={id}>{label}</h2>
  <hr />
  <div class="body"><slot /></div>
</section>

<style>
  section {
    margin-top: var(--section-gap);
  }
  hr {
    height: 1px;
    border: 0;
    background: var(--rule);
    opacity: 0.55;
    margin-top: 0.75rem;
  }
  .body {
    margin-top: 2rem;
  }
</style>
