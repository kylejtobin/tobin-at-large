---
// TCA's exhibit: one payment provider's reply, both ways, printed on the
// sheet as its plates are. The usual code crashes on a normal approval after
// the money moved, and the retry charges twice; the provider's reply,
// modeled once, constructs its own case.
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";

type ShikiTransformer = NonNullable<
  ComponentProps<typeof Code>["transformers"]
>[number];

// the sheet's own inks as a theme: keywords in full ink, names in ink-light,
// strings and comments quiet; nothing else is coloured
type Theme = Exclude<NonNullable<ComponentProps<typeof Code>["theme"]>, string>;
const ink: Theme = {
  name: "tal-ink",
  type: "light",
  colors: {
    "editor.background": "#00000000",
    "editor.foreground": "#33302c",
  },
  tokenColors: [
    {
      scope: ["comment", "punctuation.definition.comment"],
      settings: { foreground: "#625c53", fontStyle: "italic" },
    },
    {
      scope: [
        "string",
        "punctuation.definition.string",
        "string.quoted.docstring",
      ],
      settings: { foreground: "#625c53" },
    },
    {
      scope: [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.logical",
        "constant.language",
      ],
      settings: { foreground: "#1a1a1a", fontStyle: "bold" },
    },
  ],
};

const check = `def charge(order):  # ship it
    try:
        data = post(PAY, order).json()
    except Exception:
        return None  # eh, just retry
    if data.get("status") == "approved":
        return data["charge"]["id"]
    if data.get("status") == "declined":
        return None  # also retry?
    return None  # who knows

# {"status": "approved", "id": "ch_9"}
# KeyError: 'charge'`;

const type = `class Approval(BaseModel):
    status: Approved
    charge: ChargeId = Field(alias="id")
class Decline(BaseModel):
    status: Declined
    codes: DeclineCodes
class Outage(BaseModel):
    error: StatedError
class Reply(RootModel[
    Approval | Decline | Outage
]):
    """Every answer they have."""

# {"status": "approved", "id": "ch_9"}
Reply.model_validate_json(raw)
# Approval(charge=ChargeId('ch_9'))`;

// the lines that decide, the one token that breaks, and the check's author
// in their own voice
const marks = (
  x: number[],
  ok: number[],
  out: number,
  jokes: number[],
  err?: { line: number; from: number; to: number },
): ShikiTransformer => {
  // a comment is several tokens; from its # to the line's end is the joke
  const joking = new Set<number>();
  return {
    name: "marks",
    line(node, line) {
      if (x.includes(line)) this.addClassToHast(node, "x");
      if (ok.includes(line)) this.addClassToHast(node, "ok");
      if (line === out) this.addClassToHast(node, "out");
    },
    span(node, line, col) {
      if (err && line === err.line && col >= err.from && col < err.to)
        this.addClassToHast(node, "err");
      const first = node.children[0];
      if (
        jokes.includes(line) &&
        first?.type === "text" &&
        first.value.trimStart().startsWith("#")
      )
        joking.add(line);
      if (joking.has(line)) this.addClassToHast(node, "joke");
    },
  };
};
---

<figure class="detail">
  <section class="way check" aria-label="The check">
    <p class="label mono-label">
      <span>The check</span><span>payments.py</span>
    </p>
    <Code
      code={check}
      lang="python"
      theme={ink}
      transformers={[
        marks([7, 13], [], 13, [1, 5, 9, 10], { line: 7, from: 19, to: 29 }),
      ]}
    />
    <p class="end"><span aria-hidden="true">✕</span> Charged twice.</p>
  </section>
  <section class="way type" aria-label="The type">
    <p class="label mono-label">
      <span>The type</span><span>payments/model.py</span>
    </p>
    <Code
      code={type}
      lang="python"
      theme={ink}
      transformers={[marks([], [3, 16], 16, [])]}
    />
    <p class="end"><span aria-hidden="true">✓</span> Charged once.</p>
  </section>
</figure>

<style>
  /* printed as the plates are: no fill of its own and no chrome, only the
     mark the press leaves around it. One colour, the plates' vermilion, and
     only where the usual code fails; the type's outcome is in ink with a
     tick. Every mark is carried without colour too: a cross or a tick, a
     squiggle under the error */
  .detail {
    --mark: var(--accent);
    width: 100%;
    padding: clamp(8px, 0.9vw, 12px);
    box-shadow:
      inset 0 0 0 1px rgba(26, 26, 26, 0.16),
      inset 1px 1px 0 1px rgba(255, 250, 240, 0.5);
  }
  .way {
    container-type: inline-size;
  }
  .type {
    --mark: var(--ink);
    border-top: 1px solid var(--line-faint);
  }
  .label {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0.9rem 0;
    font-size: 0.62rem;
  }
  .label span + span {
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .end {
    padding: 0 0.9rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--mark);
  }
  .end span {
    margin-right: 0.3rem;
  }
  /* the type is sized to the plate, so the longest line, forty characters,
     always fits whole */
  .way :global(pre) {
    margin: 0;
    padding: 0.55rem 0.9rem 0.6rem 1.9rem;
    overflow-x: auto;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: clamp(0.64rem, calc((100cqi - 2.8rem) / 24.5), 0.74rem);
    line-height: 1.38;
  }
  .way :global(code) {
    font-family: inherit;
  }
  .way :global(span[style*="font-weight:bold"]) {
    font-weight: 500 !important;
  }
  .way :global(.line) {
    position: relative;
    display: inline-block;
    width: 100%;
  }
  .way :global(.line.x) {
    background: rgba(179, 49, 30, 0.07);
  }
  .way :global(.line.ok) {
    background: rgba(26, 26, 26, 0.05);
  }
  .way :global(.line.x)::before,
  .way :global(.line.ok)::before {
    position: absolute;
    left: -1.35em;
    color: var(--mark);
    font-weight: 500;
  }
  .way :global(.line.x)::before {
    content: "✕";
  }
  .way :global(.line.ok)::before {
    content: "✓";
  }
  /* what each way ends in, and the check's voice, in its outcome's ink */
  .way :global(.line.out span),
  .way :global(.joke) {
    color: var(--mark) !important;
  }
  .way :global(.line.out span) {
    font-style: normal !important;
    font-weight: 500;
  }
  .way :global(.err) {
    text-decoration: underline wavy var(--mark);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
</style>
