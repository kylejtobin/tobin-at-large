---
// TCA's exhibit: one payment provider's reply, drawn as two details on the
// sheet. The shape of each is the argument: the usual code is a staircase,
// its nesting drawn and dimensioned; the type is a flat schedule, one deep.
// Each ends on what it does with an ordinary approval.
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";

type ShikiTransformer = NonNullable<
  ComponentProps<typeof Code>["transformers"]
>[number];
type Theme = Exclude<NonNullable<ComponentProps<typeof Code>["theme"]>, string>;

// the sheet's own inks: keywords in full ink, the rest in ink-light,
// strings and comments quiet; nothing else is coloured
const ink: Theme = {
  name: "tal-ink",
  type: "light",
  colors: {
    "editor.background": "#00000000",
    "editor.foreground": "#33302c",
  },
  tokenColors: [
    {
      scope: ["comment", "punctuation.definition.comment"],
      settings: { foreground: "#625c53", fontStyle: "italic" },
    },
    {
      scope: [
        "string",
        "punctuation.definition.string",
        "string.quoted.docstring",
      ],
      settings: { foreground: "#625c53" },
    },
    {
      scope: [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.logical",
        "constant.language",
      ],
      settings: { foreground: "#1a1a1a", fontStyle: "bold" },
    },
  ],
};

const check = `def charge(order):  # ship it
    try:
        data = post(PAY, order).json()
    except Exception:
        return None  # eh, just retry
    if "status" in data:
        if data["status"] == "approved":
            return data["charge"]["id"]
        if data["status"] == "declined":
            return None  # also retry?
    return None  # who knows

# {"status": "approved", "id": "ch_9"}
# KeyError: 'charge'`;

const type = `class Approval(BaseModel):
    status: Approved
    charge: ChargeId = Field(alias="id")
class Decline(BaseModel):
    status: Declined
    codes:  DeclineCodes
class Outage(BaseModel):
    error:  StatedError
class Reply(RootModel[
    Approval | Decline | Outage
]):
    """Every answer they have."""

# {"status": "approved", "id": "ch_9"}
Reply.model_validate_json(raw)
# Approval(charge=ChargeId('ch_9'))`;

// how deep the code sits, line by line, in levels of four spaces
const depth = (code: string) =>
  code
    .split("\n")
    .map((l) => Math.floor((l.length - l.trimStart().length) / 4));
const deepest = (code: string) => Math.max(...depth(code));

// each line's nesting drawn as construction lines, the result it ends on,
// the one token that breaks, and the check's author in their own voice
const marks = (
  code: string,
  out: number,
  jokes: number[],
  err?: { line: number; from: number; to: number },
): ShikiTransformer => {
  const levels = depth(code);
  // a comment is several tokens; from its # to the line's end is the joke
  const joking = new Set<number>();
  return {
    name: "marks",
    line(node, line) {
      const d = levels[line - 1] ?? 0;
      if (d) this.addClassToHast(node, `d${d}`);
      if (line === out) this.addClassToHast(node, "out");
      // the tokens that break, gathered under one wave
      if (err && line === err.line) {
        type Child = (typeof node.children)[number];
        const width = (n: Child): number =>
          n.type === "text"
            ? n.value.length
            : "children" in n
              ? n.children.reduce((sum, c) => sum + width(c), 0)
              : 0;
        const wave: typeof node = {
          type: "element",
          tagName: "span",
          properties: { className: ["err"] },
          children: [],
        };
        let col = 0;
        node.children = node.children.flatMap((child) => {
          const at = col;
          col += width(child);
          if (at < err.from || at >= err.to) return [child];
          wave.children.push(child);
          return wave.children.length === 1 ? [wave] : [];
        });
      }
    },
    span(node, line) {
      const first = node.children[0];
      if (
        jokes.includes(line) &&
        first?.type === "text" &&
        first.value.trimStart().startsWith("#")
      )
        joking.add(line);
      if (joking.has(line)) this.addClassToHast(node, "joke");
    },
  };
};
---

<figure class="detail">
  <section class="way check" aria-label="Detail A, the check">
    <p class="title">
      <span class="bubble" aria-hidden="true">A</span>
      <span class="mono-label">The check</span>
      <span class="mono-label file">payments.py</span>
    </p>
    <div class="code">
      <p class="dim" style={`--n: ${deepest(check)}`} aria-hidden="true">
        <span class="mono-label">{deepest(check)} deep</span>
      </p>
      <Code
        code={check}
        lang="python"
        theme={ink}
        transformers={[
          marks(check, 14, [1, 5, 10, 11], { line: 8, from: 24, to: 32 }),
        ]}
      />
    </div>
    <p class="end">Charged twice.</p>
  </section>
  <section class="way type" aria-label="Detail B, the type">
    <p class="title">
      <span class="bubble" aria-hidden="true">B</span>
      <span class="mono-label">The type</span>
      <span class="mono-label file">payments/model.py</span>
    </p>
    <div class="code">
      <p class="dim" style={`--n: ${deepest(type)}`} aria-hidden="true">
        <span class="mono-label">{deepest(type)} deep</span>
      </p>
      <Code
        code={type}
        lang="python"
        theme={ink}
        transformers={[marks(type, 16, [])]}
      />
    </div>
    <p class="end">Charged once.</p>
  </section>
</figure>

<style>
  /* two details drawn straight onto the drawing field: no frame, no fill,
     no chrome. The nesting of each line is drawn in construction lines and
     the deepest is dimensioned, so the staircase and the flat schedule read
     before a word does. One colour, the plates' vermilion, only where the
     usual code fails; every mark also reads without it, as a word, a
     squiggle or a shape */
  .detail {
    display: grid;
    gap: calc(var(--cell) * 1.6);
    width: 100%;
  }
  .way {
    --mark: var(--accent);
    container-type: inline-size;
  }
  .type {
    --mark: var(--ink);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .title .mono-label {
    color: var(--ink);
  }
  .title .file {
    margin-left: auto;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-quiet);
  }
  /* a detail's callout, as a drawing set marks one */
  .bubble {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink);
  }
  /* the type is sized to the detail, so the longest line, forty characters,
     always fits whole */
  .code {
    --pad: 0.2rem;
    padding: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.66rem, calc((100cqi - 0.6rem) / 24.4), 0.86rem);
  }
  .code :global(pre) {
    margin: 0;
    padding: 0.4rem var(--pad) 0;
    overflow-x: auto;
    background: transparent !important;
    font-size: 1em;
    line-height: 1.55;
  }
  .code :global(code) {
    font-family: inherit;
  }
  .code :global(span[style*="font-weight:bold"]) {
    font-weight: 500 !important;
  }
  .code :global(.line) {
    display: inline-block;
    width: 100%;
    background-image: repeating-linear-gradient(
      to right,
      var(--line) 0 1px,
      transparent 1px 4ch
    );
    background-repeat: no-repeat;
    background-size: 0 100%;
  }
  .code :global(.line.d1) {
    background-size: 4ch 100%;
  }
  .code :global(.line.d2) {
    background-size: 8ch 100%;
  }
  .code :global(.line.d3) {
    background-size: 12ch 100%;
  }
  /* the deepest nesting, dimensioned over the code */
  .dim {
    position: relative;
    width: calc(var(--n) * 4ch + 1px);
    height: 0.7rem;
    margin-left: var(--pad);
    border-inline: 1px solid var(--ink-quiet);
    background: linear-gradient(var(--ink-quiet), var(--ink-quiet)) center /
      100% 1px no-repeat;
  }
  .dim span {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.6rem);
    translate: 0 -50%;
    white-space: nowrap;
    color: var(--ink);
  }
  /* what each way ends in, and the check's voice, in its outcome's ink */
  .code :global(.line.out span),
  .code :global(.joke) {
    color: var(--mark) !important;
  }
  .code :global(.line.out span) {
    font-style: normal !important;
    font-weight: 500;
  }
  .code :global(.err) {
    text-decoration: underline wavy var(--mark);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-skip-ink: none;
  }
  /* the one large thing on each detail: what it did with the money */
  .end {
    margin-top: 1.1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-faint);
    font-family: var(--font-body);
    font-size: clamp(1.7rem, 2.6vw, 2.35rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--mark);
  }
</style>
