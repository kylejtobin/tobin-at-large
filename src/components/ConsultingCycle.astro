---
// How TAL consults: the cycle, drawn as the drafting lifecycle it already is.
// One value stream goes through five states: named (SEE), surveyed as built
// against how it is described (DECLARE), revised in red clouds (REFACTOR),
// revised again until issued (PROTOTYPE), and reused as the typical (SCALE).
//
// One DOM serves every reader. Without script, on narrow screens, or with
// reduced motion, the five states read as small multiples, each with its
// line. On wide screens with script, the loop becomes the control and the
// drawing changes state in place; a stage's line shows only when it is
// selected.

const stages = [
  { id: "see", name: "See", line: "A value stream is named." },
  {
    id: "declare",
    name: "Declare",
    line: "Every version of how the work runs is reconciled into the one that is true.",
  },
  {
    id: "refactor",
    name: "Refactor",
    line: "The stream is redesigned whole. Automating one step reshapes the rest.",
  },
  {
    id: "prototype",
    name: "Prototype",
    line: "Built fast and run live. Each failure is the next revision, until it holds.",
  },
  {
    id: "scale",
    name: "Scale",
    line: "What holds becomes the typical, reused across the organization.",
  },
] as const;

// ---- drawing geometry ----------------------------------------------------
const W = 640;
const H = 280;
const flowY = 120; // the stream's flow line
const boxW = 64;
const boxH = 40;
const gap = 40;
const left = 28;
const f = (n: number) => n.toFixed(1);

const xs = (n: number) =>
  Array.from({ length: n }, (_, i) => left + i * (boxW + gap));

// a revision cloud: scallops around a rectangle, drawn clockwise
const cloud = (x: number, y: number, w: number, h: number) => {
  const r = 7;
  const nx = Math.max(2, Math.round(w / (r * 2)));
  const ny = Math.max(2, Math.round(h / (r * 2)));
  const sx = w / nx;
  const sy = h / ny;
  let d = `M ${f(x)} ${f(y)}`;
  for (let i = 1; i <= nx; i++)
    d += ` A ${f(sx / 2)} ${f(sx / 2)} 0 0 1 ${f(x + i * sx)} ${f(y)}`;
  for (let i = 1; i <= ny; i++)
    d += ` A ${f(sy / 2)} ${f(sy / 2)} 0 0 1 ${f(x + w)} ${f(y + i * sy)}`;
  for (let i = 1; i <= nx; i++)
    d += ` A ${f(sx / 2)} ${f(sx / 2)} 0 0 1 ${f(x + w - i * sx)} ${f(y + h)}`;
  for (let i = 1; i <= ny; i++)
    d += ` A ${f(sy / 2)} ${f(sy / 2)} 0 0 1 ${f(x)} ${f(y + h - i * sy)}`;
  return d + " Z";
};

// the stream as process boxes on the flow line, wait triangles between
// them, and the lead-time timeline beneath: high under work, low under wait
const stream = (n: number) => {
  const x = xs(n);
  const top = flowY - boxH / 2;
  const end = x[n - 1] + boxW;
  let timeline = `M ${left} 196`;
  x.forEach((bx, i) => {
    timeline += ` H ${bx} V 196 H ${bx + boxW}`;
    if (i < n - 1) timeline += ` V 210 H ${x[i + 1]} V 196`;
  });
  return { x, top, end, timeline };
};
const asBuilt = stream(6);
const redesigned = stream(4);

// lettered revision triangle
const tri = (cx: number, cy: number) =>
  `M ${f(cx)} ${f(cy - 9)} L ${f(cx + 9)} ${f(cy + 7)} L ${f(cx - 9)} ${f(cy + 7)} Z`;

// ---- the loop control ----------------------------------------------------
// five balloons on a circle, clockwise from the top; prototype carries its
// own small loop, because it turns until it holds
const R = 92;
const C = 120;
const loop = stages.map((s, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return {
    ...s,
    x: C + R * Math.cos(a),
    y: C + R * Math.sin(a),
    // label sits outside the circle
    lx: C + (R + 30) * Math.cos(a),
    ly: C + (R + 30) * Math.sin(a),
    anchor: Math.cos(a) > 0.2 ? "start" : Math.cos(a) < -0.2 ? "end" : "middle",
  };
});
const innerR = 14;
const innerC = {
  x: C + (R - 34) * Math.cos((-90 + 3 * 72) * (Math.PI / 180)),
  y: C + (R - 34) * Math.sin((-90 + 3 * 72) * (Math.PI / 180)),
};
// the arrowhead that closes the loop, just before SEE
const closeA = (-90 - 14) * (Math.PI / 180);
const close = { x: C + R * Math.cos(closeA), y: C + R * Math.sin(closeA) };
---

<div class="cycle" data-cycle>
  <div class="loop" aria-hidden="false">
    <svg class="loop-art" viewBox="0 0 240 240" aria-hidden="true">
      <circle class="loop-path" cx={C} cy={C} r={R}></circle>
      <path
        class="loop-head"
        d={`M ${f(close.x)} ${f(close.y)} l 7 -4 l -1 8 z`}
        transform={`rotate(-14 ${f(close.x)} ${f(close.y)})`}></path>
      <circle class="loop-inner" cx={f(innerC.x)} cy={f(innerC.y)} r={innerR}
      ></circle>
      <path
        class="loop-inner-head"
        d={`M ${f(innerC.x + innerR)} ${f(innerC.y)} l -4 -6 l 8 0 z`}></path>
    </svg>
    <div class="balloons" role="group" aria-label="Stages of the cycle">
      {
        loop.map((s, i) => (
          <button
            type="button"
            class="balloon"
            data-stage={s.id}
            aria-pressed={i === 0 ? "true" : "false"}
            style={`--x: ${f((s.x / 240) * 100)}%; --y: ${f((s.y / 240) * 100)}%; --lx: ${f((s.lx / 240) * 100)}%; --ly: ${f((s.ly / 240) * 100)}%`}
          >
            <span class="dot" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class:list={["name", `anchor-${s.anchor}`]}>{s.name}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="states">
    {
      stages.map((s, i) => (
        <figure
          class="state"
          data-state={s.id}
          data-active={i === 0 ? "true" : "false"}
        >
          <svg
            viewBox={`0 0 ${W} ${H}`}
            role="img"
            aria-label={`${s.name}: ${s.line}`}
          >
            <defs>
              <pattern
                id={`hatch-${s.id}`}
                width="6"
                height="6"
                patternUnits="userSpaceOnUse"
                patternTransform="rotate(45)"
              >
                <path d="M 0 0 V 6" class="hatch-line" />
              </pattern>
            </defs>
            {s.id === "see" && (
              <g>
                <text class="mono" x={left} y={flowY - 28}>
                  STREAM 01
                </text>
                <path class="ink" d={`M ${left} ${flowY} H ${W - 40}`} />
                <circle class="node" cx={left} cy={flowY} r="4" />
                <path
                  class="ink fill"
                  d={`M ${W - 40} ${flowY - 5} l 10 5 l -10 5 z`}
                />
                <text class="mono quiet" x={left} y={flowY + 26}>
                  TRIGGER
                </text>
                <text
                  class="mono quiet"
                  x={W - 30}
                  y={flowY + 26}
                  text-anchor="end"
                >
                  OUTCOME
                </text>
              </g>
            )}

            {s.id === "declare" && (
              <g>
                <text class="mono quiet" x={left} y="34">
                  AS DESCRIBED
                </text>
                <path
                  class="faint dashed"
                  d={`M ${left} 58 H ${asBuilt.end}`}
                />
                {[0, 2, 5].map((k) => (
                  <rect
                    class="faint dashed box"
                    x={asBuilt.x[k]}
                    y="44"
                    width={boxW}
                    height="28"
                  />
                ))}
                <text class="mono" x={left} y={flowY - 32}>
                  AS BUILT
                </text>
                <path class="ink" d={`M ${left} ${flowY} H ${asBuilt.end}`} />
                {asBuilt.x.map((bx, k) => (
                  <>
                    <rect
                      class="ink box"
                      x={bx}
                      y={asBuilt.top}
                      width={boxW}
                      height={boxH}
                    />
                    {k < asBuilt.x.length - 1 && (
                      <path
                        class="ink"
                        d={tri(bx + boxW + gap / 2, flowY + 2)}
                      />
                    )}
                  </>
                ))}
                <path class="ink thin" d={asBuilt.timeline} />
                <text
                  class="mono quiet"
                  x={asBuilt.end}
                  y="236"
                  text-anchor="end"
                >
                  LEAD TIME
                </text>
              </g>
            )}

            {(s.id === "refactor" || s.id === "prototype") && (
              <g>
                <text class="mono" x={left} y={flowY - 42}>
                  {s.id === "refactor" ? "REDESIGN" : "REV C"}
                </text>
                <path
                  class="ink"
                  d={`M ${left} ${flowY} H ${redesigned.end}`}
                />
                {redesigned.x.map((bx, k) => (
                  <>
                    <rect
                      class:list={["ink box", { auto: k === 2 }]}
                      style={k === 2 ? `fill: url(#hatch-${s.id})` : undefined}
                      x={bx}
                      y={redesigned.top}
                      width={boxW}
                      height={boxH}
                    />
                    {k === 0 && (
                      <path
                        class="ink"
                        d={tri(bx + boxW + gap / 2, flowY + 2)}
                      />
                    )}
                  </>
                ))}
                <path class="ink thin" d={redesigned.timeline} />
                <path
                  class="faint dashed"
                  d={`M ${redesigned.end} 196 H ${asBuilt.end}`}
                />
                <text
                  class="mono quiet"
                  x={redesigned.end}
                  y="236"
                  text-anchor="end"
                >
                  LEAD TIME
                </text>
                {s.id === "refactor" && (
                  <>
                    <path
                      class="cloud"
                      d={cloud(
                        redesigned.x[1] - 10,
                        redesigned.top - 10,
                        boxW + 20,
                        boxH + 20,
                      )}
                    />
                    <path
                      class="cloud"
                      d={cloud(
                        redesigned.x[2] - 10,
                        redesigned.top - 10,
                        boxW + 20,
                        boxH + 20,
                      )}
                    />
                  </>
                )}
                {s.id === "prototype" && (
                  <>
                    {[
                      [redesigned.x[1] + boxW / 2, "A"],
                      [redesigned.x[2] + boxW / 2, "B"],
                    ].map(([cx, letter]) => (
                      <g>
                        <path
                          class="rev"
                          d={tri(cx as number, redesigned.top - 22)}
                        />
                        <text
                          class="mono rev-letter"
                          x={cx}
                          y={redesigned.top - 17}
                          text-anchor="middle"
                        >
                          {letter}
                        </text>
                      </g>
                    ))}
                    <g class="block">
                      <rect
                        class="ink box"
                        x="452"
                        y="30"
                        width="160"
                        height="78"
                      />
                      <path
                        class="ink thin"
                        d="M 452 56 H 612 M 452 82 H 612 M 484 30 V 108"
                      />
                      {[
                        ["A", "REVISED", 47],
                        ["B", "REVISED", 73],
                        ["C", "ISSUED", 99],
                      ].map(([rev, status, y]) => (
                        <>
                          <text class="mono" x="468" y={y} text-anchor="middle">
                            {rev}
                          </text>
                          <text
                            class:list={[
                              "mono",
                              { quiet: status !== "ISSUED" },
                            ]}
                            x="496"
                            y={y}
                          >
                            {status}
                          </text>
                        </>
                      ))}
                    </g>
                  </>
                )}
              </g>
            )}

            {s.id === "scale" && (
              <g>
                {[0, 1, 2].map((row) => (
                  <g transform={`translate(0 ${row * 78 - 52}) scale(1 1)`}>
                    <path
                      class="ink"
                      d={`M ${left} ${flowY} H ${redesigned.end}`}
                    />
                    {redesigned.x.map((bx, k) => (
                      <rect
                        class:list={["ink box", { auto: k === 2 }]}
                        style={
                          k === 2 ? `fill: url(#hatch-${s.id})` : undefined
                        }
                        x={bx}
                        y={flowY - 14}
                        width={boxW}
                        height="28"
                      />
                    ))}
                    <text
                      class="mono quiet"
                      x={redesigned.end + 18}
                      y={flowY + 4}
                    >
                      {row === 0 ? "TYP." : `STREAM 0${row + 2}`}
                    </text>
                  </g>
                ))}
              </g>
            )}
          </svg>
          <figcaption>
            <span class="mono-label">
              {String(i + 1).padStart(2, "0")} · {s.name}
            </span>
            <span class="line">{s.line}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script is:inline>
  // the loop becomes the control on wide screens. a stage is selected by
  // click, tap, or keyboard; hovering previews it. narrow screens and no
  // script keep the five states as small multiples.
  (() => {
    const root = document.querySelector("[data-cycle]");
    if (!root) return;
    const wide = matchMedia("(min-width: 900px)");
    const buttons = [...root.querySelectorAll("[data-stage]")];
    const states = [...root.querySelectorAll("[data-state]")];
    let selected = "see";
    const show = (id) =>
      states.forEach(
        (s) => (s.dataset.active = String(s.dataset.state === id)),
      );
    const select = (id) => {
      selected = id;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.stage === id)),
      );
      show(id);
    };
    buttons.forEach((b) => {
      b.addEventListener("click", () => select(b.dataset.stage));
      b.addEventListener("mouseenter", () => show(b.dataset.stage));
      b.addEventListener("mouseleave", () => show(selected));
      b.addEventListener("focus", () => select(b.dataset.stage));
    });
    const mode = () => root.classList.toggle("interactive", wide.matches);
    wide.addEventListener("change", mode);
    mode();
    select(selected);
  })();
</script>

<style>
  /* ---- small multiples: the default for every reader ---- */
  .loop {
    display: none;
  }
  .states {
    display: grid;
    gap: 2.5rem;
  }
  .state svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  figcaption {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.2rem;
  }
  .line {
    font-size: clamp(1.12rem, 1.5vw, 1.3rem);
    line-height: 1.45;
    color: var(--ink-light);
    max-width: 32rem;
  }

  /* drawing marks */
  .ink,
  .faint,
  .cloud,
  .rev {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ink {
    stroke: var(--ink);
  }
  .ink.thin {
    stroke: rgba(26, 26, 26, 0.55);
  }
  .ink.fill {
    fill: var(--ink);
    stroke: none;
  }
  .box {
    fill: rgba(238, 227, 208, 0.6);
  }
  /* an automated step: hatched, as a drawing marks a different material */
  .hatch-line {
    stroke: rgba(26, 26, 26, 0.35);
    stroke-width: 1;
  }
  .faint {
    stroke: rgba(26, 26, 26, 0.35);
  }
  .dashed {
    stroke-dasharray: 4 4;
  }
  .node {
    fill: var(--paper);
    stroke: var(--ink);
  }
  /* red is a revision, as on any drawing */
  .cloud,
  .rev {
    stroke: var(--signal);
    stroke-width: 1.4;
  }
  .rev {
    fill: var(--paper);
  }
  .rev-letter {
    fill: var(--signal-text);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }
  .mono.quiet {
    fill: var(--ink-quiet);
  }
  /* drawn smaller as small multiples, the lettering is set larger in drawing
     units so it still reads at about the size of the page's labels */
  @media (max-width: 899px) {
    .state .mono {
      font-size: 17px;
    }
  }

  /* ---- interactive: the loop is the control; one state shows at a time ---- */
  .cycle.interactive {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .interactive .loop {
    display: block;
    position: relative;
    width: 260px;
    aspect-ratio: 1;
  }
  .loop-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-path {
    fill: none;
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .loop-head,
  .loop-inner-head {
    fill: var(--ink);
  }
  .loop-inner {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.2;
  }
  .loop-inner-head {
    fill: var(--signal);
  }
  .balloon {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink-quiet);
    font: inherit;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(26, 26, 26, 0.6);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .balloon .name {
    position: absolute;
    top: 50%;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    transition: color 0.3s var(--ease);
  }
  .balloon .anchor-start {
    left: calc(100% + 0.6rem);
  }
  .balloon .anchor-end {
    right: calc(100% + 0.6rem);
  }
  .balloon .anchor-middle {
    left: 50%;
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
  }
  .balloon[aria-pressed="true"] .dot {
    background: var(--ink);
    color: var(--paper);
  }
  .balloon[aria-pressed="true"] .name,
  .balloon:hover .name {
    color: var(--ink);
  }
  .balloon:focus-visible {
    outline: none;
  }
  .balloon:focus-visible .dot {
    outline: 1.5px solid var(--ink);
    outline-offset: 3px;
  }

  .interactive .states {
    display: grid;
    gap: 0;
  }
  .interactive .state {
    grid-area: 1 / 1;
    transition: opacity 0.35s var(--ease);
  }
  .interactive .state[data-active="false"] {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive .state,
    .dot,
    .balloon .name {
      transition: none;
    }
  }
</style>
