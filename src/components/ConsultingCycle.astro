---
// How TAL consults: one value stream, followed through the cycle in pencil,
// by the people who do the work. Every map drawn in these scenes follows one
// rule: a pale step is done by hand, a dark step runs on its own. The reader
// sees the balance hold through Declare, however much the map is argued over,
// and turn in Refactor.
//
// Each stage is one step of a demonstration the reader completes: a premise
// they can check against their own organization, what the stage does and
// what it earns, and the question their own reasoning asks next, set as the
// way on. The last question becomes the conversation.
//
// One DOM serves every reader. Without script the stages read in order as
// small multiples. With script the loop is the control at every width: beside
// the stage on wide screens, pinned above it on a phone, where a swipe also
// turns the stage.
import { Picture } from "astro:assets";
import see from "../assets/consulting/see.jpg";
import declareMain from "../assets/consulting/declare-main.jpg";
import declare2 from "../assets/consulting/declare-2.jpg";
import declare3 from "../assets/consulting/declare-3.jpg";
import declare4 from "../assets/consulting/declare-4.jpg";
import declare5 from "../assets/consulting/declare-5.jpg";
import refactor from "../assets/consulting/refactor.jpg";
import proto1 from "../assets/consulting/proto-1.jpg";
import proto2 from "../assets/consulting/proto-2.jpg";
import proto3 from "../assets/consulting/proto-3.jpg";
import proto4 from "../assets/consulting/proto-4.jpg";
import scale from "../assets/consulting/scale.jpg";

const stages = [
  {
    id: "see",
    name: "See",
    premise:
      "Naming the work sounds simple until every department draws its edges differently.",
    move: "We hold the room to one question: what starts this work, and what does it owe the customer? Sometimes the answer takes thirty seconds. Sometimes it takes a month, and the month is the first finding.",
    next: "Whose version of it is true?",
    alt: "Four people around a small table as one of them draws the first line of a map.",
  },
  {
    id: "declare",
    name: "Declare",
    premise:
      "Ask five people how the work runs and hear five answers, each true from where they stand, and each defended.",
    move: "We map it from what actually happens, case by case. The workarounds and unspoken rules come out because no one is blamed for them. It is as much therapy as documentation.",
    next: "What should it become?",
    alt: "A team argues over a value stream map on the wall; over later sessions the map fills with notes and redrawn lines.",
  },
  {
    id: "refactor",
    name: "Refactor",
    premise: "Automating one step of a tangled stream only tangles it faster.",
    move: "Change one step and every step around it moves: handoffs, approvals, who decides. We redesign the stream whole, give each step to a person, software, or an agent, and show every role what changes before anything is built.",
    next: "Will it hold in operation?",
    alt: "A clean new map, most of its steps now dark, pinned alone on a sunlit wall.",
  },
  {
    id: "prototype",
    name: "Prototype",
    premise:
      "The first live runs fail. Most organizations read that as a verdict.",
    move: "We read it as signal. We build fast, run it live with the people who will own it, change what broke, and run it again until it is green. Nothing scales before then.",
    next: "What does it deliver at full load?",
    alt: "Engineers and business people building together, revising, laughing at a failed run, and watching it work.",
  },
  {
    id: "scale",
    name: "Scale",
    premise:
      "A pilot can succeed for a year without a single customer noticing.",
    move: "We move every case onto the new stream, keep the old one only until the new one carries the load, then retire it. The measure is what the customer gets.",
    next: "Start with one stream",
    alt: "The working floor of a healthy company: people settling things on the spot, deciding standing up, teaching one another; technology small and far back.",
  },
] as const;
const inquiry = `mailto:contact@talco.dev?subject=${encodeURIComponent("One stream")}`;
const f = (n: number) => n.toFixed(1);

// ---- the loop control ----------------------------------------------------
// five balloons on a circle, clockwise from the top; prototype carries its
// own small loop, because it turns until it holds
const R = 92;
const C = 120;
const loop = stages.map((s, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return {
    ...s,
    x: C + R * Math.cos(a),
    y: C + R * Math.sin(a),
    // label sits outside the circle
    lx: C + (R + 30) * Math.cos(a),
    ly: C + (R + 30) * Math.sin(a),
    anchor: Math.cos(a) > 0.2 ? "start" : Math.cos(a) < -0.2 ? "end" : "middle",
  };
});
const innerR = 14;
const innerC = {
  x: C + (R - 34) * Math.cos((-90 + 3 * 72) * (Math.PI / 180)),
  y: C + (R - 34) * Math.sin((-90 + 3 * 72) * (Math.PI / 180)),
};
// the arrowhead that closes the loop, just before SEE
const closeA = (-90 - 14) * (Math.PI / 180);
const close = { x: C + R * Math.cos(closeA), y: C + R * Math.sin(closeA) };
---

<div class="cycle" data-cycle>
  <div class="loop-band">
    <div class="loop">
      <svg class="loop-art" viewBox="0 0 240 240" aria-hidden="true">
        <circle class="loop-path" cx={C} cy={C} r={R}></circle>
        <path
          class="loop-head"
          d={`M ${f(close.x)} ${f(close.y)} l 7 -4 l -1 8 z`}
          transform={`rotate(-14 ${f(close.x)} ${f(close.y)})`}></path>
        <circle class="loop-inner" cx={f(innerC.x)} cy={f(innerC.y)} r={innerR}
        ></circle>
        <path
          class="loop-inner-head"
          d={`M ${f(innerC.x + innerR)} ${f(innerC.y)} l -4 -6 l 8 0 z`}></path>
      </svg>
      <div class="balloons" role="group" aria-label="Stages of the cycle">
        {
          loop.map((s, i) => (
            <button
              type="button"
              class="balloon"
              data-stage={s.id}
              aria-pressed={i === 0 ? "true" : "false"}
              style={`--x: ${f((s.x / 240) * 100)}%; --y: ${f((s.y / 240) * 100)}%; --lx: ${f((s.lx / 240) * 100)}%; --ly: ${f((s.ly / 240) * 100)}%`}
            >
              <span class="dot" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class:list={["name", `anchor-${s.anchor}`]}>{s.name}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="states" data-states>
    {
      stages.map((s, i) => (
        <figure
          class:list={["state", `state-${s.id}`]}
          data-state={s.id}
          data-active={i === 0 ? "true" : "false"}
        >
          <div class="exhibit" role="img" aria-label={s.alt}>
            {s.id === "see" && (
              <Picture
                src={see}
                alt=""
                widths={[480, 960]}
                sizes="(max-width: 899px) 100vw, 30rem"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            )}
            {s.id === "declare" && (
              <>
                <Picture
                  class="lead"
                  src={declareMain}
                  alt=""
                  widths={[540, 1080]}
                  sizes="(max-width: 899px) 100vw, 34rem"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
                <div class="sessions">
                  {[declare2, declare3, declare4, declare5].map((img) => (
                    <Picture
                      src={img}
                      alt=""
                      widths={[200, 400]}
                      sizes="(max-width: 899px) 50vw, 8rem"
                      formats={["avif", "webp"]}
                      loading="lazy"
                    />
                  ))}
                </div>
              </>
            )}
            {s.id === "refactor" && (
              <Picture
                src={refactor}
                alt=""
                widths={[640, 1280]}
                sizes="(max-width: 899px) 100vw, 40rem"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            )}
            {s.id === "prototype" && (
              <div class="montage">
                {[proto1, proto2, proto3, proto4].map((img) => (
                  <Picture
                    src={img}
                    alt=""
                    widths={[200, 400]}
                    sizes="(max-width: 899px) 50vw, 11rem"
                    formats={["avif", "webp"]}
                    loading="lazy"
                  />
                ))}
              </div>
            )}
            {s.id === "scale" && (
              <Picture
                src={scale}
                alt=""
                widths={[720, 1440]}
                sizes="(max-width: 899px) 100vw, 60rem"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            )}
          </div>
          <figcaption>
            <span class="mono-label">
              {String(i + 1).padStart(2, "0")} · {s.name}
            </span>
            <span class="premise">{s.premise}</span>
            <span class="move">{s.move}</span>
            {i < stages.length - 1 ? (
              <button
                type="button"
                class="next go"
                data-next={stages[i + 1].id}
              >
                {s.next}
                <svg
                  viewBox="0 0 12 12"
                  width="0.62em"
                  height="0.62em"
                  aria-hidden="true"
                >
                  <path
                    d="M2 6h8M6.5 2.5 10 6l-3.5 3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            ) : (
              <a class="next go start" href={inquiry}>
                {s.next}
                <svg
                  viewBox="0 0 12 12"
                  width="0.62em"
                  height="0.62em"
                  aria-hidden="true"
                >
                  <path
                    d="M3 9 9 3M4.5 3H9v4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script is:inline>
  // the loop is the control. a stage is chosen from the loop (click, tap, or
  // arrow keys), by its own next question, or on a phone by a swipe; it
  // changes in place and enters from the side it was reached from. hover
  // previews a stage only where there is a pointer to hover with.
  (() => {
    const root = document.querySelector("[data-cycle]");
    if (!root) return;
    const hover = matchMedia("(hover: hover)");
    const narrow = matchMedia("(max-width: 899px)");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const buttons = [...root.querySelectorAll("[data-stage]")];
    const states = [...root.querySelectorAll("[data-state]")];
    const order = buttons.map((b) => b.dataset.stage);
    let selected = order[0];
    const visited = new Set();
    const show = (id) =>
      states.forEach(
        (s) => (s.dataset.active = String(s.dataset.state === id)),
      );
    const enter = (id, dir) => {
      if (!dir || still.matches) return;
      root.querySelector(`[data-state="${id}"]`)?.animate(
        [
          { opacity: 0, transform: `translateX(${dir * 24}px)` },
          { opacity: 1, transform: "none" },
        ],
        { duration: 380, easing: "cubic-bezier(0.2, 0.6, 0.2, 1)" },
      );
    };
    // the next stage is drawn in full ink: the way on
    const select = (id) => {
      const dir = Math.sign(order.indexOf(id) - order.indexOf(selected));
      selected = id;
      visited.add(id);
      const next = order[order.indexOf(id) + 1];
      buttons.forEach((b) => {
        const stage = b.dataset.stage;
        b.setAttribute("aria-pressed", String(stage === id));
        b.dataset.visited = String(visited.has(stage) && stage !== id);
        b.dataset.next = String(stage === next);
      });
      show(id);
      enter(id, dir);
    };
    // on a phone the loop is pinned above the stage; a new stage is brought
    // back up under it, so it is read from its top
    const settle = () => {
      if (!narrow.matches) return;
      const bar = document.querySelector(".bar")?.offsetHeight ?? 0;
      const top = root.getBoundingClientRect().top - bar;
      if (top < 0)
        scrollBy({ top, behavior: still.matches ? "auto" : "smooth" });
    };
    const step = (delta) => {
      const id = order[order.indexOf(selected) + delta];
      if (!id) return false;
      select(id);
      settle();
      return true;
    };
    root.querySelectorAll("[data-next]").forEach((n) =>
      n.addEventListener("click", () => {
        select(n.dataset.next);
        settle();
        root
          .querySelector(`[data-stage="${n.dataset.next}"]`)
          ?.focus({ preventScroll: true });
      }),
    );
    buttons.forEach((b) => {
      b.addEventListener("click", () => select(b.dataset.stage));
      b.addEventListener("mouseenter", () => {
        if (hover.matches) show(b.dataset.stage);
      });
      b.addEventListener("mouseleave", () => {
        if (hover.matches) show(selected);
      });
      b.addEventListener("focus", () => {
        if (b.dataset.stage !== selected) select(b.dataset.stage);
      });
      b.addEventListener("keydown", (e) => {
        const delta = {
          ArrowRight: 1,
          ArrowDown: 1,
          ArrowLeft: -1,
          ArrowUp: -1,
        }[e.key];
        if (!delta) return;
        e.preventDefault();
        if (step(delta))
          root
            .querySelector(`[data-stage="${selected}"]`)
            ?.focus({ preventScroll: true });
      });
    });
    // a sideways swipe across the stage turns it; a vertical one scrolls
    const field = root.querySelector("[data-states]");
    let from = null;
    field.addEventListener(
      "touchstart",
      (e) => (from = { x: e.touches[0].clientX, y: e.touches[0].clientY }),
      { passive: true },
    );
    field.addEventListener(
      "touchend",
      (e) => {
        if (!from) return;
        const dx = e.changedTouches[0].clientX - from.x;
        const dy = e.changedTouches[0].clientY - from.y;
        from = null;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5)
          step(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );
    root.classList.add("interactive");
    select(selected);
  })();
</script>

<style>
  /* ---- small multiples: the default for every reader ---- */
  .states {
    display: grid;
    gap: 2.5rem;
  }
  figcaption {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.2rem;
  }
  /* the premise the reader checks against their own organization, then what
     the stage does about it */
  .premise {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.25;
    color: var(--ink);
    max-width: 30ch;
    text-wrap: balance;
  }
  .move {
    margin-top: 0.5rem;
    font-size: clamp(1.1rem, 1.45vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-light);
    max-width: 34rem;
  }
  /* the way on: the question the reader's own reasoning asks next */
  .next {
    justify-self: start;
    margin-top: 0.6rem;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* as small multiples every stage is visible at once, so only the last
     question, the conversation, is a way on */
  .state button.next {
    display: none;
  }
  .interactive .state button.next {
    display: inline-flex;
  }

  /* ---- the exhibits: pencil scenes, set into the sheet ---- */
  .exhibit :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* each scene dissolves into the sheet at its edges, so it reads as drawn
       on the page rather than placed on it */
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
  }
  .state-declare .exhibit {
    display: grid;
    gap: 0.4rem;
  }
  .sessions,
  .montage {
    display: grid;
    gap: 0.4rem;
  }
  .sessions {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .montage {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* ---- interactive: the loop is the control; one state shows at a time ---- */
  .loop-band {
    display: none;
  }
  .interactive .loop-band {
    display: block;
  }
  .interactive .loop {
    position: relative;
    aspect-ratio: 1;
  }
  .loop-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-path {
    fill: none;
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .loop-head,
  .loop-inner-head {
    fill: var(--ink);
  }
  .loop-inner {
    fill: none;
    stroke: rgba(26, 26, 26, 0.6);
    stroke-width: 1;
  }
  .balloon {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink-quiet);
    font: inherit;
  }
  .dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(26, 26, 26, 0.6);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .balloon .name {
    position: absolute;
    top: 50%;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    transition: color 0.3s var(--ease);
  }
  .balloon .anchor-start {
    left: calc(100% + 0.6rem);
  }
  .balloon .anchor-end {
    right: calc(100% + 0.6rem);
  }
  .balloon .anchor-middle {
    left: 50%;
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
  }
  .balloon:hover .dot {
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(26, 26, 26, 0.06);
  }
  .balloon[data-visited="true"] .dot {
    border-color: var(--ink);
  }
  /* the next stage is drawn in full ink: the way on */
  .balloon[data-next="true"] .dot {
    border-color: var(--ink);
    border-width: 1.5px;
  }
  .balloon[data-next="true"] .name {
    color: var(--ink);
  }
  .balloon[aria-pressed="true"] .dot {
    background: var(--ink);
    color: var(--paper);
  }
  .balloon[aria-pressed="true"] .name,
  .balloon:hover .name {
    color: var(--ink);
  }
  .balloon:focus-visible {
    outline: none;
  }
  .balloon:focus-visible .dot {
    outline: 1.5px solid var(--ink);
    outline-offset: 3px;
  }

  .interactive .states {
    display: grid;
    gap: 0;
  }
  .interactive .state {
    grid-area: 1 / 1;
    transition: opacity 0.35s var(--ease);
  }
  .interactive .state[data-active="false"] {
    opacity: 0;
    visibility: hidden;
  }

  /* wide: the loop beside the stage. the whole step reads on one screen:
     every scene stands one height, as tall as the screen allows */
  @media (min-width: 900px) {
    .interactive {
      --scene: clamp(17rem, 100svh - 33rem, 21.5rem);
    }
    .cycle.interactive {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      column-gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }
    .interactive .loop {
      width: 260px;
    }
    .interactive .state-see .exhibit,
    .interactive .state-declare .exhibit {
      max-width: calc(var(--scene) * 4 / 3);
    }
    .interactive .state-refactor .exhibit {
      max-width: calc(var(--scene) * 16 / 9);
    }
    .interactive .state-prototype .exhibit {
      max-width: var(--scene);
    }
    /* scale opens out: the one scene with no map in it runs past the text
       column toward the sheet's edge, onto the working floor */
    .interactive .state-scale .exhibit {
      margin-right: calc(var(--gutter) * -0.5);
    }
    .interactive .state-scale .exhibit :global(img) {
      aspect-ratio: 2.75;
      object-fit: cover;
      object-position: 50% 55%;
    }
  }

  /* phone: the loop is pinned above the stage as one strip, and the whole
     step (loop, scene, premise, move, way on) reads on one screen. each scene
     is held to one height so the stages do not jump */
  @media (max-width: 899px) {
    .interactive {
      --scene: min(25svh, 15rem);
    }
    .interactive .loop-band {
      position: sticky;
      top: var(--bar);
      z-index: 2;
      /* the strip spans the sheet inside its frame; content scrolling under
         it fades out rather than being cut */
      margin-inline: calc(var(--gutter) * -0.5 - 0.5rem + 1px);
      padding: 1.5rem 0 0.75rem;
      background: linear-gradient(
        to bottom,
        rgb(238, 227, 208) 84%,
        rgba(238, 227, 208, 0)
      );
    }
    .interactive .loop {
      width: min(156px, 20svh);
      margin: 0 auto;
    }
    .interactive .dot {
      width: 30px;
      height: 30px;
      font-size: 0.62rem;
    }
    /* a fingertip's reach around each balloon */
    .interactive .balloon::before {
      content: "";
      position: absolute;
      inset: -7px;
      border-radius: 50%;
    }
    .interactive .balloon .name {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }
    .interactive .balloon .anchor-start {
      left: calc(100% + 0.45rem);
    }
    .interactive .balloon .anchor-end {
      right: calc(100% + 0.45rem);
    }
    .interactive .balloon .anchor-middle {
      bottom: calc(100% + 0.35rem);
    }
    /* a sideways swipe belongs to the stage, never to the browser's back
       gesture; vertical scrolling and pinch zoom stay the browser's */
    .interactive .states {
      margin-top: 0.25rem;
      touch-action: pan-y pinch-zoom;
      overscroll-behavior-x: contain;
    }
    .interactive .exhibit {
      margin-inline: auto;
    }
    .interactive .state-see .exhibit,
    .interactive .state-declare .exhibit {
      max-width: calc(var(--scene) * 4 / 3);
    }
    .interactive .state-refactor .exhibit {
      max-width: calc(var(--scene) * 16 / 9);
    }
    .interactive .state-prototype .exhibit {
      max-width: var(--scene);
    }
    /* scale opens out to the frame */
    .interactive .state-scale .exhibit {
      margin-inline: calc(var(--gutter) * -0.5 - 0.5rem + 1px);
    }
    .interactive .state-scale .exhibit :global(img) {
      aspect-ratio: 1.9;
      object-fit: cover;
      object-position: 50% 55%;
    }
    .interactive .premise {
      font-size: 1.25rem;
    }
    .interactive .move {
      font-size: 1.06rem;
    }
    /* the way on, tall enough to tap */
