---
// One sheet of the set: a field framed by a drafting border whose corners
// overshoot, the sheet's number and name at the head, and a title block at the
// foot. The frame is drafted in as the sheet comes into view.
interface Props {
  id: string;
  // the cover carries no number
  number?: string;
  label: string;
  titleBlock: string;
  // a compact sheet sizes to its content instead of filling the screen
  compact?: boolean;
}

const { id, number, label, titleBlock, compact = false } = Astro.props;
---

<section class:list={["drawing", { compact }]} id={id} aria-label={label}>
  <div class="frame" aria-hidden="true">
    <span class="over tl"></span>
    <span class="over tr"></span>
    <span class="over bl"></span>
    <span class="over br"></span>
  </div>
  <p class="head mono-label">
    {number && <span class="no">{number}</span>}
    <span class="name">{label}</span>
  </p>
  <div class="field"><slot /></div>
  <p class="block mono-label">TAL Company · {titleBlock}</p>
</section>

<style>
  .drawing {
    position: relative;
    /* a sheet fills the screen beneath the bar */
    min-height: calc(100svh - var(--bar));
    /* clear of the frame and the labels drawn on its margin */
    padding: calc(var(--gutter) * 0.5 + 2.6rem) calc(var(--gutter) + 1.5rem);
    display: grid;
    /* the track is the sheet's width, never its widest content's */
    grid-template-columns: minmax(0, 1fr);
    /* a sheet ends at its edge: construction lines may run into the margin,
       never off the paper */
    overflow-x: clip;
    scroll-snap-align: start;
  }

  .drawing.compact {
    min-height: 0;
    padding-top: calc(var(--gutter) * 0.5 + 4.5rem);
    padding-bottom: calc(var(--gutter) * 0.5 + 4.5rem);
  }

  /* the drafting border, inset from the paper's edge. drawn: its clip
     reaches past the corners so the overshoots show */
  .frame {
    position: absolute;
    inset: calc(var(--gutter) * 0.5);
    border: 1px solid var(--line);
    pointer-events: none;
    clip-path: inset(-16px);
    transition: clip-path 1.6s var(--ease);
  }
  /* each corner closed the way a draughtsman closes it: both lines run on
     past the meeting point */
  .over {
    position: absolute;
  }
  .over::before,
  .over::after {
    content: "";
    position: absolute;
    background: var(--line);
  }
  .over::before {
    width: 14px;
    height: 1px;
  }
  .over::after {
    width: 1px;
    height: 14px;
  }
  .tl {
    top: -1px;
    left: -1px;
  }
  .tl::before {
    right: 0;
  }
  .tl::after {
    bottom: 0;
  }
  .tr {
    top: -1px;
    right: -1px;
  }
  .tr::before {
    left: 0;
  }
  .tr::after {
    bottom: 0;
  }
  .bl {
    bottom: -1px;
    left: -1px;
  }
  .bl::before {
    right: 0;
  }
  .bl::after {
    top: 0;
  }
  .br {
    bottom: -1px;
    right: -1px;
  }
  .br::before {
    left: 0;
  }
  .br::after {
    top: 0;
  }

  /* drafted in: the border runs out from the top-left corner */
  :global(.drafting) .drawing:not(.drawn) .frame {
    clip-path: inset(-16px 100% 100% -16px);
  }

  /* the sheet number and the title block sit on the frame's margin, as on
     a drawing, so the field keeps the whole sheet */
  .head,
  .block {
    position: absolute;
    left: calc(var(--gutter) * 0.5 + 1.25rem);
    right: calc(var(--gutter) * 0.5 + 1.25rem);
  }
  .head {
    top: calc(var(--gutter) * 0.5 + 1rem);
    display: flex;
    gap: 1.25rem;
  }
  .no {
    color: var(--ink);
  }

  .field {
    min-width: 0;
    width: 100%;
    max-width: var(--sheet-max);
    margin: 0 auto;
    align-self: center;
  }

  .block {
    bottom: calc(var(--gutter) * 0.5 + 1rem);
    text-align: right;
  }

  @media (max-width: 700px) {
    .drawing {
      padding: calc(var(--gutter) * 0.5 + 4rem) calc(var(--gutter) + 0.5rem);
    }
    .head {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
