---
interface Props {
  id: string;
  label: string;
  // the title page holds the full screen; every other sheet is as tall as
  // its composition needs
  full?: boolean;
}

const { id, label, full = false } = Astro.props;
---

<section class:list={["drawing", { full }]} id={id} aria-label={label}>
  <div class="trim" aria-hidden="true">
    <span class="over tl"></span>
    <span class="over tr"></span>
    <span class="over bl"></span>
    <span class="over br"></span>
  </div>
  <div class="field"><slot /></div>
</section>

<style>
  /* a sheet: the trim line at the paper's edge, the border drawn inside it,
     and between them the zone strip, ticked at the grid every field on the
     sheet is ruled to */
  .drawing {
    position: relative;
    padding: calc(var(--trim) + var(--zone));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    max-width: var(--sheet-max);
    margin-inline: auto;
    overflow-x: clip;
    scroll-snap-align: start;
  }
  /* the title page holds the first screen at a desk, never more than its
     composition can fill; on a phone it is as tall as its composition */
  @media (min-width: 901px) {
    .drawing.full {
      min-height: min(calc(100svh - var(--bar)), 52rem);
    }
  }
  /* sheets in a set share their trim edge; the corners cross where they meet */
  .drawing + :global(.drawing) {
    margin-top: calc(var(--trim) * -2);
  }

  .trim {
    position: absolute;
    inset: var(--trim);
    border: 1px solid var(--line);
    pointer-events: none;
    clip-path: inset(-16px);
    transition: clip-path 1.6s var(--ease);
  }
  /* each corner closed the way a draughtsman closes it: both lines run on
     past the meeting point */
  .over {
    position: absolute;
  }
  .over::before,
  .over::after {
    content: "";
    position: absolute;
    background: var(--line);
  }
  .over::before {
    width: 14px;
    height: 1px;
  }
  .over::after {
    width: 1px;
    height: 14px;
  }
  .tl {
    top: -1px;
    left: -1px;
  }
  .tl::before {
    right: 0;
  }
  .tl::after {
    bottom: 0;
  }
  .tr {
    top: -1px;
    right: -1px;
  }
  .tr::before {
    left: 0;
  }
  .tr::after {
    bottom: 0;
  }
  .bl {
    bottom: -1px;
    left: -1px;
  }
  .bl::before {
    right: 0;
  }
  .bl::after {
    top: 0;
  }
  .br {
    bottom: -1px;
    right: -1px;
  }
  .br::before {
    left: 0;
  }
  .br::after {
    top: 0;
  }

  .field {
    position: relative;
    min-width: 0;
    display: grid;
  }
  /* the border, in the mark's own weight */
  .field::after {
    content: "";
    position: absolute;
    inset: calc(var(--border) * -1);
    border: var(--border) solid var(--ink);
    pointer-events: none;
    clip-path: inset(0);
    transition: clip-path 1.6s var(--ease);
  }
  /* the zone ticks: one at every column line of the sheet's grid, above and
     below */
  .field::before {
    content: "";
    position: absolute;
    left: calc(100% / var(--cols));
    right: 0;
    top: calc(var(--zone) * -1 - var(--border));
    bottom: calc(var(--zone) * -1 - var(--border));
    pointer-events: none;
    background:
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 /
        calc(100% / (var(--cols) - 1)) var(--zone) repeat-x,
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 100% /
        calc(100% / (var(--cols) - 1)) var(--zone) repeat-x;
    transition: opacity 1.2s var(--ease) 0.5s;
  }

  /* drafted in: trim and border run out from the top-left corner, then the
     ticks are set */
  :global(.drafting) .drawing:not(.drawn) .trim {
    clip-path: inset(-16px 100% 100% -16px);
  }
  :global(.drafting) .drawing:not(.drawn) .field::after {
    clip-path: inset(0 100% 100% 0);
  }
  :global(.drafting) .drawing:not(.drawn) .field::before {
    opacity: 0;
  }
</style>
