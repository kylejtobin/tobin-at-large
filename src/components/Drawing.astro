---
// One sheet of the set: a field framed by a drafting border whose corners
// overshoot, and the sheet's number at its head. The frame is drafted in as the sheet comes into view.
interface Props {
  id: string;
  // the cover carries no number
  number?: string;
  label: string;
  // the title page holds the full screen; every other sheet is as tall as
  // its composition needs
  full?: boolean;
}

const { id, number, label, full = false } = Astro.props;
---

<section class:list={["drawing", { full }]} id={id} aria-label={label}>
  <div class="frame" aria-hidden="true">
    <span class="over tl"></span>
    <span class="over tr"></span>
    <span class="over bl"></span>
    <span class="over br"></span>
  </div>
  {
    number && (
      <p class="head mono-label">
        <span class="no">{number}</span>
      </p>
    )
  }
  <div class="field"><slot /></div>
</section>

<style>
  .drawing {
    position: relative;
    /* clear of the frame and the labels drawn on its margin; the sheet is as
       tall as its composition */
    padding: calc(var(--gutter) * 0.5 + 3rem) calc(var(--gutter) + 1.5rem);
    display: grid;
    /* the track is the sheet's width, never its widest content's */
    grid-template-columns: minmax(0, 1fr);
    /* a sheet ends at its edge: construction lines may run into the margin,
       never off the paper */
    overflow-x: clip;
    scroll-snap-align: start;
  }

  /* the title page holds the first screen */
  .drawing.full {
    min-height: calc(100svh - var(--bar));
  }
  /* sheets in a run share their edges, like pages in a set */
  .drawing + :global(.drawing) {
    margin-top: calc(var(--gutter) * -0.5);
  }

  /* the drafting border, inset from the paper's edge. drawn: its clip
     reaches past the corners so the overshoots show */
  .frame {
    position: absolute;
    inset: calc(var(--gutter) * 0.5);
    border: 1px solid var(--line);
    pointer-events: none;
    clip-path: inset(-16px);
    transition: clip-path 1.6s var(--ease);
  }
  /* each corner closed the way a draughtsman closes it: both lines run on
     past the meeting point */
  .over {
    position: absolute;
  }
  .over::before,
  .over::after {
    content: "";
    position: absolute;
    background: var(--line);
  }
  .over::before {
    width: 14px;
    height: 1px;
  }
  .over::after {
    width: 1px;
    height: 14px;
  }
  .tl {
    top: -1px;
    left: -1px;
  }
  .tl::before {
    right: 0;
  }
  .tl::after {
    bottom: 0;
  }
  .tr {
    top: -1px;
    right: -1px;
  }
  .tr::before {
    left: 0;
  }
  .tr::after {
    bottom: 0;
  }
  .bl {
    bottom: -1px;
    left: -1px;
  }
  .bl::before {
    right: 0;
  }
  .bl::after {
    top: 0;
  }
  .br {
    bottom: -1px;
    right: -1px;
  }
  .br::before {
    left: 0;
  }
  .br::after {
    top: 0;
  }

  /* drafted in: the border runs out from the top-left corner */
  :global(.drafting) .drawing:not(.drawn) .frame {
    clip-path: inset(-16px 100% 100% -16px);
  }

  /* the sheet number sits on the frame's margin, as on a drawing, so the
     field keeps the whole sheet */
  .head {
    position: absolute;
    left: calc(var(--gutter) * 0.5 + 1.25rem);
    right: calc(var(--gutter) * 0.5 + 1.25rem);
  }
  .head {
    top: calc(var(--gutter) * 0.5 + 1rem);
    display: flex;
    gap: 1.25rem;
  }
  .no {
    color: var(--ink);
  }

  .field {
    min-width: 0;
    width: 100%;
    max-width: var(--sheet-max);
    margin: 0 auto;
    align-self: center;
  }

  @media (max-width: 700px) {
    .drawing {
      padding: calc(var(--gutter) * 0.5 + 4rem) calc(var(--gutter) + 0.5rem);
    }
  }
</style>
