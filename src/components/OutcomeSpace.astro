---
// The outcome space: the one drawing the method evolves and the ideas are
// taught on, in the cover's hand. Everything inside the frame that is not
// an outcome is void, hatched. An outcome is a box on paper; what it
// exists only with is drawn as ticks on its top edge, each labelled. The
// refund's third tick, the limit, is extended down through the box, and
// the ground beyond it is void. Cases are numbered balloons that land in
// an outcome; one that lands on hatching has nowhere to be, and is red.
//
// The stream runs along the top as construction: the three stations of the
// returns desk's work, with the waiting case as a red dot at Finance in
// See, and the line solid end to end in Scale.
//
// The drawing has states, chosen by `data-stage` on its root: every element
// carries the stages it belongs to in `data-s`, and the stylesheet shows the
// ones that match.
interface Props {
  stage:
    | "see"
    | "declare"
    | "refactor"
    | "prototype"
    | "scale"
    | "cases"
    | "limit";
  id?: string;
}
const { stage, id } = Astro.props;

// ---- geometry ------------------------------------------------------------
const frame = { x: 24, y: 40, w: 472, h: 252 };
const refund = { x: 24, y: 56, w: 280, h: 140 };
const limitX = 214;
const credit = { x: 322, y: 56, w: 174, h: 60 };
const replacement = { x: 322, y: 134, w: 174, h: 62 };
const waived = { x: 24, y: 214, w: 280, h: 60 };
// the stream's stations along the top
const stations = [
  { name: "Returns", x: 110 },
  { name: "Finance", x: 260 },
  { name: "Warehouse", x: 410 },
];
const streamY = 26;
// what each outcome exists only with: ticks on its top edge
type Tick = { x: number; label: string };
const ticks: { box: { x: number; y: number }; at: Tick[] }[] = [
  {
    box: refund,
    at: [
      { x: 50, label: "paid order" },
      { x: 118, label: "reason" },
      { x: limitX, label: "under the limit" },
    ],
  },
  {
    box: credit,
    at: [
      { x: 352, label: "paid order" },
      { x: 430, label: "reason" },
    ],
  },
  { box: replacement, at: [{ x: 352, label: "proven stock" }] },
  {
    box: waived,
    at: [
      { x: 60, label: "the fee" },
      { x: 150, label: "years paying" },
    ],
  },
];
---

<svg
  class="space"
  viewBox="0 0 520 340"
  data-stage={stage}
  id={id}
  role="img"
  aria-label="The outcomes a case can land in, each with what it exists only with drawn as ticks on its edge; the limit inside the refund; hatched void where no outcome exists; and the cases of the month landing"
>
  <defs>
    <pattern
      id="void-hatch"
      width="7"
      height="7"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(-45)"
    >
      <line x1="0" y1="0" x2="0" y2="7" class="hatch-line"></line>
    </pattern>
  </defs>

  <!-- the stream along the top: stations as construction, the line in See
       and Scale -->
  <g class="stream-line">
    {
      stations.map((s) => (
        <>
          <text class="station" x={s.x} y={streamY - 10} text-anchor="middle">
            {s.name}
          </text>
          <line
            class="station-tick"
            x1={s.x}
            x2={s.x}
            y1={streamY - 4}
            y2={streamY + 4}
          />
        </>
      ))
    }
    <line
      class="run"
      data-s="see"
      x1={frame.x}
      x2={stations[1].x}
      y1={streamY}
      y2={streamY}></line>
    <line
      class="run waits"
      data-s="see"
      x1={stations[1].x}
      x2={frame.x + frame.w}
      y1={streamY}
      y2={streamY}></line>
    <circle class="wait" data-s="see" cx={stations[1].x} cy={streamY} r="5"
    ></circle>
    <line
      class="run"
      data-s="scale"
      x1={frame.x}
      x2={frame.x + frame.w}
      y1={streamY}
      y2={streamY}></line>
  </g>

  <!-- the ground: void, everywhere an outcome is not -->
  <rect
    class="void"
    data-s="refactor prototype scale cases limit"
    x={frame.x}
    y={frame.y}
    width={frame.w}
    height={frame.h}></rect>
  <line
    class="centre"
    data-s="declare refactor prototype scale cases limit"
    x1={frame.x - 20}
    x2={frame.x + frame.w + 20}
    y1={refund.y + refund.h + 4}
    y2={refund.y + refund.h + 4}></line>
  <line
    class="centre"
    data-s="declare refactor prototype scale cases limit"
    x1={refund.x + refund.w + 9}
    x2={refund.x + refund.w + 9}
    y1={frame.y - 4}
    y2={frame.y + frame.h + 4}></line>

  <!-- the outcomes: dashed on paper while they are only what the desk said,
       solid once they have their edges -->
  <g class="boxes">
    {
      [
        { box: refund, name: "Refund", key: "refund" },
        { box: replacement, name: "Replacement", key: "replacement" },
        { box: waived, name: "Fee waived", key: "waived" },
      ].map(({ box, name, key }) => (
        <>
          <rect
            class="box said"
            data-s="declare"
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            stroke-dasharray="3 5"
          />
          <rect
            class="box"
            data-s="refactor prototype scale cases limit"
            data-region={key}
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
          />
          <text
            class="name"
            data-s="declare refactor prototype scale cases limit"
            x={box.x + 12}
            y={box.y + 21}
          >
            {name}
          </text>
        </>
      ))
    }
    <!-- credit exists only after a manager adds it -->
    <rect
      class="box"
      data-s="scale cases limit"
      data-region="credit"
      x={credit.x}
      y={credit.y}
      width={credit.w}
      height={credit.h}></rect>
    <text
      class="name"
      data-s="scale cases limit"
      x={credit.x + 12}
      y={credit.y + 21}>Credit</text
    >
  </g>

  <!-- the desk's words, before they are edges -->
  <g class="words" data-s="declare">
    <text class="said-text" x={refund.x + 12} y={refund.y + 46}
      >“Order’s paid, customer’s waiting,</text
    >
    <text class="said-text" x={refund.x + 12} y={refund.y + 62}
      >it’s under what I’d sign.”</text
    >
    <text class="said-text" x={replacement.x + 12} y={replacement.y + 40}
      >“Invoice isn’t due.</text
    >
    <text class="said-text" x={replacement.x + 12} y={replacement.y + 54}
      >She still gets it.”</text
    >
    <text class="said-text" x={waived.x + 12} y={waived.y + 40}
      >“Three years with us. I’m not</text
    >
    <text class="said-text" x={waived.x + 12} y={waived.y + 54}
      >charging her forty dollars.”</text
    >
  </g>

  <!-- the edges: what each outcome exists only with, as ticks -->
  <g class="edges">
    {
      ticks.map(({ box, at }) =>
        at.map((t) => (
          <g
            data-s={
              box === credit
                ? "scale cases limit"
                : "refactor prototype scale cases limit"
            }
          >
            <line
              class="tick"
              x1={t.x}
              x2={t.x}
              y1={box.y - 5}
              y2={box.y + 5}
            />
            <text
              class="tick-label"
              x={t.x === limitX ? t.x + 4 : t.x}
              y={box.y - 9}
              text-anchor={t.x === limitX ? "start" : "middle"}
            >
              {t.label}
            </text>
          </g>
        )),
      )
    }
    <!-- the limit: the refund's third tick, extended; beyond it, void -->
    <g class="limit-group" data-s="refactor prototype scale cases limit">
      <rect
        class="void inner"
        data-void="over"
        x={limitX}
        y={refund.y + 1}
        width={refund.x + refund.w - limitX - 1}
        height={refund.h - 2}></rect>
      <line
        class="limit"
        x1={limitX}
        x2={limitX}
        y1={refund.y}
        y2={refund.y + refund.h}></line>
    </g>
  </g>

  <!-- the cases -->
  <g class="cases">
    <g
      class="case"
      data-s="prototype scale cases limit"
      data-case="01"
      data-region="refund"
    >
      <circle cx="170" cy="156" r="12" pathLength="100"></circle>
      <text x="170" y="156">01</text>
    </g>
    <g
      class="case"
      data-s="prototype scale cases limit"
      data-case="02"
      data-region="waived"
    >
      <circle cx="262" cy="252" r="12" pathLength="100"></circle>
      <text x="262" y="252">02</text>
    </g>
    <g
      class="case"
      data-s="prototype scale cases limit"
      data-case="03"
      data-region="replacement"
    >
      <circle cx="440" cy="178" r="12" pathLength="100"></circle>
      <text x="440" y="178">03</text>
    </g>
    <!-- the credit case: on void in the month's run, inside credit once it exists -->
    <g class="case onvoid" data-s="prototype" data-case="04v">
      <circle cx="409" cy="96" r="12" pathLength="100"></circle>
      <text x="409" y="96">04</text>
    </g>
    <g
      class="case"
      data-s="scale cases limit"
      data-case="04"
      data-region="credit"
    >
      <circle cx="440" cy="98" r="12" pathLength="100"></circle>
      <text x="440" y="98">04</text>
    </g>
    <!-- a refund of an unpaid invoice: nowhere to land -->
    <g class="case onvoid" data-s="cases" data-case="05">
      <circle cx="409" cy="244" r="12" pathLength="100"></circle>
      <text x="409" y="244">05</text>
    </g>
  </g>
</svg>

<style>
  .space {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .space :global(rect),
  .space :global(line) {
    vector-effect: non-scaling-stroke;
  }
  .space text {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  .hatch-line {
    stroke: rgba(26, 26, 26, 0.14);
    stroke-width: 1;
  }
  .centre {
    stroke: rgba(26, 26, 26, 0.26);
    stroke-width: 1;
    stroke-dasharray: 14 4 2 4;
  }
  /* the stream */
  .station {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    fill: var(--ink-quiet);
  }
  .station-tick {
    stroke: rgba(26, 26, 26, 0.3);
    stroke-width: 1;
  }
  .run {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .run.waits {
    stroke: rgba(26, 26, 26, 0.3);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .wait {
    fill: var(--signal);
  }
  /* void and outcomes */
  .void {
    fill: url(#void-hatch);
    stroke: none;
  }
  .box {
    fill: var(--paper);
    stroke: rgba(26, 26, 26, 0.72);
    stroke-width: 1;
  }
  .box.said {
    fill: none;
  }
  .name {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    fill: var(--ink);
  }
  .said-text {
    font-size: 10px;
    font-family: var(--font-body);
    font-style: italic;
    letter-spacing: 0;
    fill: var(--ink);
  }
  .tick {
    stroke: var(--ink);
    stroke-width: 1;
  }
  .tick-label {
    font-size: 8.5px;
    fill: var(--ink-quiet);
  }
  .limit {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  /* cases: a balloon's stroke draws in as it lands */
  .case circle {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.35s var(--ease) 0.1s;
  }
  .case text {
    font-size: 10px;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .case.onvoid circle {
    fill: var(--signal);
    stroke: var(--signal);
  }
  .case.onvoid text {
    fill: var(--paper);
  }
  /* a case the moved limit left on void */
  .case[data-lost="true"] circle {
    fill: none;
    stroke: var(--signal);
  }
  .case[data-lost="true"] text {
    fill: var(--signal-text);
  }

  /* ---- states ---- */
  [data-s] {
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }
  [data-stage="see"] [data-s~="see"],
  [data-stage="declare"] [data-s~="declare"],
  [data-stage="refactor"] [data-s~="refactor"],
  [data-stage="prototype"] [data-s~="prototype"],
  [data-stage="scale"] [data-s~="scale"],
  [data-stage="cases"] [data-s~="cases"],
  [data-stage="limit"] [data-s~="limit"] {
    opacity: 1;
  }
  [data-stage="prototype"] [data-s~="prototype"] circle,
  [data-stage="scale"] [data-s~="scale"] circle,
  [data-stage="limit"] [data-s~="limit"] circle {
    stroke-dashoffset: 0;
  }
  /* on the sheet that lands a case, the cases wait for the reader */
  [data-stage="cases"] .case {
    opacity: 0;
  }
  [data-stage="cases"] .case[data-shown="true"] {
    opacity: 1;
  }
  [data-stage="cases"] .case[data-shown="true"] circle {
    stroke-dashoffset: 0;
  }
  [data-stage="cases"] .box[data-lit="true"] {
    stroke: var(--ink);
    stroke-width: 2;
  }

  @media (max-width: 600px) {
    .name {
      font-size: 14px;
    }
    .station {
      font-size: 11px;
    }
    .tick-label {
      font-size: 9.5px;
    }
    .said-text {
      font-size: 11.5px;
    }
    .case text {
      font-size: 12.5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-s],
    .case circle {
      transition: none;
    }
  }
</style>
