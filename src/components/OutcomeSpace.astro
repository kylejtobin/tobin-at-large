---
// The outcome space: the one drawing the method evolves and the ideas are
// taught on, in the cover's hand. Everything inside the frame that is not
// an outcome is void, hatched. An outcome is a box on paper; what it
// exists only with is drawn as ticks on its top edge, each labelled. The
// refund's third tick, the limit, is extended down through the box, and
// the ground beyond it is void. Cases are numbered balloons that land in
// an outcome; one that lands on hatching has nowhere to be, and is red.
//
// The stream runs along the top as construction: the three stations of the
// returns desk's work, with the waiting case as a red dot at Finance in
// See, and the line solid end to end in Scale.
//
// The drawing has states, chosen by `data-stage` on its root: every element
// carries the stages it belongs to in `data-s`, and the stylesheet shows the
// ones that match.
interface Props {
  stage:
    | "see"
    | "declare"
    | "refactor"
    | "prototype"
    | "scale"
    | "cases"
    | "limit";
  id?: string;
}
const { stage, id } = Astro.props;

// ---- geometry ------------------------------------------------------------
const frame = { x: 24, y: 40, w: 472, h: 292 };
const refund = { x: 24, y: 56, w: 280, h: 156 };
const limitX = 214;
const credit = { x: 322, y: 104, w: 174, h: 48 };
const replacement = { x: 322, y: 180, w: 174, h: 56 };
const waived = { x: 24, y: 240, w: 280, h: 60 };
// the stream's stations along the top
const stations = [
  { name: "Returns", x: 110 },
  { name: "Finance", x: 260 },
  { name: "Warehouse", x: 410 },
];
const streamY = 26;
// the month's cases: where each lands, the station it comes from, and the
// stages it appears in. the travel is computed from these, so it can't drift
const cases = [
  {
    no: "01",
    x: 170,
    y: 156,
    from: 110,
    region: "refund",
    s: "prototype scale cases limit",
    cls: "",
  },
  {
    no: "02",
    x: 262,
    y: 276,
    from: 110,
    region: "waived",
    s: "prototype scale cases limit",
    cls: "",
  },
  {
    no: "03",
    x: 472,
    y: 222,
    from: 410,
    region: "replacement",
    s: "prototype scale cases limit",
    cls: "",
  },
  {
    no: "04",
    x: 462,
    y: 132,
    from: 260,
    region: "credit",
    s: "prototype scale cases limit",
    cls: "credit",
  },
  {
    no: "05",
    x: 150,
    y: 318,
    from: 110,
    region: "",
    s: "cases",
    cls: "onvoid",
  },
];
// what each outcome exists only with: ticks on its top edge
type Tick = { x: number; label: string };
const ticks: { box: { x: number; y: number }; at: Tick[] }[] = [
  {
    box: refund,
    at: [
      { x: 56, label: "paid order" },
      { x: 150, label: "reason" },
      { x: limitX, label: "the limit" },
    ],
  },
  {
    box: credit,
    at: [
      { x: 366, label: "paid order" },
      { x: 460, label: "reason" },
    ],
  },
  { box: replacement, at: [{ x: 372, label: "proven stock" }] },
  {
    box: waived,
    at: [
      { x: 58, label: "the fee" },
      { x: 176, label: "years paying" },
    ],
  },
];
---

<svg
  class="space"
  viewBox="0 0 520 340"
  data-stage={stage}
  id={id}
  role="img"
  aria-label="The outcomes a case can land in, each with what it exists only with drawn as ticks on its edge; the limit inside the refund; hatched void where no outcome exists; and the cases of the month landing"
>
  <defs>
    <pattern
      id="void-hatch"
      width="7"
      height="7"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(-45)"
    >
      <line x1="0" y1="0" x2="0" y2="7" class="hatch-line"></line>
    </pattern>
  </defs>

  <!-- the stream along the top: stations as construction, the line in See
       and Scale -->
  <g class="stream-line">
    {
      stations.map((s) => (
        <>
          <text class="station" x={s.x} y={streamY - 10} text-anchor="middle">
            {s.name}
          </text>
          <line
            class="station-tick"
            x1={s.x}
            x2={s.x}
            y1={streamY - 4}
            y2={streamY + 4}
          />
        </>
      ))
    }
    <line
      class="run"
      data-s="see"
      x1={frame.x}
      x2={stations[1].x}
      y1={streamY}
      y2={streamY}></line>
    <line
      class="run waits"
      data-s="see"
      x1={stations[1].x}
      x2={frame.x + frame.w}
      y1={streamY}
      y2={streamY}></line>
    <circle class="wait" data-s="see" cx={stations[1].x} cy={streamY} r="5"
    ></circle>
    <line
      class="run"
      data-s="scale cases limit"
      x1={frame.x}
      x2={frame.x + frame.w}
      y1={streamY}
      y2={streamY}></line>
    <line
      class="run waits"
      data-s="declare refactor prototype"
      x1={frame.x}
      x2={frame.x + frame.w}
      y1={streamY}
      y2={streamY}></line>
  </g>

  <!-- the ground: void, everywhere an outcome is not -->
  <rect
    class="void"
    data-s="see declare refactor prototype scale cases limit"
    x={frame.x}
    y={frame.y}
    width={frame.w}
    height={frame.h}></rect>

  <!-- the outcomes: dashed on paper while they are only what the desk said,
       solid once they have their edges -->
  <g class="boxes">
    {
      [
        { box: refund, name: "Refund", key: "refund" },
        { box: replacement, name: "Replacement", key: "replacement" },
        { box: waived, name: "Fee waived", key: "waived" },
      ].map(({ box, name, key }) => (
        <>
          <rect
            class="box said"
            data-s="declare"
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            stroke-dasharray="3 5"
          />
          <rect
            class="box"
            data-s="refactor prototype scale cases limit"
            data-region={key}
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
          />
          <text
            class="name"
            data-s="declare refactor prototype scale cases limit"
            x={box.x + 12}
            y={box.y + 21}
          >
            {name}
          </text>
        </>
      ))
    }
    <!-- credit exists only after a manager adds it -->
    <rect
      class="box"
      data-s="scale cases limit"
      data-region="credit"
      x={credit.x}
      y={credit.y}
      width={credit.w}
      height={credit.h}></rect>
    <text
      class="name"
      data-s="scale cases limit"
      x={credit.x + 12}
      y={credit.y + 21}>Credit</text
    >
  </g>

  <!-- the desk's words, before they are edges -->
  <g class="words" data-s="declare">
    <text class="said-text" x={refund.x + 12} y={refund.y + 44}
      >“Order’s paid, customer’s waiting,</text
    >
    <text class="said-text" x={refund.x + 12} y={refund.y + 59}
      >it’s under what I’d sign.”</text
    >
    <text class="said-text" x={replacement.x + 12} y={replacement.y + 38}
      >“Invoice isn’t due.</text
    >
    <text class="said-text" x={replacement.x + 12} y={replacement.y + 52}
      >She still gets it.”</text
    >
    <text class="said-text" x={waived.x + 12} y={waived.y + 38}
      >“Three years with us.</text
    >
    <text class="said-text" x={waived.x + 12} y={waived.y + 52}
      >I’m not charging her forty dollars.”</text
    >
  </g>

  <!-- the cases: each arrives from its station on the stream and lands -->
  <g class="cases">
    {
      cases.map((c) => (
        <g
          class:list={["case", "moves", c.cls]}
          data-s={c.s}
          data-case={c.no}
          data-region={c.region || undefined}
          style={`--lx: ${c.x}; --ly: ${c.y}; --from-dx: ${c.from - c.x}px; --from-dy: ${streamY - c.y}px`}
        >
          <circle cx={c.x} cy={c.y} r="12" pathLength="100" />
          <text x={c.x} y={c.y}>
            {c.no}
          </text>
        </g>
      ))
    }
  </g>

  <!-- the edges: what each outcome exists only with, as ticks -->
  <g class="edges">
    {
      ticks.map(({ box, at }) =>
        at.map((t) => (
          <g
            data-s={
              box === credit
                ? "scale cases limit"
                : "refactor prototype scale cases limit"
            }
          >
            <line
              class="tick"
              x1={t.x}
              x2={t.x}
              y1={box.y - 5}
              y2={box.y + 5}
            />
            <text
              class="tick-label"
              x={t.x === limitX ? t.x + 4 : t.x}
              y={box.y - 9}
              text-anchor={t.x === limitX ? "start" : "middle"}
              data-limit-label={t.x === limitX ? "true" : undefined}
            >
              {t.label}
            </text>
          </g>
        )),
      )
    }
    <!-- the limit: the refund's third tick, extended; beyond it, void -->
    <g class="limit-group" data-s="refactor prototype scale cases limit">
      <rect
        class="void inner"
        data-void="over"
        x={limitX}
        y={refund.y + 1}
        width={refund.x + refund.w - limitX - 1}
        height={refund.h - 2}></rect>
      <line
        class="limit"
        x1={limitX}
        x2={limitX}
        y1={refund.y}
        y2={refund.y + refund.h}></line>
    </g>
  </g>
</svg>

<style>
  .space {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .space :global(rect),
  .space :global(line) {
    vector-effect: non-scaling-stroke;
  }
  .space text {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  .hatch-line {
    stroke: rgba(26, 26, 26, 0.2);
    stroke-width: 1;
  }
  .centre {
    stroke: rgba(26, 26, 26, 0.26);
    stroke-width: 1;
    stroke-dasharray: 14 4 2 4;
  }
  /* the stream */
  .station {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    fill: var(--ink-quiet);
  }
  .station-tick {
    stroke: rgba(26, 26, 26, 0.3);
    stroke-width: 1;
  }
  .run {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .run.waits {
    stroke: rgba(26, 26, 26, 0.3);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .wait {
    fill: var(--signal);
  }
  /* void and outcomes */
  .void {
    fill: url(#void-hatch);
    stroke: none;
  }
  .box {
    fill: var(--paper);
    stroke: rgba(26, 26, 26, 0.72);
    stroke-width: 1;
  }
  .box.said {
    fill: none;
  }
  .name {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    fill: var(--ink);
  }
  .said-text {
    font-size: 10px;
    font-family: var(--font-body);
    font-style: italic;
    letter-spacing: 0;
    fill: var(--ink);
  }
  .tick {
    stroke: var(--ink);
    stroke-width: 1;
  }
  .tick-label {
    font-size: 9.5px;
    fill: var(--ink-quiet);
  }
  .limit {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  /* cases: a balloon's stroke draws in as it lands */
  .case circle {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.35s var(--ease) 0.1s;
  }
  .case text {
    font-size: 10px;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: central;
  }
  /* a case on hatching is red, filled: only once it has landed there. a
     void case travels in ink like any other, and the red comes after the
     travel, so no red balloon ever crosses a box */
  .case.onvoid[data-landed="true"] circle,
  [data-stage="prototype"] .case.credit circle,
  .case[data-lost="true"] circle {
    fill: var(--signal);
    stroke: var(--signal);
    transition:
      stroke-dashoffset 0.35s var(--ease) 0.1s,
      fill 0.3s var(--ease) 0.75s,
      stroke 0.3s var(--ease) 0.75s;
  }
  .case.onvoid[data-landed="true"] text,
  [data-stage="prototype"] .case.credit text,
  .case[data-lost="true"] text {
    fill: var(--paper);
    transition: fill 0.3s var(--ease) 0.75s;
  }
  /* the stranded case is already on void when the limit passes it */
  .case[data-lost="true"] circle,
  .case[data-lost="true"] text {
    transition-delay: 0s;
  }
  [data-stage="prototype"] .case.credit circle {
    transition:
      stroke-dashoffset 0.35s var(--ease) 1.4s,
      fill 0.3s var(--ease) 2.05s,
      stroke 0.3s var(--ease) 2.05s;
  }
  [data-stage="prototype"] .case.credit text {
    transition: fill 0.3s var(--ease) 2.05s;
  }
  /* arrival: a case comes down from its station on the stream and lands.
     the stages set --from-dx/--from-dy so the case starts on the stream and
     travels to its place; the sheet's control sets them by hand */
  .case {
    transform-box: view-box;
    transform: translate(var(--dx, 0px), var(--dy, 0px));
    transition:
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.15s var(--ease);
  }
  .case circle {
    stroke-dashoffset: 0;
  }
  /* in the month's run the credit case lands on void, clear of where the
     box will be; in Scale it moves into the box that now exists */
  [data-stage="prototype"] .case.credit {
    --dy: -70px;
  }
  /* a case the moved limit left on void */
  /* a case the moved limit left on void travels clear into it */
  .case[data-lost="true"] {
    --dx: var(--lost-dx, 0px);
    transition: transform 0.4s var(--ease);
  }

  /* ---- states ---- */
  [data-s]:not(.case) {
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }
  .case[data-s] {
    opacity: 0;
  }
  [data-stage="see"] [data-s~="see"],
  [data-stage="declare"] [data-s~="declare"],
  [data-stage="refactor"] [data-s~="refactor"],
  [data-stage="prototype"] [data-s~="prototype"],
  [data-stage="scale"] [data-s~="scale"],
  [data-stage="cases"] [data-s~="cases"],
  [data-stage="limit"] [data-s~="limit"] {
    opacity: 1;
  }
  [data-stage="prototype"] [data-s~="prototype"] circle,
  [data-stage="scale"] [data-s~="scale"] circle,
  [data-stage="limit"] [data-s~="limit"] circle {
    stroke-dashoffset: 0;
  }
  /* the cases wait on the stream until their stage, then land in turn */
  [data-stage="see"] .case,
  [data-stage="declare"] .case,
  [data-stage="refactor"] .case {
    --dx: var(--from-dx);
    --dy: var(--from-dy);
    transition: none;
  }
  [data-stage="prototype"] .case[data-case="01"] {
    transition-delay: 0s;
  }
  [data-stage="prototype"] .case[data-case="02"] {
    transition-delay: 0.35s;
  }
  [data-stage="prototype"] .case[data-case="03"] {
    transition-delay: 0.7s;
  }
  [data-stage="prototype"] .case[data-case="04"] {
    transition-delay: 1.3s;
  }
  /* Scale: the box first, then the case moves in, then loses its red */
  [data-stage="scale"] .box[data-region="credit"],
  [data-stage="scale"] .edges g[data-s~="scale"]:not([data-s~="refactor"]) {
    transition-delay: 0s;
  }
  [data-stage="scale"] .case.credit {
    transition:
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.5s,
      opacity 0.15s var(--ease);
  }
  [data-stage="scale"] .case.credit circle,
  [data-stage="scale"] .case.credit text {
    transition:
      fill 0.3s var(--ease) 1.15s,
      stroke 0.3s var(--ease) 1.15s;
  }
  [data-stage="scale"] .stream-line .run[data-s~="scale"] {
    transition-delay: 1.2s;
  }
  /* on the sheet that lands a case, the cases wait for the reader */
  [data-stage="cases"] .case {
    opacity: 0;
  }
  [data-stage="cases"] .case[data-shown="true"] {
    opacity: 1;
  }
  [data-stage="cases"] .case[data-shown="true"] circle {
    stroke-dashoffset: 0;
  }
  [data-stage="cases"] .box[data-lit="true"] {
    stroke: var(--ink);
    stroke-width: 2;
  }

  @media (max-width: 600px) {
    .name {
      font-size: 18px;
    }
    .station,
    .tick-label {
      font-size: 16px;
      paint-order: stroke;
      stroke: var(--paper);
      stroke-width: 4px;
      stroke-linejoin: round;
    }
    .said-text {
      font-size: 10.5px;
    }
    .case text {
      font-size: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-s],
    .case,
    .case circle,
    .case text {
      transition: none !important;
    }
  }
</style>
