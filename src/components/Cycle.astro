---
// How we do it: one stream of work followed through the cycle. Each stage's
// plate is the artifact the stage produces, drawn in the same grammar as the
// positions' proofs and reusing their instances. Only Scale carries a pencil
// scene: the working floor, which no table can show. In a toned table a pale
// row is done by hand and a dark row runs on its own; the legend sits under
// the tables it explains.
//
// A stage is the premise the reader can check against their own company, the
// plate, one or two sentences, notes only for what the plate cannot show, and
// the way on. The last step is the door.
//
// One DOM serves every reader. Without script the stages read in order as
// small multiples. With script the loop is the control at every width: beside
// the stage on wide screens, pinned above it on a phone, where a swipe also
// turns the stage.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Proof from "./Proof.astro";
import scale from "../assets/cycle/scale.jpg";

interface Props {
  // the door: where the last step leads
  door: string;
}
const { door } = Astro.props;

// ---- the stages ------------------------------------------------------------
type Plate = CollectionEntry<"positions">["data"]["proof"];
type Stage = {
  id: string;
  name: string;
  premise: string;
  // only what the plate cannot show
  notes: string[];
  // the artifact the stage produces, or (Scale) the one pencil scene
  plate?: Plate;
  legend?: boolean;
  alt?: string;
};
const stages: Stage[] = [
  {
    id: "see",
    name: "See",
    premise: "Every handoff is a judgment call nobody wrote down.",
    plate: [
      {
        kind: "stream",
        from: "Claim filed",
        to: "Claim settled",
        across: ["Sales", "Underwriting", "Finance", "Service"],
        marks: [
          { at: 1, label: "decided on the spot" },
          { at: 2, label: "decided on the spot" },
        ],
      },
    ],
    notes: [
      "Start with the stream where customers wait longest. A wait is a case sitting on someone’s judgment.",
    ],
  },
  {
    id: "declare",
    name: "Declare",
    premise:
      "The people doing the work are the only ones who know the judgment. They show it once it’s safe to.",
    plate: [
      {
        kind: "table",
        columns: ["Decision", "As written", "As practiced"],
        columnNotes: [null, null, "Declared the true version first"],
        rows: [
          [
            "Refund",
            "~~Over $500, finance approves~~",
            "If the order’s paid and the customer’s waiting, refund it and tell finance after",
          ],
          [
            "Active customer",
            "~~Signed in the last year~~",
            "Whatever billing shows",
          ],
          [
            "Exception to policy",
            "~~A named person, reason recorded~~",
            "Whoever’s next desk; nothing recorded",
          ],
        ],
        tones: ["hand", "hand", "hand"],
      },
    ],
    legend: true,
    notes: ["It’s done when the people whose judgment it is say it’s right."],
  },
  {
    id: "refactor",
    name: "Refactor",
    premise: "Automating one step of a tangled stream only tangles it faster.",
    plate: [
      {
        kind: "table",
        columns: ["Judgment", "Held by", "Within", "Beyond"],
        rows: [
          [
            "Refund",
            "The agent",
            "A paid order, a reason recorded, the desk’s limit",
            "A person’s approval",
          ],
          ["Active customer", "Software", "The fact decides", "—"],
          ["Exception to policy", "A named person", "Every case", "—"],
        ],
        tones: ["auto", "auto", "hand"],
      },
    ],
    legend: true,
    notes: [
      "Everyone who holds one of these judgments today sees the table before anything is built.",
    ],
  },
  {
    id: "prototype",
    name: "Prototype",
    premise: "Every redesign looks right on the wall.",
    plate: [
      {
        kind: "table",
        columns: ["Case", "The agent", "Result"],
        rows: [
          ["Paid, waiting, under the limit", "Refunds, tells finance", "Held"],
          ["Paid, waiting, over the limit", "Asks a person", "Held"],
          ["Unpaid, waiting", "Refund(…) cannot be built", "Held"],
          [
            "Paid, not waiting",
            "Refunds",
            "Wrong. The judgment said when waiting; the type didn’t. Now it does.",
          ],
        ],
      },
    ],
    notes: [
      "The table is what gets built. A document written about it is a second version, and the two drift.",
    ],
  },
  {
    id: "scale",
    name: "Scale",
    premise:
      "A pilot can succeed for a year without a single customer noticing.",
    alt: "The working floor of a healthy company: people settling things on the spot, deciding standing up, teaching one another; technology small and far back.",
    notes: [
      "Retire the old stream. While both run, people hand-sort cases between them.",
      "Measure two things: time from filed to settled, and the share of cases no person touched.",
      "Managers keep the limits. They set them and move them.",
    ],
  },
];

const f = (n: number) => n.toFixed(1);

// ---- the loop control ----------------------------------------------------
// five balloons on a circle, clockwise from the top; prototype carries its
// own small loop, because it turns until it holds
const R = 92;
const C = 120;
const loop = stages.map((s, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return {
    ...s,
    x: C + R * Math.cos(a),
    y: C + R * Math.sin(a),
    // label sits outside the circle
    lx: C + (R + 30) * Math.cos(a),
    ly: C + (R + 30) * Math.sin(a),
    anchor: Math.cos(a) > 0.2 ? "start" : Math.cos(a) < -0.2 ? "end" : "middle",
  };
});
const innerR = 14;
const innerC = {
  x: C + (R - 34) * Math.cos((-90 + 3 * 72) * (Math.PI / 180)),
  y: C + (R - 34) * Math.sin((-90 + 3 * 72) * (Math.PI / 180)),
};
// the arrowhead that closes the loop, just before SEE; the small loop's
// head is the same mark at the same place on its own circle, smaller
const closeA = (-90 - 14) * (Math.PI / 180);
const close = { x: C + R * Math.cos(closeA), y: C + R * Math.sin(closeA) };
const innerClose = {
  x: innerC.x + innerR * Math.cos(closeA),
  y: innerC.y + innerR * Math.sin(closeA),
};
---

<div class="cycle" data-cycle>
  <div class="loop-band">
    <div class="loop">
      <svg class="loop-art" viewBox="0 0 240 240" aria-hidden="true">
        <circle class="loop-path" cx={C} cy={C} r={R}></circle>
        <path
          class="loop-head"
          d={`M ${f(close.x)} ${f(close.y)} l 7 -4 l -1 8 z`}
          transform={`rotate(-14 ${f(close.x)} ${f(close.y)})`}></path>
        <circle class="loop-inner" cx={f(innerC.x)} cy={f(innerC.y)} r={innerR}
        ></circle>
        <path
          class="loop-inner-head"
          d={`M ${f(innerClose.x)} ${f(innerClose.y)} l 5 -3 l -1 6 z`}
          transform={`rotate(-14 ${f(innerClose.x)} ${f(innerClose.y)})`}
        ></path>
      </svg>
      <div class="balloons" role="group" aria-label="Stages of the cycle">
        {
          loop.map((s, i) => (
            <button
              type="button"
              class="balloon"
              data-stage={s.id}
              aria-pressed={i === 0 ? "true" : "false"}
              style={`--x: ${f((s.x / 240) * 100)}%; --y: ${f((s.y / 240) * 100)}%; --lx: ${f((s.lx / 240) * 100)}%; --ly: ${f((s.ly / 240) * 100)}%`}
            >
              <span class="dot" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class:list={["name", `anchor-${s.anchor}`]}>{s.name}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="states" data-states>
    {
      stages.map((s, i) => (
        <figure
          class:list={["state", `state-${s.id}`]}
          data-state={s.id}
          data-active={i === 0 ? "true" : "false"}
        >
          <div class="enunciation">
            <span class="mono-label">
              {String(i + 1).padStart(2, "0")} · {s.name}
            </span>
            <span class="premise">{s.premise}</span>
          </div>
          {s.plate ? (
            <div class="exhibit">
              <Proof proof={s.plate} />
              {s.legend && (
                <p class="legend mono-label">
                  <span class="swatch pale" aria-hidden="true" /> by hand
                  <span class="swatch dark" aria-hidden="true" /> runs on its
                  own
                </p>
              )}
            </div>
          ) : (
            <div class="exhibit scene" role="img" aria-label={s.alt}>
              <Picture
                src={scale}
                alt=""
                widths={[720, 1440]}
                sizes="(max-width: 899px) 100vw, 60rem"
                formats={["avif", "webp"]}
                loading="lazy"
              />
            </div>
          )}
          <figcaption class="commentary">
            {s.notes.length > 0 && (
              <ol class="notes">
                {s.notes.map((n) => (
                  <li>
                    <span>{n}</span>
                  </li>
                ))}
              </ol>
            )}
            {i + 1 < stages.length ? (
              <button
                type="button"
                class="next go"
                data-next={stages[i + 1].id}
              >
                Next: {stages[i + 1].name}
                <svg
                  viewBox="0 0 12 12"
                  width="0.62em"
                  height="0.62em"
                  aria-hidden="true"
                >
                  <path
                    d="M2 6h8M6.5 2.5 10 6l-3.5 3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            ) : (
              <a class="next go" href={door}>
                Start with one stream
                <svg
                  viewBox="0 0 12 12"
                  width="0.62em"
                  height="0.62em"
                  aria-hidden="true"
                >
                  <path
                    d="M2 6h8M6.5 2.5 10 6l-3.5 3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script is:inline>
  // the loop is the control. a stage is chosen from the loop (click, tap, or
  // arrow keys), by its own next question, or on a phone by a swipe; it
  // changes in place and enters from the side it was reached from. hover
  // previews a stage only where there is a pointer to hover with.
  (() => {
    const root = document.querySelector("[data-cycle]");
    if (!root) return;
    const hover = matchMedia("(hover: hover)");
    const narrow = matchMedia("(max-width: 899px)");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const buttons = [...root.querySelectorAll("[data-stage]")];
    const states = [...root.querySelectorAll("[data-state]")];
    const order = buttons.map((b) => b.dataset.stage);
    let selected = order[0];
    const visited = new Set();
    const show = (id) =>
      states.forEach(
        (s) => (s.dataset.active = String(s.dataset.state === id)),
      );
    const enter = (id, dir) => {
      if (!dir || still.matches) return;
      root.querySelector(`[data-state="${id}"]`)?.animate(
        [
          { opacity: 0, transform: `translateX(${dir * 24}px)` },
          { opacity: 1, transform: "none" },
        ],
        { duration: 380, easing: "cubic-bezier(0.2, 0.6, 0.2, 1)" },
      );
    };
    // the next stage is drawn in full ink: the way on. after Scale, See.
    const select = (id) => {
      const dir = Math.sign(order.indexOf(id) - order.indexOf(selected));
      selected = id;
      visited.add(id);
      const next = order[(order.indexOf(id) + 1) % order.length];
      buttons.forEach((b) => {
        const stage = b.dataset.stage;
        b.setAttribute("aria-pressed", String(stage === id));
        b.dataset.visited = String(visited.has(stage) && stage !== id);
        b.dataset.next = String(stage === next);
      });
      show(id);
      enter(id, dir);
    };
    // on a phone the loop is pinned above the stage; a new stage is brought
    // back up under it, so it is read from its top
    const settle = () => {
      if (!narrow.matches) return;
      const bar = document.querySelector(".bar")?.offsetHeight ?? 0;
      const top = root.getBoundingClientRect().top - bar;
      if (top < 0)
        scrollBy({ top, behavior: still.matches ? "auto" : "smooth" });
    };
    const step = (delta) => {
      const id = order[order.indexOf(selected) + delta];
      if (!id) return false;
      select(id);
      settle();
      return true;
    };
    root.querySelectorAll("[data-next]").forEach((n) =>
      n.addEventListener("click", () => {
        select(n.dataset.next);
        settle();
        root
          .querySelector(`[data-stage="${n.dataset.next}"]`)
          ?.focus({ preventScroll: true });
      }),
    );
    buttons.forEach((b) => {
      b.addEventListener("click", () => select(b.dataset.stage));
      b.addEventListener("mouseenter", () => {
        if (hover.matches) show(b.dataset.stage);
      });
      b.addEventListener("mouseleave", () => {
        if (hover.matches) show(selected);
      });
      b.addEventListener("focus", () => {
        if (b.dataset.stage !== selected) select(b.dataset.stage);
      });
      b.addEventListener("keydown", (e) => {
        const delta = {
          ArrowRight: 1,
          ArrowDown: 1,
          ArrowLeft: -1,
          ArrowUp: -1,
        }[e.key];
        if (!delta) return;
        e.preventDefault();
        if (step(delta))
          root
            .querySelector(`[data-stage="${selected}"]`)
            ?.focus({ preventScroll: true });
      });
    });
    // a sideways swipe across the stage turns it; a vertical one scrolls
    const field = root.querySelector("[data-states]");
    let from = null;
    field.addEventListener(
      "touchstart",
      (e) => (from = { x: e.touches[0].clientX, y: e.touches[0].clientY }),
      { passive: true },
    );
    field.addEventListener(
      "touchend",
      (e) => {
        if (!from) return;
        const dx = e.changedTouches[0].clientX - from.x;
        const dy = e.changedTouches[0].clientY - from.y;
        from = null;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5)
          step(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );
    root.classList.add("interactive");
    select(selected);
  })();
</script>

<style>
  /* ---- the stage: enunciation across the top, then the plate and its
     commentary hanging from one edge, as a plate and its notes do in a
     folio. as small multiples (no script) every stage reads in order ---- */
  .states {
    display: grid;
    gap: 3rem;
  }
  .state {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 1.1rem;
  }
  .enunciation {
    display: grid;
    gap: 0.45rem;
  }
  /* the premise: what the reader checks against their own organization */
  .premise {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.22;
    color: var(--ink);
    max-width: 34ch;
    text-wrap: balance;
  }
  .commentary {
    display: grid;
    gap: 0;
    align-content: start;
    max-width: 34rem;
    font-size: clamp(1rem, 1.2vw, 1.08rem);
    line-height: 1.45;
    color: var(--ink-light);
    text-wrap: pretty;
  }
  /* the rules, numbered as a sheet's general notes: the rule dark and
     short, its reason after it in the lighter face */
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    counter-reset: note;
  }
  .notes li {
    counter-increment: note;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: 0.25rem;
    align-items: baseline;
    line-height: 1.42;
  }
  /* plain numerals: the two-digit form belongs to the sheets and their keys */
  .notes li::before {
    content: counter(note);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--ink-quiet);
    /* the numeral is a label, not reading: it sits off the baseline a hair */
    transform: translateY(-0.1em);
  }
  .notes li > span {
    grid-column: 2;
  }
  /* the way on: the question the reader's own reasoning asks next */
  .next {
    justify-self: start;
    margin-top: 0.9rem;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* as small multiples every stage is visible at once and the loop drawing
     already returns to See, so no question is a control */
  .state button.next {
    display: none;
  }
  .interactive .state button.next {
    display: inline-flex;
  }
  .state a.next {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ink);
    text-decoration: none;
  }

  /* ---- the legend: the one rule every drawn map follows, stated once ---- */
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.6rem 0 0;
  }
  .swatch {
    display: inline-block;
    width: 0.8em;
    height: 0.62em;
    border: 1px solid var(--line);
  }
  .swatch.dark {
    margin-left: 1em;
    background: var(--ink);
    border-color: var(--ink);
  }

  /* ---- the exhibits: the plates, drawn in the proofs' grammar, set a
     little smaller than on a position sheet; the one scene dissolves into
     the sheet at its edges ---- */
  .exhibit :global(table) {
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .exhibit :global(td),
  .exhibit :global(th) {
    padding-right: 0.75rem;
  }
  .exhibit :global(.code) {
    font-size: 0.78rem;
    padding: 0.85rem 1rem;
  }
  .scene :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
  }

  /* ---- interactive: the loop is the control; one state shows at a time ---- */
  .loop-band {
    display: none;
  }
  .interactive .loop-band {
    display: block;
  }
  .interactive .loop {
    position: relative;
    aspect-ratio: 1;
  }
  .loop-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-path {
    fill: none;
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .loop-head,
  .loop-inner-head {
    fill: var(--ink);
  }
  .loop-inner {
    fill: none;
    stroke: rgba(26, 26, 26, 0.6);
    stroke-width: 1;
  }
  .balloon {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink-quiet);
    font: inherit;
  }
  .dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(26, 26, 26, 0.6);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .balloon .name {
    position: absolute;
    top: 50%;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    transition: color 0.3s var(--ease);
  }
  .balloon .anchor-start {
    left: calc(100% + 0.6rem);
  }
  .balloon .anchor-end {
    right: calc(100% + 0.6rem);
  }
  .balloon .anchor-middle {
    left: 50%;
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
  }
  .balloon:hover .dot {
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(26, 26, 26, 0.06);
  }
  .balloon[data-visited="true"] .dot {
    border-color: var(--ink);
  }
  /* the next stage is drawn in full ink: the way on */
  .balloon[data-next="true"] .dot {
    border-color: var(--ink);
    border-width: 1.5px;
  }
  .balloon[data-next="true"] .name {
    color: var(--ink);
  }
  .balloon[aria-pressed="true"] .dot {
    background: var(--ink);
    color: var(--paper);
  }
  .balloon[aria-pressed="true"] .name,
  .balloon:hover .name {
    color: var(--ink);
  }
  .balloon:focus-visible {
    outline: none;
  }
  .balloon:focus-visible .dot {
    outline: 1.5px solid var(--ink);
    outline-offset: 3px;
  }

  .interactive .states {
    display: grid;
    gap: 0;
  }
  .interactive .state {
    grid-area: 1 / 1;
    transition: opacity 0.35s var(--ease);
  }
  .interactive .state[data-active="false"] {
    opacity: 0;
    visibility: hidden;
  }

  /* wide: the loop beside the stage, the legend under the loop. the
     enunciation runs across the stage; under it the plate and its
     commentary hang from one edge, so the whole step reads on one screen */
  @media (min-width: 900px) {
    .cycle.interactive {
      display: grid;
      grid-template-columns: 236px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
    .interactive .loop-band {
      grid-column: 1;
      grid-row: 1;
    }
    .interactive .states {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .interactive .loop {
      width: 236px;
    }
    .interactive .state {
      grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "head notes"
        "plate notes";
      column-gap: clamp(1.5rem, 3vw, 2.75rem);
      row-gap: 1.1rem;
    }
    .interactive .enunciation {
      grid-area: head;
    }
    .interactive .premise {
      max-width: 22ch;
    }
    .interactive .exhibit {
      grid-area: plate;
      align-self: start;
    }
    .interactive .commentary {
      grid-area: notes;
      max-width: none;
      /* the notes start level with the enunciation's cap line */
      margin-top: 0.15rem;
    }
    /* See has nothing the plate cannot show: the stream takes the width and
       the way on sits under it */
    .interactive .state-see {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "head"
        "plate"
        "notes";
    }
    .interactive .state-see .exhibit {
      max-width: 42rem;
    }
    .interactive .state-see .commentary {
      margin-top: 0.5rem;
    }
