---
// How we do it: one stream of work followed through the cycle. Each stage's
// plate is the artifact the stage produces, drawn in the same grammar as the
// positions' proofs and reusing their instances. Only Scale carries a pencil
// scene: the working floor, which no table can show. In a toned table a pale
// row is done by hand and a dark row runs on its own; the legend sits under
// the tables it explains.
//
// A stage is the premise the reader can check against their own company, the
// plate, one or two sentences, notes only for what the plate cannot show, and
// the way on. The last step is the door.
//
// Every stage is on the page. The loop is an index: beside the stages on wide
// screens, following them as they scroll; above them on a phone.
import type { CollectionEntry } from "astro:content";
import Proof from "./Proof.astro";

interface Props {
  // the door: where the last step leads
  door: string;
}
const { door } = Astro.props;

// ---- the stages ------------------------------------------------------------
type Plate = CollectionEntry<"positions">["data"]["proof"];
type Stage = {
  id: string;
  name: string;
  premise: string;
  // only what the plate cannot show
  notes: string[];
  // the artifact the stage produces, or (Scale) the one pencil scene
  plate?: Plate;
};
const stages: Stage[] = [
  {
    id: "see",
    name: "See",
    premise: "Where a case waits, it’s waiting for someone to decide.",
    plate: [
      {
        kind: "stream",
        from: "Order placed",
        to: "Refund settled",
        across: ["Service", "Finance", "Billing"],
        marks: [{ at: 1, label: "" }],
      },
    ],
    notes: ["Start with the stream where customers wait longest."],
  },
  {
    id: "declare",
    name: "Declare",
    premise: "The people doing the work are the authority on the judgment.",
    plate: [
      {
        kind: "table",
        columns: ["Judgment", "As written", "As practiced"],
        stack: true,
        rows: [
          [
            "Refund",
            "~~Over $500, finance approves~~",
            "“Order’s paid, customer’s waiting, it’s under what I’d sign. Refund it. Tell finance after.”",
          ],
          [
            "Fee waived",
            "~~A manager signs off~~",
            "“Three years with us. I’m not charging her forty dollars over this.”",
          ],
          [
            "Replacement",
            "~~Unpaid: decline~~",
            "“Invoice isn’t paid yet? She still gets the replacement.”",
          ],
        ],
      },
    ],
    notes: [
      "It’s done when the desk reads it and says: yes, that’s what I do.",
    ],
  },
  {
    id: "refactor",
    name: "Refactor",
    premise: "Give each outcome what it needs to exist.",
    plate: [
      {
        kind: "table",
        columns: ["Outcome", "Exists only with"],
        rows: [
          ["Refund", "A paid order, a reason"],
          ["Fee waived", "The fee, a reason"],
          ["Replacement", "Proven stock, the order it replaces"],
        ],
      },
    ],
    notes: [],
  },
  {
    id: "prototype",
    name: "Prototype",
    premise: "Run last month’s cases through it.",
    plate: [
      {
        kind: "table",
        columns: ["Case", "The agent", "The desk, last month"],
        rows: [
          ["Paid, waiting", "Refunds, tells finance", "Refunded, told finance"],
          [
            "Asks for the fee back too",
            "Refunds, waives the fee",
            "Refunded, waived the fee",
          ],
          [
            "Invoice unpaid, arrived broken",
            "Can’t refund what wasn’t paid; sends the replacement",
            "Sent the replacement",
          ],
          [
            "Asks for credit instead of cash",
            "~~Refunds in full~~ Credits her",
            "Credited her",
          ],
        ],
      },
    ],
    notes: [
      "Where the two differ, a manager adds the outcome and the case runs again.",
    ],
  },
  {
    id: "scale",
    name: "Scale",
    premise: "Every case runs through it, and no one is in it.",
    plate: [
      {
        kind: "table",
        columns: ["Case", "The agent"],
        rows: [
          ["Paid, waiting", "Refunds, tells finance"],
          ["Asks for the fee back too", "Refunds, waives the fee"],
          [
            "Invoice unpaid, arrived broken",
            "Can’t refund what wasn’t paid; sends the replacement",
          ],
          ["Asks for credit instead of cash", "Credits her"],
        ],
      },
      {
        kind: "stream",
        from: "Order placed",
        to: "Refund settled",
        across: ["Service", "Finance", "Billing"],
        done: "",
      },
    ],
    notes: [
      "Pilot a slice and the rest of the cases still wait at Finance. Retire the old stream the day the new one carries every case.",
      "Measure one thing: time from placed to settled.",
    ],
  },
];

const f = (n: number) => n.toFixed(1);

// ---- the loop control ----------------------------------------------------
// five balloons on a circle, clockwise from the top; prototype carries its
// own small loop, because it turns until it holds
const R = 92;
const C = 120;
const loop = stages.map((s, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return {
    ...s,
    x: C + R * Math.cos(a),
    y: C + R * Math.sin(a),
    // label sits outside the circle
    lx: C + (R + 30) * Math.cos(a),
    ly: C + (R + 30) * Math.sin(a),
    anchor: Math.cos(a) > 0.2 ? "start" : Math.cos(a) < -0.2 ? "end" : "middle",
  };
});
const innerR = 14;
const innerC = {
  x: C + (R - 34) * Math.cos((-90 + 3 * 72) * (Math.PI / 180)),
  y: C + (R - 34) * Math.sin((-90 + 3 * 72) * (Math.PI / 180)),
};
// the arrowhead that closes the loop, just before SEE; the small loop's
// head is the same mark at the same place on its own circle, smaller
const closeA = (-90 - 14) * (Math.PI / 180);
const close = { x: C + R * Math.cos(closeA), y: C + R * Math.sin(closeA) };
const innerClose = {
  x: innerC.x + innerR * Math.cos(closeA),
  y: innerC.y + innerR * Math.sin(closeA),
};
---

<div class="cycle" data-cycle>
  <div class="loop-band">
    <div class="loop">
      <svg class="loop-art" viewBox="0 0 240 240" aria-hidden="true">
        <circle class="loop-path" cx={C} cy={C} r={R}></circle>
        <path
          class="loop-head"
          d={`M ${f(close.x)} ${f(close.y)} l 7 -4 l -1 8 z`}
          transform={`rotate(-14 ${f(close.x)} ${f(close.y)})`}></path>
        <circle class="loop-inner" cx={f(innerC.x)} cy={f(innerC.y)} r={innerR}
        ></circle>
        <path
          class="loop-inner-head"
          d={`M ${f(innerClose.x)} ${f(innerClose.y)} l 5 -3 l -1 6 z`}
          transform={`rotate(-14 ${f(innerClose.x)} ${f(innerClose.y)})`}
        ></path>
      </svg>
      <div class="balloons" role="group" aria-label="Stages of the cycle">
        {
          loop.map((s, i) => (
            <button
              type="button"
              class="balloon"
              data-stage={s.id}
              aria-pressed={i === 0 ? "true" : "false"}
              style={`--x: ${f((s.x / 240) * 100)}%; --y: ${f((s.y / 240) * 100)}%; --lx: ${f((s.lx / 240) * 100)}%; --ly: ${f((s.ly / 240) * 100)}%`}
            >
              <span class="dot" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class:list={["name", `anchor-${s.anchor}`]}>{s.name}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="states" data-states>
    {
      stages.map((s, i) => (
        <figure
          class:list={["state", `state-${s.id}`]}
          data-state={s.id}
          data-active={i === 0 ? "true" : "false"}
        >
          <div class="enunciation">
            <span class="mono-label">
              {String(i + 1).padStart(2, "0")} · {s.name}
            </span>
            <span class="premise">{s.premise}</span>
          </div>
          <div class="exhibit">
            <Proof proof={s.plate ?? []} />
          </div>
          <figcaption class="commentary">
            {s.notes.length > 0 && (
              <ol class="notes">
                {s.notes.map((n) => (
                  <li>
                    <span>{n}</span>
                  </li>
                ))}
              </ol>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <a class="door go" href={door}>
    Email us about one stream
    <svg viewBox="0 0 12 12" width="0.62em" height="0.62em" aria-hidden="true">
      <path
        d="M2 6h8M6.5 2.5 10 6l-3.5 3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>
</div>

<script is:inline>
  // the loop is an index. every stage is on the page; a balloon scrolls to
  // its stage, and the balloon of the stage in view is drawn in full ink.
  (() => {
    const root = document.querySelector("[data-cycle]");
    if (!root) return;
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const buttons = [...root.querySelectorAll("[data-stage]")];
    const states = [...root.querySelectorAll("[data-state]")];
    const bar = () => document.querySelector(".bar")?.offsetHeight ?? 0;
    const mark = (id) =>
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.stage === id)),
      );
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const s = root.querySelector(`[data-state="${b.dataset.stage}"]`);
        if (!s) return;
        const top = s.getBoundingClientRect().top + scrollY - bar() - 16;
        scrollTo({ top, behavior: still.matches ? "auto" : "smooth" });
        mark(b.dataset.stage);
      }),
    );
    if ("IntersectionObserver" in window) {
      const seen = new Map();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => seen.set(e.target, e.intersectionRatio));
          const best = [...seen.entries()].sort((a, b) => b[1] - a[1])[0];
          if (best && best[1] > 0) mark(best[0].dataset.state);
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      states.forEach((s) => io.observe(s));
    }
    root.classList.add("interactive");
  })();
</script>

<style>
  /* ---- the stage: enunciation across the top, then the plate and its
     commentary hanging from one edge, as a plate and its notes do in a
     folio. as small multiples (no script) every stage reads in order ---- */
  .states {
    display: grid;
    gap: 3rem;
  }
  .state {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 1.1rem;
  }
  .enunciation {
    display: grid;
    gap: 0.45rem;
  }
  /* the premise: what the reader checks against their own organization */
  .premise {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.22;
    color: var(--ink);
    max-width: 34ch;
    text-wrap: balance;
  }
  .commentary {
    display: grid;
    gap: 0;
    align-content: start;
    max-width: 34rem;
    font-size: clamp(1rem, 1.2vw, 1.08rem);
    line-height: 1.45;
    color: var(--ink-light);
    text-wrap: pretty;
  }
  /* the rules, numbered as a sheet's general notes: the rule dark and
     short, its reason after it in the lighter face */
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    counter-reset: note;
  }
  .notes li {
    counter-increment: note;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: 0.25rem;
    align-items: baseline;
    line-height: 1.42;
  }
  /* plain numerals: the two-digit form belongs to the sheets and their keys */
  .notes li::before {
    content: counter(note);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--ink-quiet);
    /* the numeral is a label, not reading: it sits off the baseline a hair */
    transform: translateY(-0.1em);
  }
  .notes li > span {
    grid-column: 2;
  }
  /* the way on: the question the reader's own reasoning asks next */
  .next {
    justify-self: start;
    margin-top: 0.9rem;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* as small multiples every stage is visible at once and the loop drawing
     already returns to See, so no question is a control */
  .state button.next {
    display: none;
  }
  .interactive .state button.next {
    display: inline-flex;
  }
  .state a.next {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ink);
    text-decoration: none;
  }

  /* ---- the legend: the one rule every drawn map follows, stated once ---- */
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.6rem 0 0;
  }
  .swatch {
    display: inline-block;
    width: 0.8em;
    height: 0.62em;
    border: 1px solid var(--line);
  }
  .swatch.dark {
    margin-left: 1em;
    background: var(--ink);
    border-color: var(--ink);
  }

  /* ---- the exhibits: the plates, drawn in the proofs' grammar, set a
     little smaller than on a position sheet; the one scene dissolves into
     the sheet at its edges ---- */
  .exhibit :global(table) {
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .exhibit :global(td),
  .exhibit :global(th) {
    padding-right: 0.75rem;
  }
  .exhibit :global(.code) {
    font-size: 0.78rem;
    padding: 0.85rem 1rem;
  }
  .scene :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
  }

  /* ---- interactive: the loop is the control; one state shows at a time ---- */
  .loop-band {
    display: none;
  }
  .interactive .loop-band {
    display: block;
  }
  .interactive .loop {
    position: relative;
    aspect-ratio: 1;
  }
  .loop-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-path {
    fill: none;
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .loop-head,
  .loop-inner-head {
    fill: var(--ink);
  }
  .loop-inner {
    fill: none;
    stroke: rgba(26, 26, 26, 0.6);
    stroke-width: 1;
  }
  .balloon {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink-quiet);
    font: inherit;
  }
  .dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(26, 26, 26, 0.6);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .balloon .name {
    position: absolute;
    top: 50%;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    transition: color 0.3s var(--ease);
  }
  .balloon .anchor-start {
    left: calc(100% + 0.6rem);
  }
  .balloon .anchor-end {
    right: calc(100% + 0.6rem);
  }
  .balloon .anchor-middle {
    left: 50%;
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
  }
  .balloon:hover .dot {
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(26, 26, 26, 0.06);
  }
  .balloon[data-visited="true"] .dot {
    border-color: var(--ink);
  }
  /* the next stage is drawn in full ink: the way on */
  .balloon[data-next="true"] .dot {
    border-color: var(--ink);
    border-width: 1.5px;
  }
  .balloon[data-next="true"] .name {
    color: var(--ink);
  }
  .balloon[aria-pressed="true"] .dot {
    background: var(--ink);
    color: var(--paper);
  }
  .balloon[aria-pressed="true"] .name,
  .balloon:hover .name {
    color: var(--ink);
  }
  .balloon:focus-visible {
    outline: none;
  }
  .balloon:focus-visible .dot {
    outline: 1.5px solid var(--ink);
    outline-offset: 3px;
  }

  .interactive .states {
    display: grid;
    gap: 3.5rem;
  }
  /* the way out, after the last stage */
  .door {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* wide: the loop beside the stage, the legend under the loop. the
     enunciation runs across the stage; under it the plate and its
     commentary hang from one edge, so the whole step reads on one screen */
  @media (min-width: 900px) {
    .cycle.interactive {
      display: grid;
      grid-template-columns: 236px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
    .interactive .loop-band {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--bar) + 1.5rem);
    }
    .interactive .states {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .interactive .door {
      grid-column: 2;
      grid-row: 3;
    }
    .interactive .loop {
      width: 236px;
    }
    .interactive .state {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "head"
        "plate"
        "notes";
      row-gap: 1.1rem;
    }
    .interactive .enunciation {
      grid-area: head;
    }
    .interactive .premise {
      max-width: 30ch;
    }
    .interactive .exhibit {
      grid-area: plate;
      align-self: start;
    }
    .interactive .commentary {
      grid-area: notes;
      max-width: none;
      /* the notes start level with the enunciation's cap line */
      margin-top: 0.15rem;
    }
    .interactive .exhibit {
      max-width: 54rem;
    }
    .interactive .commentary {
      margin-top: 0.5rem;
    }
    /* scale, the one scene with no map in it, is the working floor: cropped
       to the people in it */
    .interactive .state-scale .exhibit :global(img) {
      aspect-ratio: 1.45;
      object-fit: cover;
      object-position: 42% 55%;
    }
  }

  /* phone: the loop is pinned above the stage as one strip. the premise,
     the scene and the start of the commentary sit on the first screen, and
     the rest reads on under the loop. each scene is held to one height so
     the stages do not jump */
  @media (max-width: 899px) {
    .interactive {
      --scene: min(24svh, 15rem);
    }
    .interactive .loop-band {
      padding: 0.5rem 0 1rem;
    }
    .interactive .loop {
      width: min(156px, 20svh);
      margin: 0 auto;
    }
    .interactive .dot {
      width: 30px;
      height: 30px;
      font-size: 0.62rem;
    }
    /* a fingertip's reach around each balloon */
    .interactive .balloon::before {
      content: "";
      position: absolute;
      inset: -7px;
      border-radius: 50%;
    }
    .interactive .balloon .name {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }
    .interactive .balloon .anchor-start {
      left: calc(100% + 0.45rem);
    }
    .interactive .balloon .anchor-end {
      right: calc(100% + 0.45rem);
    }
    .interactive .balloon .anchor-middle {
      bottom: calc(100% + 0.35rem);
    }
    /* a sideways swipe belongs to the stage, never to the browser's back
       gesture; vertical scrolling and pinch zoom stay the browser's */
    .interactive .states {
      margin-top: 0.25rem;
      touch-action: pan-y pinch-zoom;
      overscroll-behavior-x: contain;
    }
    /* the states share one cell, so a shorter stage is stretched to the
       tallest; its rows must not take the slack as gaps */
    .interactive .state {
      row-gap: 0.9rem;
      align-content: start;
    }
    /* a grid item with auto margins shrinks to its content, so the scene is
       given its width and centred */
    .interactive .exhibit {
      width: 100%;
      justify-self: center;
    }
    /* scale opens out to the frame */
    .interactive .state-scale .exhibit {
      margin-inline: calc(var(--gutter) * -0.5 - 0.5rem + 1px);
    }
    .interactive .state-scale .exhibit :global(img) {
      aspect-ratio: 1.9;
      object-fit: cover;
      object-position: 50% 55%;
    }
    .interactive .premise {
      font-size: 1.25rem;
    }
    .interactive .commentary {
      font-size: 1.02rem;
    }
    /* the plates are set tighter so the premise and the plate share the
       first screen with the pinned loop */
    .exhibit :global(table) {
      font-size: 0.9rem;
      line-height: 1.25;
    }
    .exhibit :global(td) {
      padding-top: 0.4rem;
      padding-bottom: 0.4rem;
    }
    .exhibit :global(.code) {
      font-size: 0.72rem;
      padding: 0.7rem 0.8rem;
    }
    /* the way on, tall enough to tap */
    .interactive .next {
      padding-top: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive .state,
    .dot,
    .balloon .name {
      transition: none;
    }
  }
</style>
