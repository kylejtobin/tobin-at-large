---
// The method, one stream of work at a time: five stages on one drawing. The
// loop is the control; a stage is chosen from it (click, tap, arrow keys),
// and the drawing beside it moves to that stage's state in place. See is
// the stream with its wait; the other four are the outcome space, drawn
// from the desk's words, filled with the month's cases, finished.
//
// Without script every stage's words read in order under one still drawing.
import OutcomeSpace from "./OutcomeSpace.astro";

interface Props {
  // the door: where the last stage leads
  door: string;
}
const { door } = Astro.props;

type Stage = {
  id: "see" | "declare" | "refactor" | "prototype" | "scale";
  name: string;
  premise: string;
  // only what the drawing cannot show
  notes: string[];
};
const stages: Stage[] = [
  {
    id: "see",
    name: "See",
    premise: "Where a case waits, it’s waiting for someone to decide.",
    notes: [
      "At Halden Supply a return waits at Finance for a signature on any refund over five hundred dollars. Start with the stream where customers wait longest.",
    ],
  },
  {
    id: "declare",
    name: "Declare",
    premise: "The people doing the work are the authority on the judgment.",
    notes: [
      "Dana runs the returns desk. The policy binder says finance approves, a manager signs off, unpaid means decline. What she says is on the drawing, in her words, and it is the true version.",
      "It’s done when Dana reads it and says: yes, that’s what I do.",
    ],
  },
  {
    id: "refactor",
    name: "Refactor",
    premise: "Give each outcome what it needs to exist.",
    notes: [
      "Each of Dana’s sentences becomes an edge: a refund exists only with a paid order, a reason, and an amount under the limit. The hatched ground is what has no outcome to be. Nothing there can be chosen.",
    ],
  },
  {
    id: "prototype",
    name: "Prototype",
    premise: "Run last month’s cases through it.",
    notes: [
      "Four of Dana’s cases from last month, placed where the agent lands them. Three land where she did. The fourth, a contractor who wanted credit on account instead of cash, lands on void: there was no credit to give.",
    ],
  },
  {
    id: "scale",
    name: "Scale",
    premise: "The whole stream runs, and no one is in it.",
    notes: [
      "A manager adds the outcome, and the case runs again. Every case lands inside. Retire the old stream the day the new one carries every case. Measure one thing: time from return requested to case settled.",
    ],
  },
];
const f = (n: number) => n.toFixed(1);

// ---- the loop control ----------------------------------------------------
const R = 92;
const C = 120;
const loop = stages.map((s, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return {
    ...s,
    x: C + R * Math.cos(a),
    y: C + R * Math.sin(a),
    lx: C + (R + 26) * Math.cos(a),
    ly: C + (R + 26) * Math.sin(a),
    anchor: Math.cos(a) > 0.2 ? "start" : Math.cos(a) < -0.2 ? "end" : "middle",
  };
});
const innerR = 14;
const innerC = {
  x: C + (R - 34) * Math.cos((-90 + 3 * 72) * (Math.PI / 180)),
  y: C + (R - 34) * Math.sin((-90 + 3 * 72) * (Math.PI / 180)),
};
const closeA = (-90 - 14) * (Math.PI / 180);
const close = { x: C + R * Math.cos(closeA), y: C + R * Math.sin(closeA) };
const innerClose = {
  x: innerC.x + innerR * Math.cos(closeA),
  y: innerC.y + innerR * Math.sin(closeA),
};
---

<div class="cycle" data-cycle>
  <div class="loop-band">
    <div class="loop">
      <svg class="loop-art" viewBox="0 0 240 240" aria-hidden="true">
        <circle class="loop-path" cx={C} cy={C} r={R}></circle>
        <path
          class="loop-head"
          d={`M ${f(close.x)} ${f(close.y)} l 7 -4 l -1 8 z`}
          transform={`rotate(-14 ${f(close.x)} ${f(close.y)})`}></path>
        <circle class="loop-inner" cx={f(innerC.x)} cy={f(innerC.y)} r={innerR}
        ></circle>
        <path
          class="loop-inner-head"
          d={`M ${f(innerClose.x)} ${f(innerClose.y)} l 5 -3 l -1 6 z`}
          transform={`rotate(-14 ${f(innerClose.x)} ${f(innerClose.y)})`}
        ></path>
      </svg>
      <div class="balloons" role="group" aria-label="Stages of the method">
        {
          loop.map((s, i) => (
            <button
              type="button"
              class="balloon"
              data-stage={s.id}
              aria-pressed={i === 0 ? "true" : "false"}
              style={`--x: ${f((s.x / 240) * 100)}%; --y: ${f((s.y / 240) * 100)}%; --lx: ${f((s.lx / 240) * 100)}%; --ly: ${f((s.ly / 240) * 100)}%`}
            >
              <span class="dot" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class:list={["name", `anchor-${s.anchor}`]}>{s.name}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="stage" data-stagebox>
    <div class="plate">
      <OutcomeSpace stage="see" id="method-space" />
    </div>
    <div class="words">
      {
        stages.map((s, i) => (
          <div
            class="state"
            data-state={s.id}
            data-active={i === 0 ? "true" : "false"}
          >
            <span class="mono-label">
              {String(i + 1).padStart(2, "0")} · {s.name}
            </span>
            <p class="premise">{s.premise}</p>
            <ol class="notes">
              {s.notes.map((n) => (
                <li>
                  <span>{n}</span>
                </li>
              ))}
            </ol>
            {i + 1 < stages.length ? (
              <button
                type="button"
                class="next go"
                data-next={stages[i + 1].id}
              >
                Next: {stages[i + 1].name}
              </button>
            ) : (
              <a class="next go" href={door}>
                Email us about one stream
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</div>

<script is:inline>
  // the loop is the control: a stage is chosen from it, by the next button,
  // or by arrow keys; the drawing and the words move to that stage in place.
  (() => {
    const root = document.querySelector("[data-cycle]");
    if (!root) return;
    const buttons = [...root.querySelectorAll("[data-stage]")];
    const states = [...root.querySelectorAll("[data-state]")];
    const space = root.querySelector("#method-space");
    const narrow = matchMedia("(max-width: 899px)");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const order = buttons.map((b) => b.dataset.stage);
    let selected = order[0];
    const select = (id) => {
      selected = id;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.stage === id)),
      );
      states.forEach(
        (s) => (s.dataset.active = String(s.dataset.state === id)),
      );
      space.dataset.stage = id;
      root.dataset.current = id;
    };
    // on a phone the drawing is brought back under the bar after a step, so
    // the change is seen
    const settle = () => {
      if (!narrow.matches) return;
      const bar = document.querySelector(".bar")?.offsetHeight ?? 0;
      const top = root.getBoundingClientRect().top + scrollY - bar - 32;
      scrollTo({ top, behavior: still.matches ? "auto" : "smooth" });
    };
    // on a phone the page scrolls first, then the drawing changes in view
    const go = (id) => {
      if (narrow.matches && !still.matches) {
        settle();
        setTimeout(() => select(id), 420);
      } else {
        select(id);
        settle();
      }
    };
    buttons.forEach((b) => {
      b.addEventListener("click", () => go(b.dataset.stage));
      b.addEventListener("keydown", (e) => {
        const delta = {
          ArrowRight: 1,
          ArrowDown: 1,
          ArrowLeft: -1,
          ArrowUp: -1,
        }[e.key];
        if (!delta) return;
        e.preventDefault();
        const next = order[order.indexOf(selected) + delta];
        if (next) {
          select(next);
          root
            .querySelector(`[data-stage="${next}"]`)
            ?.focus({ preventScroll: true });
        }
      });
    });
    root
      .querySelectorAll("[data-next]")
      .forEach((n) => n.addEventListener("click", () => go(n.dataset.next)));
    root.classList.add("interactive");
    select(selected);
  })();
</script>

<style>
  /* ---- without script: the drawing still, every stage's words in order ---- */
  .stage {
    display: grid;
    gap: 2rem;
  }
  .words {
    display: grid;
    gap: 2rem;
  }
  .state {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .premise {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.22;
    color: var(--ink);
    max-width: 24ch;
    text-wrap: balance;
    margin: 0;
  }
  .notes {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    counter-reset: note;
    font-size: clamp(1rem, 1.2vw, 1.08rem);
    line-height: 1.45;
    color: var(--ink-light);
    text-wrap: pretty;
  }
  .notes li {
    counter-increment: note;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: 0.25rem;
    align-items: baseline;
  }
  .notes li::before {
    content: counter(note);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--ink-quiet);
    transform: translateY(-0.1em);
  }
  .notes li > span {
    grid-column: 2;
  }
  .next {
    justify-self: start;
    margin-top: 0.9rem;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .state button.next {
    display: none;
  }
  .interactive .state button.next {
    display: inline-flex;
  }

  /* ---- interactive: one stage at a time, the drawing moving in place ---- */
  .interactive .words {
    display: grid;
  }
  .interactive .state {
    grid-area: 1 / 1;
    transition: opacity 0.35s var(--ease);
  }
  .interactive .state[data-active="false"] {
    opacity: 0;
    visibility: hidden;
  }

  .loop-band {
    display: none;
  }
  .interactive .loop-band {
    display: block;
  }
  .interactive .loop {
    position: relative;
    aspect-ratio: 1;
  }
  .loop-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-path {
    fill: none;
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .loop-head,
  .loop-inner-head {
    fill: var(--ink);
  }
  .loop-inner {
    fill: none;
    stroke: rgba(26, 26, 26, 0.6);
    stroke-width: 1;
  }
  .balloon {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink-quiet);
    font: inherit;
  }
  .dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(26, 26, 26, 0.6);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .balloon .name {
    position: absolute;
    top: 50%;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    transition: color 0.3s var(--ease);
  }
  .balloon .anchor-start {
    left: calc(100% + 0.6rem);
  }
  .balloon .anchor-end {
    right: calc(100% + 0.6rem);
  }
  .balloon .anchor-middle {
    left: 50%;
    top: auto;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
  }
  .balloon:hover .dot {
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(26, 26, 26, 0.06);
  }
  .balloon[data-visited="true"] .dot {
    border-color: var(--ink);
  }
  /* the next stage is drawn in full ink: the way on */
  .balloon[data-next="true"] .dot {
    border-color: var(--ink);
    border-width: 1.5px;
  }
  .balloon[data-next="true"] .name {
    color: var(--ink);
  }
  .balloon[aria-pressed="true"] .dot {
    background: var(--ink);
    color: var(--paper);
  }
  .balloon[aria-pressed="true"] .name,
  .balloon:hover .name {
    color: var(--ink);
  }
  .balloon:focus-visible {
    outline: none;
  }
  .balloon:focus-visible .dot {
    outline: 1.5px solid var(--ink);
    outline-offset: 3px;
  }

  .interactive .states {
    display: grid;
    gap: 3.5rem;
  }
  /* the way out, after the last stage */
  .door {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* wide: the loop beside, the drawing over the words */
  @media (min-width: 900px) {
    .cycle.interactive {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
    .interactive .loop-band {
      position: sticky;
      top: calc(var(--bar) + 1.5rem);
    }
    .interactive .loop {
      width: 200px;
    }
    .interactive .stage {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.25rem;
    }
    .interactive .plate {
      max-width: 56rem;
    }
    .interactive .words {
      max-width: 40rem;
    }
  }

  /* phone: the loop pinned above, the drawing under it, the words after */
  @media (max-width: 899px) {
    .interactive .loop-band {
      padding: 0.5rem 0 1rem;
    }
    .interactive .loop-band {
      padding: 0.5rem 0 1rem;
    }
    .interactive .loop {
      width: min(156px, 20svh);
      margin: 0 auto;
    }
    .interactive .dot {
      width: 30px;
      height: 30px;
      font-size: 0.62rem;
    }
    .interactive .balloon::before {
      content: "";
      position: absolute;
      inset: -7px;
      border-radius: 50%;
    }
    .interactive .balloon .name {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }
    .interactive .balloon .anchor-start {
      left: calc(100% + 0.45rem);
    }
    .interactive .balloon .anchor-end {
      right: calc(100% + 0.45rem);
    }
    .interactive .balloon .anchor-middle {
      bottom: calc(100% + 0.35rem);
    }

    .interactive .stage {
      margin-top: 0.5rem;
    }
    .premise {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive .state,
    .dot,
    .balloon .name {
      transition: none;
    }
  }
</style>
