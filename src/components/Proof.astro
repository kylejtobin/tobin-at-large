---
// A position's proof, drawn on the sheet: shown, never claimed, and never
// captioned. A sequence of blocks: tables, code, and struck lines, the way
// that is replaced, struck through in red.
import type { CollectionEntry } from "astro:content";
import OutcomeSpace from "./OutcomeSpace.astro";

interface Props {
  proof: CollectionEntry<"positions">["data"]["proof"];
}

const { proof } = Astro.props;

// Code is assembled as one escaped string: template whitespace inside <pre>
// would otherwise render as stray indentation. A comment line is set apart
// from the code in the quiet ink.
const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// The model's config lines are set in the quiet ink too: real, kept, and
// not what the reader is here to see; the docstring and the fields stay dark.
const codeHtml = (code: string) => {
  let config = false;
  return code
    .trimEnd()
    .split("\n")
    .map((line) => {
      const t = line.trimStart();
      if (t.startsWith("model_config")) config = true;
      const quiet = t.startsWith("#") || config;
      if (config && t === ")") config = false;
      return quiet
        ? `<span class="comment">${escape(line)}</span>`
        : escape(line);
    })
    .join("\n");
};
// inside a cell, ~~the replaced way~~ is struck beside what replaces it
const cellHtml = (cell: string) =>
  escape(cell).replace(/~~([^~]+)~~/g, "<s>$1</s>");
// the stream: its two ends fixed, the departments it crosses as faint rules
const streamGeometry = (across: readonly string[]) => {
  const x0 = 60;
  const x1 = 460;
  return across.map((name, i) => ({
    name,
    x: x0 + ((i + 1) * (x1 - x0)) / (across.length + 1),
  }));
};
---

<figure class="proof">
  {
    proof.map((block) =>
      block.kind === "table" ? (
        <div class="plate">
          <table class:list={{ stack: block.stack }}>
            <thead>
              <tr>
                {block.columns.map((column, c) => (
                  <th
                    class:list={[
                      "mono-label",
                      { unreachable: block.unreachable === c },
                    ]}
                    scope="col"
                  >
                    {column}
                    {block.columnNotes?.[c] && (
                      <span class="note">{block.columnNotes[c]}</span>
                    )}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {block.rows.map((row, r) => (
                <tr class={block.tones?.[r]}>
                  {row.map((cell, c) => (
                    <td
                      class:list={{ unreachable: block.unreachable === c }}
                      set:html={cellHtml(cell)}
                    />
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          {block.legend && (
            <p class="legend mono-label">
              <span class="swatch pale" aria-hidden="true" /> by hand
              <span class="swatch dark" aria-hidden="true" /> runs on its own
            </p>
          )}
        </div>
      ) : block.kind === "stream" ? (
        <svg
          class="stream"
          viewBox="0 0 520 170"
          role="img"
          aria-label={`${block.from} to ${block.to}, across ${block.across.join(", ")}, with nothing fixed between`}
        >
          {streamGeometry(block.across).map(({ name, x }) => (
            <>
              <text class="dept" x={x} y="26" text-anchor="middle">
                {name}
              </text>
              <line
                class="dept-rule"
                x1={x}
                x2={x}
                y1="44"
                y2={block.done ? "100" : "134"}
              />
            </>
          ))}
          {block.marks?.length ? (
            <line
              class="done-line"
              x1="60"
              x2={streamGeometry(block.across)[block.marks[0].at].x}
              y1="90"
              y2="90"
              stroke="currentColor"
              stroke-width="2"
            />
          ) : block.done !== undefined ? (
            <line
              class="done-line"
              x1="60"
              x2="460"
              y1="90"
              y2="90"
              stroke="currentColor"
              stroke-width="2"
            />
          ) : (
            <line class="between" x1="60" x2="460" y1="90" y2="90" />
          )}
          {block.done && (
            <text class="done-label" x="260" y="114" text-anchor="middle">
              {block.done}
            </text>
          )}
          {block.marks?.map((m) => (
            <circle
              class="wait"
              cx={streamGeometry(block.across)[m.at].x}
              cy="90"
              r="5"
            />
          ))}
          <circle class="end" cx="60" cy="90" r="4.5" />
          <circle class="end" cx="460" cy="90" r="4.5" />
          <text class="end-label" x="60" y="156">
            {block.from}
          </text>
          <text class="end-label" x="460" y="156" text-anchor="end">
            {block.to}
          </text>
        </svg>
      ) : block.kind === "space" ? (
        <div class="space-plate" data-space={block.mode}>
          <OutcomeSpace stage={block.mode} />
          {block.mode === "cases" ? (
            <div class="control" role="group" aria-label="Land a case">
              <span class="mono-label">Land a case</span>
              <button type="button" data-land="01" data-region="refund">
                Paid, waiting, under the limit
              </button>
              <button type="button" data-land="04" data-region="credit">
                Paid, waiting, over the limit, wants credit
              </button>
              <button type="button" data-land="03" data-region="replacement">
                Invoice not due yet, arrived broken
              </button>
              <button type="button" data-land="02" data-region="waived">
                Three years with us, asks for the fee back
              </button>
              <button type="button" data-land="05" data-region="">
                Invoice unpaid, wants a refund
              </button>
            </div>
          ) : (
            <div class="control">
              <label class="mono-label" for="limit-range">
                Move the limit
              </label>
              <input
                id="limit-range"
                type="range"
                min="160"
                max="240"
                value="214"
                step="2"
              />
            </div>
          )}
        </div>
      ) : block.kind === "speech" ? (
        <div class="speech">
          {block.label && <span class="mono-label">{block.label}</span>}
          {block.lines.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      ) : block.kind === "struck" ? (
        <ul class:list={["struck", `as-${block.as}`]}>
          {block.lines.map((line) => (
            <li>
              <s>{line}</s>
            </li>
          ))}
        </ul>
      ) : (
        <pre class="code" set:html={`<code>${codeHtml(block.code)}</code>`} />
      ),
    )
  }
</figure>

<style>
  .proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.16rem;
    line-height: 1.35;
  }
  th {
    text-align: left;
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: 0.6rem 1rem 0.6rem 0;
    vertical-align: top;
    border-bottom: 1px solid var(--line-faint);
    color: var(--ink-light);
  }
  /* the column an agent cannot read: hatched, as a drawing marks a void */
  td.unreachable,
  th.unreachable {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      rgba(26, 26, 26, 0.07) 6px 7px
    );
    padding-left: 0.75rem;
  }
  td.unreachable {
    color: var(--ink-quiet);
  }
  th .note {
    display: block;
    margin-top: 0.2rem;
    color: var(--signal-text);
    letter-spacing: 0.08em;
  }
  /* the replaced way inside a cell, struck beside what replaces it */
  td :global(s) {
    text-decoration: line-through;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1.5px;
    color: var(--ink-quiet);
    margin-right: 0.35em;
  }
  /* a row's tone is the legend's swatch at its head: pale by hand, dark
     runs on its own */
  tr.hand td:first-child::before,
  tr.auto td:first-child::before {
    content: "";
    display: inline-block;
    width: 0.7em;
    height: 0.55em;
    margin-right: 0.55em;
    border: 1px solid var(--line);
    vertical-align: 0.02em;
  }
  tr.auto td:first-child::before {
    background: var(--ink);
    border-color: var(--ink);
  }
  tr.auto td {
    color: var(--ink);
  }

  /* the stream: two ends fixed, the departments it crosses, nothing between */
  .stream {
    display: block;
    width: 100%;
    max-width: 36rem;
    height: auto;
    overflow: visible;
  }
  .stream text {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .stream .dept {
    font-size: 12px;
    fill: var(--ink-quiet);
  }
  .stream .dept-rule {
    stroke: rgba(26, 26, 26, 0.18);
    stroke-width: 1;
  }
  .stream .between {
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  /* the stream finished: solid ink, end to end */
  .stream .done-line {
    color: var(--ink);
  }
  .stream .done-label {
    font-size: 12px;
    fill: var(--ink);
  }
  .stream .end {
    fill: var(--ink);
  }
  /* a case sitting at a handoff: the plates' red, for the proof's mark */
  .stream .wait {
    fill: var(--signal);
  }
  .stream .wait-label {
    font-size: 12px;
    fill: var(--signal-text);
  }
  .stream .end-label {
    font-size: 13px;
    fill: var(--ink);
  }

  /* the legend: the one rule every toned table follows */
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.6rem 0 0;
  }
  .swatch {
    display: inline-block;
    width: 0.8em;
    height: 0.62em;
    border: 1px solid var(--line);
  }
  .swatch.dark {
    margin-left: 1em;
    background: var(--ink);
    border-color: var(--ink);
  }

  /* the outcome space and its control: a row of cases to land, or the
     limit to move */
  .space-plate {
    display: grid;
    gap: 0.9rem;
  }
  /* on a wide screen the control stands beside the drawing */
  @media (min-width: 1200px) {
    .space-plate {
      grid-template-columns: minmax(0, 1fr) 15rem;
      column-gap: 2rem;
      align-items: start;
    }
    .space-plate .control {
      flex-direction: column;
      align-items: stretch;
      padding-top: 2.5rem;
    }
    .space-plate .control button {
      text-align: left;
    }
  }
  .control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
  }
  .control .mono-label {
    width: 100%;
  }
  .control button {
    background: none;
    border: 1px solid var(--line);
    padding: 0.4rem 0.7rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.3s var(--ease);
  }
  .control button[aria-pressed="true"],
  .control button:hover,
  .control button:focus-visible {
    border-color: var(--ink);
    outline: none;
  }
  /* the slider, drawn: a hairline track, a balloon for a thumb */
  .control input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: min(100%, 22rem);
    height: 24px;
    background: transparent;
    cursor: pointer;
  }
  .control input[type="range"]::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--line);
  }
  .control input[type="range"]::-moz-range-track {
    height: 1px;
    background: var(--line);
  }
  .control input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -8.5px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .control input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .control input[type="range"]:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  /* what someone says, kept: judgment as it is exercised */
  .speech {
    display: grid;
    gap: 0.4rem;
  }
  .speech p {
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink);
    max-width: 30rem;
    text-wrap: pretty;
  }

  /* the replaced way, struck through in red */
  .struck {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .struck s {
    text-decoration: line-through;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1.5px;
    color: var(--ink-quiet);
  }
  /* the clause that never ends runs off the paper's edge */
  .struck.as-code {
    min-width: 0;
    overflow-x: clip;
  }
  .struck.as-code s {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .struck.as-code s {
      font-size: 0.7rem;
    }
  }
  .struck.as-speech s {
    font-style: italic;
    font-size: 1.2rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--ink);
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
  }
  .code :global(.comment) {
    color: var(--ink-quiet);
  }
  /* on a phone the block is set smaller so its lines fit the sheet, and the
     stream's lettering larger, since the drawing scales down with the sheet */
  @media (max-width: 899px) {
    .code {
      font-size: 0.68rem;
      padding: 0.7rem 0.8rem;
    }
  }
  @media (max-width: 600px) {
    .stream .dept,
    .stream .done-label {
      font-size: 14px;
      letter-spacing: 0.06em;
    }
    .stream .end-label {
      font-size: 16px;
      letter-spacing: 0.06em;
    }
    /* a table whose cells strike stacks each row: the struck line above
       what replaces it already says replaced, so the heads can go */
    table.stack thead {
      display: none;
    }
    table.stack tr {
      display: grid;
      grid-template-columns: 1fr;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--line-faint);
    }
    table.stack td {
      border: 0;
      padding: 0.1rem 0;
    }
  }
</style>

<script is:inline>
  // the two controls: land a case in its region; move the limit and watch
  // the void beyond it grow and shrink
  // this script is printed once per proof; the work is done once
  if (!window.__talSpace) {
    window.__talSpace = true;
    document.querySelectorAll("[data-space='cases']").forEach((plate) => {
      const svg = plate.querySelector("svg");
      const buttons = [...plate.querySelectorAll("[data-land]")];
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          buttons.forEach((o) =>
            o.setAttribute("aria-pressed", String(o === b)),
          );
          // the case arrives from its station on the stream, then lands; the
          // month accumulates on the drawing
          const c = svg.querySelector(`.case[data-case="${b.dataset.land}"]`);
          if (c && c.dataset.shown !== "true") {
            const still = matchMedia(
              "(prefers-reduced-motion: reduce)",
            ).matches;
            c.style.transition = "none";
            c.style.setProperty("--dx", c.style.getPropertyValue("--from-dx"));
            c.style.setProperty("--dy", c.style.getPropertyValue("--from-dy"));
            c.dataset.shown = "true";
            // flush the start state, then let the transition carry it home
            void c.getBoundingClientRect();
            c.style.transition = still ? "none" : "";
            c.style.setProperty("--dx", "0px");
            c.style.setProperty("--dy", "0px");
          }
          svg
            .querySelectorAll("[data-region]")
            .forEach(
              (r) =>
                (r.dataset.lit = String(r.dataset.region === b.dataset.region)),
            );
        }),
      );
    });
    document.querySelectorAll("[data-space='limit']").forEach((plate) => {
      const svg = plate.querySelector("svg");
      const range = plate.querySelector("input[type='range']");
      const line = svg.querySelector(".limit");
      const voidRect = svg.querySelector("[data-void='over']");
      const right = 24 + 280 - 1;
      const tick = svg.querySelectorAll(".edges > g")[2];
      const stranded = svg.querySelector('.case[data-case="01"]');
      const set = (x) => {
        line.setAttribute("x1", x);
        line.setAttribute("x2", x);
        voidRect.setAttribute("x", x);
        voidRect.setAttribute("width", Math.max(0, right - x));
        if (tick) {
          tick.querySelector("line").setAttribute("x1", x);
          tick.querySelector("line").setAttribute("x2", x);
          tick.querySelector("text").setAttribute("x", x + 4);
        }
        // the month's first case sits at 170: left of the limit it is a refund,
        // right of it there is no refund to be
        // past the first case, that case is stranded: moved clear into the void
        if (stranded) {
          const lost = x < 170;
          stranded.dataset.lost = String(lost);
          stranded.style.setProperty(
            "--lost-dx",
            lost ? `${Math.max(0, x + 40 - 170)}px` : "0px",
          );
        }
        // the limit's label hangs right while there is room, left when there isn't
        const label = tick && tick.querySelector("text");
        if (label) {
          const left = x > 236;
          label.setAttribute("x", left ? x - 4 : x + 4);
          label.setAttribute("text-anchor", left ? "end" : "start");
        }
      };
      range.addEventListener("input", () => set(Number(range.value)));
      set(Number(range.value));
    });
  }
</script>
