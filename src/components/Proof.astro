---
// A position's proof, drawn on the sheet: shown, never claimed, and never
// captioned. A sequence of blocks: tables, code, and struck lines, the way
// that is replaced, struck through in red.
import type { CollectionEntry } from "astro:content";

interface Props {
  proof: CollectionEntry<"positions">["data"]["proof"];
}

const { proof } = Astro.props;

// Code is assembled as one escaped string: template whitespace inside <pre>
// would otherwise render as stray indentation. A comment line is set apart
// from the code in the quiet ink.
const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const codeHtml = (code: string) =>
  code
    .trimEnd()
    .split("\n")
    .map((line) =>
      line.trimStart().startsWith("#")
        ? `<span class="comment">${escape(line)}</span>`
        : escape(line),
    )
    .join("\n");
---

<figure class="proof">
  {
    proof.map((block) =>
      block.kind === "table" ? (
        <table>
          <thead>
            <tr>
              {block.columns.map((column, c) => (
                <th
                  class:list={[
                    "mono-label",
                    { unreachable: block.unreachable === c },
                  ]}
                  scope="col"
                >
                  {column}
                  {block.unreachable === c && (
                    <span class="note">Out of an agent’s reach</span>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {block.rows.map((row) => (
              <tr>
                {row.map((cell, c) => (
                  <td class:list={{ unreachable: block.unreachable === c }}>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      ) : block.kind === "struck" ? (
        <ul class:list={["struck", `as-${block.as}`]}>
          {block.lines.map((line) => (
            <li>
              <s>{line}</s>
            </li>
          ))}
        </ul>
      ) : (
        <pre class="code" set:html={`<code>${codeHtml(block.code)}</code>`} />
      ),
    )
  }
</figure>

<style>
  .proof {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.16rem;
    line-height: 1.35;
  }
  th {
    text-align: left;
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: 0.6rem 1rem 0.6rem 0;
    vertical-align: top;
    border-bottom: 1px solid var(--line-faint);
    color: var(--ink-light);
  }
  /* the column an agent cannot read: hatched, as a drawing marks a void */
  td.unreachable,
  th.unreachable {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      rgba(26, 26, 26, 0.07) 6px 7px
    );
    padding-left: 0.75rem;
  }
  td.unreachable {
    color: var(--ink-quiet);
  }
  th .note {
    display: block;
    margin-top: 0.2rem;
    color: var(--signal-text);
    letter-spacing: 0.08em;
  }

  /* the replaced way, struck through in red */
  .struck {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .struck s {
    text-decoration: line-through;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1.5px;
    color: var(--ink-quiet);
  }
  .struck.as-code s {
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .struck.as-speech s {
    font-style: italic;
    font-size: 1.2rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--ink);
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
  }
  .code :global(.comment) {
    color: var(--ink-quiet);
  }
</style>
