---
// A position's proof, drawn on the sheet: shown, never claimed. One or more
// blocks, tables or code, and a caption. Each proof has one live point in red:
// a table's marked cell, or a code comment.
import type { CollectionEntry } from "astro:content";

interface Props {
  proof: CollectionEntry<"positions">["data"]["proof"];
}

const { proof } = Astro.props;

// Code is assembled as one escaped string: template whitespace inside <pre>
// would otherwise render as stray indentation. A comment line is the live
// point, so it is drawn in the signal red.
const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const codeHtml = (code: string) =>
  code
    .trimEnd()
    .split("\n")
    .map((line) =>
      line.trimStart().startsWith("#")
        ? `<span class="signal">${escape(line)}</span>`
        : escape(line),
    )
    .join("\n");
---

<figure class="proof">
  {
    proof.blocks.map((block) =>
      block.kind === "table" ? (
        <table>
          <thead>
            <tr>
              {block.columns.map((column) => (
                <th class="mono-label" scope="col">
                  {column}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {block.rows.map((row, r) => (
              <tr>
                {row.map((cell, c) => (
                  <td
                    class:list={{
                      live: block.live?.[0] === r && block.live?.[1] === c,
                    }}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <pre class="code" set:html={`<code>${codeHtml(block.code)}</code>`} />
      ),
    )
  }
  <figcaption>{proof.caption}</figcaption>
</figure>

<style>
  .proof {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  figcaption {
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--ink-quiet);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.1rem;
    line-height: 1.35;
  }
  th {
    text-align: left;
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: 0.6rem 1rem 0.6rem 0;
    vertical-align: top;
    border-bottom: 1px solid var(--line-faint);
    color: var(--ink-quiet);
  }
  /* the live cell: full ink, led by the red node */
  td.live {
    position: relative;
    color: var(--ink);
    padding-left: 1rem;
  }
  td.live::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--ink);
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
  }
  .code :global(.signal) {
    color: var(--signal-text);
  }
</style>
