---
// The cover's one drawing: the construction geometry of the index it stands
// on. Concentric construction arcs projected from one origin, a centre line
// that runs on past the sheet's edge, and four callout balloons, numbered as
// TAL's positions are, with leaders dropping to the index. Red appears once:
// the origin every arc is projected from. The index is the key; the drawing
// carries no labels of its own.
//
// Geometry: origin (260, 330); construction arcs r = 110, 180, 250; the
// balloons sit on r = 180 at 158°, 113°, 67° and 22°.
const cx = 260;
const cy = 330;
const r = 180;
const at = (deg: number, radius = r) => {
  const t = (deg * Math.PI) / 180;
  return { x: cx + radius * Math.cos(t), y: cy - radius * Math.sin(t) };
};
const balloons = [
  { no: "01", ...at(158) },
  { no: "02", ...at(113) },
  { no: "03", ...at(67) },
  { no: "04", ...at(22) },
];
const arc = (radius: number) =>
  `M ${cx - radius} ${cy} A ${radius} ${radius} 0 0 1 ${cx + radius} ${cy}`;
const f = (n: number) => n.toFixed(1);
---

<svg
  class="cover-drawing"
  viewBox="0 0 520 340"
  preserveAspectRatio="xMidYMax meet"
  aria-hidden="true"
>
  <g class="construct">
    {[110, 180, 250].map((radius) => <path class="arc" d={arc(radius)} />)}
    <!-- the centre line runs on past the sheet's edge, as construction does -->
    <path class="centre" d={`M -40 ${cy} H 560`}></path>
    <path class="centre" d={`M ${cx} ${cy + 10} V 40`}></path>
    {
      [110, 180, 250].flatMap((radius) => [
        <circle class="terminal" cx={cx - radius} cy={cy} r="2.5" />,
        <circle class="terminal" cx={cx + radius} cy={cy} r="2.5" />,
      ])
    }
    {
      balloons.map(({ x, y }) => (
        <path class="leader" d={`M ${f(x)} ${f(y + 15)} V 340`} />
      ))
    }
  </g>

  <g class="construct">
    {
      balloons.map(({ no, x, y }) => (
        <g>
          <circle class="balloon" cx={f(x)} cy={f(y)} r="15" />
          <text x={f(x)} y={f(y)}>
            {no}
          </text>
        </g>
      ))
    }
  </g>
  <circle class="origin" cx={cx} cy={cy} r="5"></circle>
</svg>

<style>
  .cover-drawing {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .cover-drawing path,
  .cover-drawing circle {
    vector-effect: non-scaling-stroke;
  }

  .arc {
    fill: none;
    stroke: rgba(26, 26, 26, 0.3);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  /* the drafting convention for a centre line: long dash, short dash */
  .centre {
    fill: none;
    stroke: rgba(26, 26, 26, 0.24);
    stroke-width: 1;
    stroke-dasharray: 14 4 2 4;
  }
  .terminal {
    fill: var(--paper);
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
  }
  .leader {
    fill: none;
    stroke: rgba(26, 26, 26, 0.38);
    stroke-width: 1;
  }
  .balloon {
    fill: var(--paper);
    stroke: rgba(26, 26, 26, 0.6);
    stroke-width: 1;
  }
  text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* the origin: the one red point, what everything after it multiplies */
  .origin {
    fill: var(--signal);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.6s var(--ease) 1.6s;
  }
  .construct {
    transition: opacity 1.2s var(--ease) 0.5s;
  }

  /* drafted in after the frame: construction first, then the origin lands */
  :global(.drafting) :global(.drawing:not(.drawn)) .construct {
    opacity: 0;
  }
  :global(.drafting) :global(.drawing:not(.drawn)) .origin {
    transform: scale(0);
  }
</style>
