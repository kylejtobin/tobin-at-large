---
// The cover's one drawing: the construction geometry of the drawing list it
// sits above. Concentric construction arcs on a centre line; three callout
// balloons, numbered as the list is, with leaders dropping to it; and one
// red line, the live path through the system, from authority to meaning to
// software. The list is its key, so it carries no labels of its own.
//
// Geometry: centre (260, 330); construction arcs r = 110, 180, 250; the
// balloons sit on r = 180 at 150°, 90° and 30°. The live path runs on the
// same arc from 145° to 35°, so it meets balloon 03 at its edge, and the
// arrowhead points along the arc's tangent there.
const cx = 260;
const cy = 330;
const r = 180;
const at = (deg: number, radius = r) => {
  const t = (deg * Math.PI) / 180;
  return { x: cx + radius * Math.cos(t), y: cy - radius * Math.sin(t) };
};
const balloons = [
  { no: "01", ...at(150) },
  { no: "02", ...at(90) },
  { no: "03", ...at(30) },
];
const start = at(145);
const end = at(35);
// the tangent of a clockwise path at 35°, and the arrowhead built on it
const t = (35 * Math.PI) / 180;
const dir = { x: Math.sin(t), y: Math.cos(t) };
const back = { x: end.x - 9 * dir.x, y: end.y - 9 * dir.y };
const wing = { x: -dir.y * 3.5, y: dir.x * 3.5 };
const arrow = [
  [end.x, end.y],
  [back.x + wing.x, back.y + wing.y],
  [back.x - wing.x, back.y - wing.y],
]
  .map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`)
  .join(" ");
const arc = (radius: number) =>
  `M ${cx - radius} ${cy} A ${radius} ${radius} 0 0 1 ${cx + radius} ${cy}`;
const f = (n: number) => n.toFixed(1);
---

<svg
  class="cover-drawing"
  viewBox="0 0 520 340"
  preserveAspectRatio="xMidYMax meet"
  aria-hidden="true"
>
  <g class="construct">
    {[110, 180, 250].map((radius) => <path class="arc" d={arc(radius)} />)}
    <!-- the centre line runs on past the sheet's edge, as construction does -->
    <path class="centre" d={`M -40 ${cy} H 560`}></path>
    <path class="centre" d={`M ${cx} ${cy + 10} V 40`}></path>
    {
      [110, 180, 250].flatMap((radius) => [
        <circle class="terminal" cx={cx - radius} cy={cy} r="2.5" />,
        <circle class="terminal" cx={cx + radius} cy={cy} r="2.5" />,
      ])
    }
    {
      balloons.map(({ x, y }) => (
        <path class="leader" d={`M ${f(x)} ${f(y + 15)} V 340`} />
      ))
    }
  </g>

  <g class="live">
    <path
      class="path"
      pathLength="1"
      d={`M ${f(start.x)} ${f(start.y)} A ${r} ${r} 0 0 1 ${f(end.x)} ${f(end.y)}`}
    ></path>
    <polygon class="head" points={arrow}></polygon>
  </g>

  <g class="construct">
    {
      balloons.map(({ no, x, y }) => (
        <g>
          <circle class="balloon" cx={f(x)} cy={f(y)} r="15" />
          <text x={f(x)} y={f(y)}>
            {no}
          </text>
        </g>
      ))
    }
  </g>
</svg>

<style>
  .cover-drawing {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .cover-drawing path,
  .cover-drawing circle {
    vector-effect: non-scaling-stroke;
  }

  .arc {
    fill: none;
    stroke: rgba(26, 26, 26, 0.3);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  /* the drafting convention for a centre line: long dash, short dash */
  .centre {
    fill: none;
    stroke: rgba(26, 26, 26, 0.24);
    stroke-width: 1;
    stroke-dasharray: 14 4 2 4;
  }
  .terminal {
    fill: var(--paper);
    stroke: rgba(26, 26, 26, 0.45);
    stroke-width: 1;
  }
  .leader {
    fill: none;
    stroke: rgba(26, 26, 26, 0.38);
    stroke-width: 1;
  }
  .balloon {
    fill: var(--paper);
    stroke: rgba(26, 26, 26, 0.6);
    stroke-width: 1;
  }
  text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* the live path, in the plates' red */
  .path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s var(--ease) 1.5s;
  }
  .head {
    fill: var(--signal);
    transition: opacity 0.4s var(--ease) 2.8s;
  }
  .construct {
    transition: opacity 1.2s var(--ease) 0.5s;
  }

  /* drafted in after the frame: construction first, then the live path runs
     from 01 to 03 and its head lands */
  :global(.drafting) :global(.drawing:not(.drawn)) .construct {
    opacity: 0;
  }
  :global(.drafting) :global(.drawing:not(.drawn)) .path {
    stroke-dashoffset: 1;
  }
  :global(.drafting) :global(.drawing:not(.drawn)) .head {
    opacity: 0;
  }
</style>
