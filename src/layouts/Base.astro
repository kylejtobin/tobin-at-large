---
// The ground every drawing is set on: head, fonts, the paper, analytics.
import Analytics from "@vercel/analytics/astro";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Absolute origin for canonical + social tags — the production domain.
const ORIGIN = "https://talco.dev";
const canonical = new URL(Astro.url.pathname, ORIGIN).href;
const ogImage = `${ORIGIN}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TAL Company" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="TAL Company" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <div class="grain"></div>
    <main>
      <slot />
    </main>

    <script is:inline>
      // each drawing's frame is drafted as it comes into view: the one motion
      // on the site. without this script, or with reduced motion, every frame
      // is simply already drawn.
      if (
        "IntersectionObserver" in window &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("drafting");
        const seen = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("drawn");
                seen.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        document.querySelectorAll(".drawing").forEach((d) => seen.observe(d));
      }
    </script>
  </body>
</html>
